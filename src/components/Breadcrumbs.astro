---
export interface BreadcrumbItem {
  label?: string;
  name?: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  light?: boolean;
}

const { items, light = false } = Astro.props;
---

<nav aria-label="Fil d'Ariane" class="py-1 text-[11px] sm:text-xs font-sans w-full">
  <ol class="flex flex-wrap items-center gap-x-1.5 sm:gap-x-2 gap-y-1 leading-normal">
    <li class="inline-flex items-center">
      <a
        href="/"
        class={`transition-colors inline-flex items-center gap-1 font-medium ${
          light ? 'text-slate-500 hover:text-brand-900' : 'text-slate-300 hover:text-white'
        }`}
      >
        <svg class="w-3.5 h-3.5 opacity-70 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
        </svg>
        <span>Accueil</span>
      </a>
    </li>

    {items && items.map((item, index) => {
      const isLast = index === items.length - 1;
      const rawText = item.label || item.name || '';
      // On mobile, simplify excessively long titles with SEO subtitle after colon
      const displayText = isLast && rawText.includes(' : ') ? rawText.split(' : ')[0] : rawText;
      return (
        <li class="inline-flex items-center gap-1.5 sm:gap-2">
          <span class={`opacity-40 select-none ${light ? 'text-slate-400' : 'text-purple-300'}`}>/</span>
          {isLast || !item.href ? (
            <span
              class={`font-semibold ${
                light ? 'text-brand-dark' : 'text-[#e2d5fb]'
              }`}
              aria-current="page"
              title={rawText}
            >
              {displayText}
            </span>
          ) : (
            <a
              href={item.href}
              class={`transition-colors ${
                light ? 'text-slate-600 hover:text-brand-900' : 'text-slate-300 hover:text-white'
              }`}
            >
              {displayText}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
