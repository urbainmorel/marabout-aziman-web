---
import type { ServiceHub } from '../data/servicesData';

interface Props {
  hub: ServiceHub;
}

const { hub } = Astro.props;
---

<div class="card-luxury p-6 flex flex-col justify-between group hover:border-gold-300 transition-all duration-300">
  <div>
    <div class="relative h-44 mb-4 rounded-xl overflow-hidden bg-brand-900/10">
      <img
        src={hub.image}
        alt={hub.title}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
      <div class="absolute bottom-3 left-4">
        <span class="text-white font-serif font-semibold text-lg drop-shadow">{hub.name}</span>
      </div>
    </div>

    <p class="text-sm text-gray-600 line-clamp-3 mb-4 leading-relaxed">
      {hub.metaDescription || hub.content.slice(0, 140)}
    </p>

    <!-- Subservices quick list -->
    {hub.subservices && hub.subservices.length > 0 && (
      <div class="space-y-1 mb-4 pt-2 border-t border-gray-100">
        <span class="text-[11px] uppercase tracking-wider text-gold-600 font-semibold">Rituels majeurs :</span>
        <ul class="text-xs text-gray-500 space-y-1">
          {hub.subservices.slice(0, 3).map((sub) => (
            <li class="flex items-center gap-1.5">
              <span class="text-gold-500">✦</span>
              <a href={`/services/${hub.silo}/${sub.slug}`} class="hover:text-brand-900 transition-colors">
                {sub.title.replace(' en France', '')}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <a
    href={`/services/${hub.silo}`}
    class="inline-flex items-center justify-between w-full pt-3 mt-auto text-xs font-semibold text-brand-900 hover:text-gold-600 border-t border-gray-100 transition-colors"
  >
    <span>Découvrir ce domaine</span>
    <span class="text-base group-hover:translate-x-1 transition-transform">→</span>
  </a>
</div>
