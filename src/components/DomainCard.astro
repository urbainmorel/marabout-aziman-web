---
import ExpandableText from './ExpandableText.astro';

interface Props {
  hub: {
    silo: string;
    title: string;
    name: string;
    image: string;
    homeDescription?: string;
    content?: string;
  };
  index?: number;
  expandable?: boolean;
}

const { hub, index, expandable = false } = Astro.props;

// Exact description mapped from PAGE D'ACCUEIL.txt
const homeDescriptions: Record<string, string> = {
  'amour-sentiments': "Ne laissez pas une rupture briser votre existence. Grâce à des rituels puissants de retour affectif urgent, de cadenas d'amour et de verrouillage de fidélité, vous retrouvez l'harmonie conjugale et l'attachement indéfectible de votre partenaire.",
  'richesse-finance': "Libérez enfin votre potentiel financier. En effet, Maître Aziman réalise des rituels d'ouverture de chance, des pactes de prospérité avec les esprits des eaux et des consécrations pour maximiser vos gains aux jeux de tirage et loteries.",
  'commerce-carriere-reussite': "Développez votre activité professionnelle en toute sérénité. Ainsi, nos rituels d'attraction de clientèle, d'obtention de promotions et de neutralisation de la concurrence déloyale vous assurent une ascension fulgurante.",
  'divination-voyance': "Levez le voile sur votre avenir grâce à la géomancie sacrée du Fâ et au tirage des cauris. Par conséquent, vous découvrez l'origine exacte de vos blocages et les opportunités qui s'offrent à vous.",
  'protection-desenvoutement': "Défendez votre personne et votre foyer contre les énergies obscures. Nous effectuons des grands désenvoûtements, des délivrances de maris ou femmes de nuit, ainsi que des rituels de retour à l'envoyeur avec effet miroir.",
  'sante-traditionnelle': "Profitez des vertus millénaires des plantes d'Afrique. De plus, nos préparations soutiennent la fertilité féminine, renforcent la vigueur masculine par l'Agbo et accompagnent le sevrage des addictions.",
  'justice-proces-litiges': "Protégez vos droits face aux tribunaux. Grâce au mythique cadenas de justice et aux rituels d'apaisement, nous travaillons pour faire taire les accusateurs et obtenir des décisions favorables.",
  'immigration-titres-sejour-visas': "Facilitez vos démarches auprès des préfectures et consulats. Nous activons des poudres de persuasion et des bains d'ouverture pour lever les blocages de titres de séjour, visas et arrêtés d'expulsion (OQTF)."
};

const desc = homeDescriptions[hub.silo] || hub.homeDescription || hub.content?.slice(0, 150) || '';
---

<div class="card-luxury p-3 sm:p-5 flex flex-col justify-between group hover:border-brand-500 transition-all duration-200 shadow-xs bg-white rounded-2xl">
  <div>
    <div class="relative aspect-[16/10] mb-3 rounded-xl overflow-hidden bg-brand-950">
      <img
        src={hub.image}
        alt={hub.title}
        loading="lazy"
        decoding="async"
        width="800"
        height="500"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-950/85 via-brand-950/20 to-transparent"></div>
      <div class="absolute bottom-2 left-2.5 right-2.5">
        <h3 class="text-white font-serif font-bold text-xs sm:text-base leading-tight drop-shadow">
          <a href={`/services/${hub.silo}/`} class="hover:text-brand-200 transition-colors">
            {index ? `${index}. ` : ''}{hub.name}
          </a>
        </h3>
      </div>
    </div>

    <!-- Description: Expandable on home, Full on pillar pages -->
    {expandable ? (
      <ExpandableText text={desc} />
    ) : (
      <p class="font-sans text-xs sm:text-sm text-slate-700 leading-relaxed">
        {desc}
      </p>
    )}
  </div>

  <a
    href={`/services/${hub.silo}/`}
    class="inline-flex items-center justify-between w-full pt-2.5 mt-3 text-[11px] sm:text-xs font-bold text-brand-900 hover:text-brand-700 border-t border-brand-100 transition-colors uppercase tracking-wider"
  >
    <span>Découvrir</span>
    <span class="text-xs sm:text-sm group-hover:translate-x-1 transition-transform">→</span>
  </a>
</div>
