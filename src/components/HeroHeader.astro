---
import Breadcrumbs from './Breadcrumbs.astro';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  badge?: string;
  title: string;
  description?: string;
  breadcrumbs: BreadcrumbItem[];
  metaInfo?: {
    date?: string;
    readTime?: string;
    category?: string;
  };
  author?: {
    name: string;
    role: string;
    avatar: string;
  };
}

const { badge, title, description, breadcrumbs, metaInfo, author } = Astro.props;
---

<section class="relative bg-gradient-to-b from-brand-950 via-brand-900 to-brand-900 text-white py-14 sm:py-16 md:py-20 border-b border-slate-800 overflow-hidden">
  
  <!-- Subtle Ambient Glow -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-indigo-900/20 rounded-full blur-3xl pointer-events-none"></div>
  
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mt-6 max-w-4xl space-y-4">
      
      {badge && (
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-800/90 border border-slate-700 text-slate-100 text-xs font-bold uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>{badge}</span>
        </div>
      )}

      {metaInfo && (
        <div class="flex flex-wrap items-center gap-3 text-xs text-slate-200 font-semibold">
          {metaInfo.category && (
            <span class="px-3 py-1 rounded-full bg-indigo-950 text-indigo-200 border border-indigo-700/60 uppercase tracking-wider font-bold">
              {metaInfo.category}
            </span>
          )}
          {metaInfo.readTime && <span>{metaInfo.readTime}</span>}
          {metaInfo.date && (
            <>
              <span class="text-slate-500">•</span>
              <span>Publié le {metaInfo.date}</span>
            </>
          )}
        </div>
      )}

      <h1 class="font-serif font-bold text-3xl sm:text-4xl md:text-5xl lg:text-5.5xl text-white leading-[1.15] tracking-tight">
        {title}
      </h1>

      {description && (
        <p class="text-base sm:text-lg text-slate-200 leading-relaxed font-sans max-w-3xl pt-1">
          {description}
        </p>
      )}

      {author && (
        <div class="pt-4 flex items-center gap-3.5 border-t border-slate-800 mt-6">
          <img
            src={author.avatar}
            alt={author.name}
            class="w-11 h-11 rounded-full object-cover border-2 border-slate-600 shadow-md"
          />
          <div>
            <p class="text-sm font-bold text-white">{author.name}</p>
            <p class="text-xs text-slate-300">{author.role}</p>
          </div>
        </div>
      )}

    </div>
  </div>
</section>
