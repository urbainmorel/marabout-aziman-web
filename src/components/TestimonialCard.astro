---
import type { Testimonial } from '../mock/data';

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<div class="bg-surface-low rounded-2xl p-5 md:p-6 border border-gray-200/70 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between h-full">
  <div>
    <!-- Rating Stars & Header -->
    <div class="flex justify-between items-center mb-3">
      <div class="flex text-amber-400 gap-0.5" aria-label={`Note de ${testimonial.rating} sur 5`}>
        {Array.from({ length: testimonial.rating }).map(() => (
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
          </svg>
        ))}
      </div>
      <span class="inline-flex items-center gap-1 text-[10px] font-sans font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200/50">
        <svg class="w-3 h-3 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
        Avis Vérifié
      </span>
    </div>

    <!-- Quote -->
    <p class="font-serif italic text-xs md:text-sm text-gray-700 leading-relaxed mb-4">
      « {testimonial.content} »
    </p>
  </div>

  <!-- Author Info -->
  <div class="pt-3 border-t border-gray-200/60 flex justify-between items-end">
    <div>
      <h4 class="font-sans font-bold text-xs md:text-sm text-brand-dark">
        {testimonial.author}
      </h4>
      <span class="text-[11px] text-gray-500 block">
        {testimonial.city}
      </span>
    </div>

    {testimonial.service && (
      <span class="text-[10px] text-gold-800 font-sans font-medium bg-gold-100/70 px-2 py-0.5 rounded">
        {testimonial.service}
      </span>
    )}
  </div>
</div>
