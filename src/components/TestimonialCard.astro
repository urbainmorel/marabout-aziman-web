---
import type { Testimonial } from '../data/siteData';

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<div class="card-luxury p-6 sm:p-7 flex flex-col justify-between h-full bg-white relative border border-gray-100 shadow-sm hover:shadow-md hover:border-gold-300/60 transition-all duration-300">
  <div>
    <!-- Rating Stars & Category Badge -->
    <div class="flex items-center justify-between mb-4">
      <div class="flex text-gold-500 gap-0.5" aria-label={`Note : ${testimonial.rating} sur 5 étoiles`}>
        {Array.from({ length: testimonial.rating }).map(() => (
          <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
        ))}
      </div>
      <span class="text-[10px] uppercase tracking-wider font-semibold text-brand-900 bg-gold-50 border border-gold-200/60 px-2.5 py-0.5 rounded-full">
        {testimonial.category}
      </span>
    </div>

    <!-- Testimonial Quote -->
    <blockquote class="text-sm sm:text-[15px] text-gray-700 italic leading-relaxed mb-6 font-serif">
      « {testimonial.text} »
    </blockquote>
  </div>

  <!-- Author Info & Verification Badge -->
  <div class="flex items-center justify-between pt-4 border-t border-gray-100 mt-auto">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-brand-900 text-gold-300 flex items-center justify-center font-serif font-bold text-xs shadow-xs border border-gold-400/30">
        {testimonial.author.charAt(0)}
      </div>
      <div>
        <h4 class="font-bold text-xs sm:text-sm text-brand-dark">{testimonial.author}</h4>
        <p class="text-[11px] text-gold-700 font-medium">{testimonial.city}</p>
      </div>
    </div>
    
    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200/60 px-2 py-0.5 rounded-full">
      <svg class="w-3 h-3 fill-current text-emerald-600" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
      </svg>
      Vérifié
    </span>
  </div>
</div>
