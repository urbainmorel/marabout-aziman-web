---

<section class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8" data-purpose="value-propositions">
  <div class="grid grid-cols-3 gap-3 md:gap-6 bg-white rounded-2xl p-4 md:p-6 border border-gray-100 shadow-ambient">
    
    <!-- Prop 1 -->
    <div class="flex flex-col md:flex-row items-center md:items-start gap-2 md:gap-4 text-center md:text-left">
      <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-brand-50 flex items-center justify-center text-brand-900 flex-shrink-0 border border-brand-100">
        <svg class="h-5 w-5 md:h-6 md:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
        </svg>
      </div>
      <div>
        <h3 class="font-sans font-bold text-xs md:text-sm text-brand-dark">Cabinet & Distance</h3>
        <p class="text-[11px] md:text-xs text-gray-500 hidden sm:block mt-0.5">Consultations privées à Paris ou à distance partout en France</p>
      </div>
    </div>

    <!-- Prop 2 -->
    <div class="flex flex-col md:flex-row items-center md:items-start gap-2 md:gap-4 text-center md:text-left border-x border-gray-100 px-2 md:px-6">
      <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-gold-50 flex items-center justify-center text-gold-700 flex-shrink-0 border border-gold-200">
        <svg class="h-5 w-5 md:h-6 md:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M13 10V3L4 14h7v7l9-11h-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
        </svg>
      </div>
      <div>
        <h3 class="font-sans font-bold text-xs md:text-sm text-brand-dark">100% Discret</h3>
        <p class="text-[11px] md:text-xs text-gray-500 hidden sm:block mt-0.5">Secret initiatique strict et respect absolu de votre vie privée</p>
      </div>
    </div>

    <!-- Prop 3 -->
    <div class="flex flex-col md:flex-row items-center md:items-start gap-2 md:gap-4 text-center md:text-left">
      <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-700 flex-shrink-0 border border-emerald-100">
        <svg class="h-5 w-5 md:h-6 md:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
        </svg>
      </div>
      <div>
        <h3 class="font-sans font-bold text-xs md:text-sm text-brand-dark">Action Rapide</h3>
        <p class="text-[11px] md:text-xs text-gray-500 hidden sm:block mt-0.5">Rituels d'urgence avec premiers effets sous 24h à 72h</p>
      </div>
    </div>

  </div>
</section>
