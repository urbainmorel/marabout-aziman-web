---
import { siteSettings } from '../data/siteData';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { name: 'Accueil', href: '/' },
  { name: 'À Propos', href: '/a-propos' },
  { name: 'Services & Rituels', href: '/services' },
  { name: 'Boutique', href: '/boutique' },
  { name: 'Cabinet France', href: '/cabinet-france' },
  { name: 'Avis Clients', href: '/temoignages-avis' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="sticky top-0 z-50 glass-header border-b border-gray-200/70 shadow-sm transition-all duration-300" id="site-header">
  <!-- Top announcement bar for emergency consultations -->
  <div class="bg-brand-dark text-white text-xs py-1.5 px-4 hidden sm:block">
    <div class="max-w-content mx-auto flex justify-between items-center">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-gold-200 font-medium">Cabinet ouvert 7j/7</span>
        <span class="text-gray-300">— Consultations privées en Île-de-France & à distance</span>
      </div>
      <div class="flex items-center gap-4 text-gray-300">
        <span class="text-xs">Secret Professionnel Garanti</span>
        <span>•</span>
        <a href={`tel:${siteSettings.phone}`} class="hover:text-gold-300 transition-colors font-medium flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {siteSettings.phoneDisplay}
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none" aria-label="Cabinet Aziman - Accueil">
        <div class="w-10 h-10 md:w-11 md:h-11 bg-brand-900 rounded-xl flex items-center justify-center text-gold-300 shadow-md group-hover:bg-brand-800 transition-colors">
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path clip-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" fill-rule="evenodd"></path>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-serif font-bold text-xl md:text-2xl text-brand-dark tracking-tight leading-none">Cabinet Aziman</span>
          <span class="text-[10px] md:text-xs text-gray-500 font-sans tracking-wide uppercase mt-0.5">Grand Marabout en France</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden xl:flex items-center space-x-1" aria-label="Navigation principale">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
                isActive
                  ? 'text-brand-900 bg-brand-50/80 font-semibold'
                  : 'text-gray-700 hover:text-brand-900 hover:bg-gray-100/70'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Action CTAs -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href={siteSettings.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp text-xs py-2 px-3.5 shadow-sm hover:shadow"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>WhatsApp 24/7</span>
        </a>

        <a
          href="/contact"
          class="btn-primary text-xs py-2 px-4 shadow-sm hover:shadow"
        >
          <span>Prendre RDV</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center gap-2 lg:hidden">
        <a
          href={siteSettings.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-emerald-600 hover:bg-emerald-50 rounded-lg transition-colors"
          aria-label="Contacter sur WhatsApp"
        >
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
        </a>

        <button
          type="button"
          id="mobile-menu-button"
          class="p-2 rounded-lg text-gray-700 hover:text-brand-900 hover:bg-gray-100 focus:outline-none"
          aria-label="Ouvrir le menu"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-200 bg-white/95 backdrop-blur-md px-4 pt-3 pb-6 space-y-3 shadow-lg">
    <nav class="space-y-1">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
              isActive
                ? 'text-brand-900 bg-brand-50 font-semibold'
                : 'text-gray-700 hover:text-brand-900 hover:bg-gray-50'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <div class="pt-4 border-t border-gray-100 space-y-2">
      <a
        href={siteSettings.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-whatsapp w-full justify-center py-3 text-sm font-semibold"
      >
        <span>Échanger en direct sur WhatsApp</span>
      </a>

      <a
        href={`tel:${siteSettings.phone}`}
        class="btn-secondary w-full justify-center py-3 text-sm font-semibold text-center"
      >
        <span>Appeler : {siteSettings.phoneDisplay}</span>
      </a>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  button?.addEventListener('click', () => {
    const isExpanded = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', (!isExpanded).toString());
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
