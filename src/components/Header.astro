---
import { siteSettings } from '../data/siteData';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const serviceCategories = [
  { name: 'Amour & Sentiments', href: '/services/amour-sentiments' },
  { name: 'Richesse & Finance', href: '/services/richesse-finance' },
  { name: 'Commerce & Carrière', href: '/services/commerce-carriere-reussite' },
  { name: 'Divination & Voyance Fâ', href: '/services/divination-voyance' },
  { name: 'Protection & Désenvoûtement', href: '/services/protection-desenvoutement' },
  { name: 'Santé & Pharmacopée', href: '/services/sante-traditionnelle' },
  { name: 'Justice & Procès', href: '/services/justice-proces-litiges' },
  { name: 'Immigration & Titres de Séjour', href: '/services/immigration-titres-sejour-visas' },
];

const boutiqueCategories = [
  { name: 'Savons Rituels', href: '/boutique/savons' },
  { name: 'Eaux Sacrées', href: '/boutique/eaux' },
  { name: 'Parfums & Macérations', href: '/boutique/parfums-macerations' },
  { name: 'Poudres & Terres Sacrées', href: '/boutique/poudres-terres-sacrees' },
  { name: 'Talismans & Gris-Gris', href: '/boutique/talismans-cuir-gris-gris' },
  { name: 'Parures & Métaux', href: '/boutique/parures-bayas-metaux' },
  { name: 'Cadenas Sacrés', href: '/boutique/cadenas-receptacles-argent' },
  { name: 'Pharmacopée Végétale', href: '/boutique/pharmacopee-vegetale' },
];

const mainNav = [
  { name: 'Accueil', href: '/' },
  { name: 'Services & Rituels', href: '/services', dropdown: serviceCategories },
  { name: 'Boutique', href: '/boutique', dropdown: boutiqueCategories },
  { name: 'À Propos', href: '/a-propos' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="sticky top-0 z-50 bg-white border-b border-slate-200 shadow-xs transition-colors duration-200" id="site-header">
  
  <!-- TOP BAR HIGH CONTRAST -->
  <div class="bg-brand-950 text-white text-xs py-2 px-4 border-b border-slate-800">
    <div class="max-w-content mx-auto flex justify-between items-center">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 text-[11px] font-bold tracking-wide">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Cabinet Ouvert 24h/7j
        </span>
        <span class="text-slate-300 hidden md:inline font-medium">Paris & Toute la France • Ligne Confidentielle Express</span>
      </div>

      <div class="flex items-center gap-4 text-xs font-medium">
        <span class="text-slate-300 hidden sm:inline">Secret Professionnel Garanti</span>
        <span class="text-slate-600 hidden sm:inline">•</span>
        <a href={`tel:${siteSettings.phone}`} class="hover:text-white text-slate-100 transition-colors flex items-center gap-1.5 font-bold">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span>{siteSettings.phoneDisplay}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- MAIN NAVIGATION (Pure White Background) -->
  <div class="bg-white">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-18 lg:h-20">
        
        <!-- Brand Logo - High Contrast -->
        <a href="/" class="flex items-center gap-3 group focus:outline-none flex-shrink-0" aria-label="Cabinet Aziman - Accueil">
          <div class="w-10 h-10 lg:w-11 lg:h-11 bg-brand-900 rounded-xl flex items-center justify-center text-white shadow-md group-hover:bg-brand-950 transition-all duration-200 border border-slate-700">
            <span class="font-serif font-bold text-xl text-white tracking-wider">A</span>
          </div>
          <div class="flex flex-col">
            <span class="font-serif font-bold text-xl lg:text-2xl text-slate-900 tracking-tight leading-none">Cabinet Aziman</span>
            <span class="text-[10px] lg:text-[11px] text-slate-600 font-sans font-bold tracking-wider uppercase mt-1">Grand Marabout en France</span>
          </div>
        </a>

        <!-- DESKTOP NAVIGATION MENU (Always visible on lg: and up) -->
        <nav class="hidden lg:flex items-center space-x-1.5 xl:space-x-2" aria-label="Navigation principale">
          {mainNav.map((link) => {
            const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
            
            if (link.dropdown) {
              return (
                <div class="relative group">
                  <a
                    href={link.href}
                    class={`px-3.5 py-2 rounded-xl text-xs xl:text-sm font-semibold transition-all duration-150 inline-flex items-center gap-1 ${
                      isActive
                        ? 'text-brand-900 bg-slate-100 font-bold border border-slate-300'
                        : 'text-slate-800 hover:text-brand-900 hover:bg-slate-100'
                    }`}
                  >
                    <span>{link.name}</span>
                    <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-slate-900 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </a>

                  <!-- Dropdown Menu -->
                  <div class="absolute left-0 top-full pt-1.5 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50 pointer-events-none group-hover:pointer-events-auto">
                    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 p-2 space-y-0.5">
                      {link.dropdown.map((sub) => (
                        <a
                          href={sub.href}
                          class="block px-3 py-2 rounded-lg text-xs font-semibold text-slate-800 hover:text-brand-900 hover:bg-slate-100 transition-colors"
                        >
                          {sub.name}
                        </a>
                      ))}
                      <div class="pt-1.5 mt-1.5 border-t border-slate-100 px-3 pb-1">
                        <a href={link.href} class="text-[11px] font-bold text-indigo-700 hover:text-indigo-900 hover:underline flex items-center justify-between">
                          <span>Voir tout : {link.name}</span>
                          <span>→</span>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              );
            }

            return (
              <a
                href={link.href}
                class={`px-3.5 py-2 rounded-xl text-xs xl:text-sm font-semibold transition-all duration-150 ${
                  isActive
                    ? 'text-brand-900 bg-slate-100 font-bold border border-slate-300'
                    : 'text-slate-800 hover:text-brand-900 hover:bg-slate-100'
                }`}
              >
                {link.name}
              </a>
            );
          })}
        </nav>

        <!-- Desktop Action CTA (WhatsApp 24/7) -->
        <div class="hidden lg:flex items-center gap-2.5 flex-shrink-0">
          <a
            href={siteSettings.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-whatsapp text-xs py-2.5 px-4 shadow-sm font-bold"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>WhatsApp 24/7</span>
          </a>
        </div>

        <!-- Mobile Hamburger Button (Strictly hidden on lg:) -->
        <div class="flex items-center gap-2 lg:hidden">
          <a
            href={siteSettings.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 text-emerald-600 hover:bg-emerald-50 rounded-xl transition-colors"
            aria-label="Contacter sur WhatsApp"
          >
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </a>

          <button
            type="button"
            id="mobile-menu-button"
            class="p-2 rounded-xl text-slate-800 hover:text-brand-900 hover:bg-slate-100 focus:outline-none"
            aria-label="Ouvrir le menu"
            aria-expanded="false"
          >
            <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu (Strictly hidden on lg:) -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-slate-200 shadow-xl max-h-[85vh] overflow-y-auto">
    <div class="px-4 pt-3 pb-6 space-y-1">
      {mainNav.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <div class="border-b border-slate-100 pb-1">
            <a
              href={link.href}
              class={`flex items-center justify-between px-4 py-3 rounded-xl text-sm font-semibold transition-colors ${
                isActive
                  ? 'text-brand-900 bg-slate-100 font-bold'
                  : 'text-slate-800 hover:text-brand-900 hover:bg-slate-50'
              }`}
            >
              <span>{link.name}</span>
              {link.dropdown && <span class="text-xs text-indigo-700 font-bold">Explorer →</span>}
            </a>
            {link.dropdown && (
              <div class="pl-4 pr-2 pb-2 pt-1 grid grid-cols-1 gap-1">
                {link.dropdown.map((sub) => (
                  <a
                    href={sub.href}
                    class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-brand-900 hover:bg-slate-50 flex items-center gap-1.5"
                  >
                    <span>•</span>
                    <span>{sub.name}</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        );
      })}

      <!-- Mobile Contact Buttons -->
      <div class="pt-4 space-y-2">
        <a
          href={siteSettings.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp w-full justify-center text-sm py-3 font-bold"
        >
          <span>Échanger sur WhatsApp 24h/7j</span>
        </a>
        <a
          href={`tel:${siteSettings.phone}`}
          class="btn-secondary w-full justify-center text-sm py-3 font-bold"
        >
          <span>Appeler le {siteSettings.phoneDisplay}</span>
        </a>
      </div>
    </div>
  </div>

</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  button?.addEventListener('click', () => {
    const isExpanded = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', (!isExpanded).toString());
    
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
