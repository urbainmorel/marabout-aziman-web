---
import { siteSettings } from '../mock/data';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Contactez le Cabinet Aziman",
  subtitle = "Une écoute bienveillante, un diagnostic divinatoire précis et des rituels ancestraux pour débloquer définitivement votre situation."
} = Astro.props;
---

<section class="relative bg-gradient-to-br from-brand-dark via-brand-900 to-[#120046] text-white py-12 md:py-16 px-4 sm:px-6 lg:px-8 overflow-hidden rounded-2xl md:rounded-3xl shadow-ambient-lg my-10 md:my-16" data-purpose="cta-section">
  <!-- Subtle decorative ambient circles -->
  <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-gold-500/10 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-brand-500/20 blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-2xl mx-auto text-center space-y-6">
    <span class="badge-gold text-xs px-3 py-1 shadow-sm">
      Disponibilité Immédiate 7j/7
    </span>

    <h2 class="font-serif font-bold text-2xl sm:text-3xl md:text-4xl text-white tracking-tight leading-tight">
      {title}
    </h2>

    <p class="font-sans text-xs sm:text-sm md:text-base text-gray-200 leading-relaxed max-w-xl mx-auto">
      {subtitle}
    </p>

    <!-- CTAs Container -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-lg mx-auto pt-2">
      <!-- WhatsApp CTA -->
      <a
        href={siteSettings.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative bg-[#128C7E] hover:bg-[#0d6e62] rounded-2xl p-4 flex items-center gap-3.5 shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-0.5 text-left"
      >
        <div class="w-11 h-11 rounded-xl bg-white/20 flex items-center justify-center text-white flex-shrink-0">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.414 0 .018 5.394 0 12.03a11.972 11.972 0 001.605 6.057L0 24l6.132-1.61a11.874 11.874 0 005.915 1.569h.005c6.635 0 12.032-5.396 12.035-12.032a11.85 11.85 0 00-3.48-8.504z"/>
          </svg>
        </div>
        <div>
          <p class="font-sans font-bold text-sm text-white leading-tight">WhatsApp 24h/7j</p>
          <p class="text-[11px] text-emerald-100 font-sans mt-0.5">Réponse en direct</p>
        </div>
        <div class="ml-auto text-white/70 group-hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </div>
      </a>

      <!-- Call Direct CTA -->
      <a
        href={`tel:${siteSettings.phone}`}
        class="group relative bg-white hover:bg-gold-50 rounded-2xl p-4 flex items-center gap-3.5 shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-0.5 text-left border border-gold-200"
      >
        <div class="w-11 h-11 rounded-xl bg-brand-100 flex items-center justify-center text-brand-900 flex-shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
        </div>
        <div>
          <p class="font-sans font-bold text-sm text-brand-dark leading-tight">Appel Direct</p>
          <p class="text-[11px] text-gray-600 font-sans mt-0.5">{siteSettings.phoneDisplay}</p>
        </div>
        <div class="ml-auto text-gray-400 group-hover:text-brand-900 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </div>
      </a>
    </div>

    <!-- Reassurance Footer -->
    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-6 text-xs text-gray-300">
      <span class="flex items-center gap-1.5 text-emerald-300">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
        Écoute attentive sans jugement
      </span>
      <span class="hidden sm:inline text-gold-400">•</span>
      <span class="text-gold-200 uppercase tracking-wider text-[10px] font-semibold">
        Secret Professionnel Garanti
      </span>
    </div>
  </div>
</section>
