---
import { siteSettings } from '../data/siteData';

interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
}

const {
  title = "Ne restez plus seul face à vos épreuves et blocages",
  subtitle = "Maître Aziman vous reçoit en toute discrétion dans son cabinet en Île-de-France ou intervient à distance avec une réactivité immédiate 7j/7.",
  buttonText = "Échanger directement sur WhatsApp",
} = Astro.props;
---

<section class="my-16 md:my-24 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
  <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-brand-900 via-brand-dark to-slate-900 text-white p-8 sm:p-12 md:p-16 shadow-2xl border border-gold-400/20">
    
    <!-- Background ornament -->
    <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-gold-400/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-20 -top-20 w-80 h-80 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-2xl mx-auto text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-400/15 border border-gold-400/30 text-gold-300 text-xs font-semibold uppercase tracking-wider">
        <span>✦</span>
        <span>Consultation Confidentielle & Urgences 24h/7j</span>
        <span>✦</span>
      </div>

      <h2 class="font-serif font-bold text-2xl sm:text-3xl md:text-4xl text-white leading-tight">
        {title}
      </h2>

      <p class="text-sm sm:text-base text-gray-300 leading-relaxed font-sans">
        {subtitle}
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={siteSettings.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp w-full sm:w-auto text-sm py-3.5 px-8 shadow-lg hover:shadow-xl font-bold"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>{buttonText}</span>
        </a>

        <a
          href="/contact"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-xl bg-white/10 hover:bg-white/20 text-white text-sm font-semibold border border-white/20 transition-colors"
        >
          <span>Prendre RDV en cabinet</span>
          <span>→</span>
        </a>
      </div>

      <div class="pt-2 text-xs text-gray-400 flex items-center justify-center gap-6">
        <span>✓ Confidentialité absolue</span>
        <span>✓ Réponse rapide</span>
        <span>✓ Suivi personnalisé</span>
      </div>
    </div>
  </div>
</section>
