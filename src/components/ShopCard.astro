---
import { siteSettings } from '../data/siteData';
import type { ShopCategory } from '../data/shopData';

interface Props {
  category: ShopCategory;
}

const { category } = Astro.props;
const whatsappOrderUrl = `https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(`Bonjour Maître Aziman, je souhaite commander ou avoir des informations sur le rayon ésotérique : ${category.name}`)}`;
---

<div class="card-luxury overflow-hidden flex flex-col h-full group hover:border-gold-300 transition-all duration-300">
  <div class="relative h-44 overflow-hidden bg-gray-100">
    <img
      src={category.image}
      alt={category.title}
      loading="lazy"
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
    />
    <div class="absolute top-2 right-2 bg-brand-dark/85 backdrop-blur-sm text-gold-300 text-xs font-semibold px-2.5 py-1 rounded-md">
      À partir de {category.price}
    </div>
    <div class="absolute bottom-2 left-2 bg-emerald-700/90 text-white text-[10px] font-medium px-2 py-0.5 rounded shadow">
      Colissimo 48h France
    </div>
  </div>

  <div class="p-5 flex-1 flex flex-col justify-between">
    <div>
      <h3 class="font-serif font-bold text-lg text-brand-dark group-hover:text-brand-800 transition-colors">
        <a href={`/boutique/${category.category}`}>{category.name}</a>
      </h3>

      <p class="text-xs text-gray-600 line-clamp-2 mt-2 leading-relaxed">
        {category.metaDescription || category.content.slice(0, 110)}
      </p>

      {category.products && category.products.length > 0 && (
        <div class="mt-3 pt-2 border-t border-gray-100 text-[11px] text-gray-500">
          <span class="font-medium text-brand-900">Articles disponibles : </span>
          {category.products.slice(0, 2).map(p => p.title.replace(' en France', '')).join(', ')}...
        </div>
      )}
    </div>

    <div class="pt-4 mt-4 border-t border-gray-100 flex items-center gap-2">
      <a
        href={`/boutique/${category.category}`}
        class="flex-1 py-2 px-3 text-center text-xs font-medium text-brand-900 bg-brand-50 hover:bg-brand-100 rounded-lg transition-colors"
      >
        Voir le rayon
      </a>
      <a
        href={whatsappOrderUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-whatsapp text-xs py-2 px-3 shadow-sm"
        title="Commander sur WhatsApp"
        aria-label="Commander sur WhatsApp"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>WhatsApp</span>
      </a>
    </div>
  </div>
</div>
