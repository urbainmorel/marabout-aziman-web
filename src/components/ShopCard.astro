---
import ExpandableText from './ExpandableText.astro';

interface Props {
  category: {
    category: string;
    title: string;
    name: string;
    image: string;
    homeDescription?: string;
    content?: string;
  };
  index?: number;
  expandable?: boolean;
}

const { category, index, expandable = false } = Astro.props;

// Exact description mapped from PAGE D'ACCUEIL.txt
const homeShopDescriptions: Record<string, string> = {
  'savons': "Savons d'étoile Afé, savons de fortune et savons de grand désenvoûtement.",
  'eaux': "Eaux des 7 marigots sacrés et eaux lustrales de purification d'habitat.",
  'parfums-macerations': "Parfums Bint El Sudan d'argent, Dangoma de charme et huile de palmiste noire.",
  'poudres-terres-sacrees': "Poudre de blindage Gblon et poudre de parole d'autorité Klaman.",
  'talismans-cuir-gris-gris': "Amulettes de bras, ceintures Gbékoun et cornes de bélier protectrices.",
  'parures-bayas-metaux': "Bayas de séduction magnétisés, bracelets de fer de Gou et bagues anti-poison.",
  'cadenas-receptacles-argent': "Cadenas d'amour scellés, portefeuilles magiques Bédou et calebasses d'abondance.",
  'pharmacopee-vegetale': "Bouteilles d'Agbo pour la vitalité masculine et décoctions de fertilité féminine."
};

const desc = homeShopDescriptions[category.category] || category.homeDescription || category.content?.slice(0, 120) || '';
---

<div class="card-luxury p-3 sm:p-5 flex flex-col justify-between group hover:border-brand-500 transition-all duration-200 shadow-xs bg-white rounded-2xl">
  <div>
    <div class="relative aspect-[16/10] mb-3 rounded-xl overflow-hidden bg-brand-950">
      <img
        src={category.image}
        alt={category.title}
        loading="lazy"
        decoding="async"
        width="800"
        height="500"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-950/85 via-transparent to-transparent"></div>
      <div class="absolute bottom-2 left-2.5 right-2.5">
        <h3 class="text-white font-serif font-bold text-xs sm:text-base leading-tight drop-shadow">
          <a href={`/boutique/${category.category}/`} class="hover:text-brand-200 transition-colors">
            {index ? `${index}. ` : ''}{category.name}
          </a>
        </h3>
      </div>
    </div>

    <!-- Description: Expandable on home, Full on pillar pages -->
    {expandable ? (
      <ExpandableText text={desc} />
    ) : (
      <p class="font-sans text-xs sm:text-sm text-slate-700 leading-relaxed">
        {desc}
      </p>
    )}
  </div>

  <a
    href={`/boutique/${category.category}/`}
    class="inline-flex items-center justify-between w-full pt-2.5 mt-3 text-[11px] sm:text-xs font-bold text-brand-900 hover:text-brand-700 border-t border-brand-100 transition-colors uppercase tracking-wider"
  >
    <span>Voir les articles</span>
    <span class="text-xs sm:text-sm group-hover:translate-x-1 transition-transform">→</span>
  </a>
</div>
