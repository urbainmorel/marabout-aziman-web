---
import { siteSettings } from '../data/siteData';
import { servicesHubs } from '../data/servicesData';
import { allZones } from '../data/zonesData';
---

<footer class="bg-brand-950 text-slate-200 pt-16 pb-12 border-t border-slate-800 relative overflow-hidden">
  
  <!-- Subtle ambient glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-24 bg-brand-700/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8 pb-12 border-b border-slate-800">
      
      <!-- Col 1: Brand & Presentation -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3.5">
          <div class="w-11 h-11 bg-brand-900 rounded-xl flex items-center justify-center text-white shadow-md border border-brand-700">
            <span class="font-serif font-bold text-xl text-white">A</span>
          </div>
          <div class="flex flex-col">
            <span class="font-serif font-bold text-2xl text-white tracking-tight leading-none">Cabinet Aziman</span>
            <span class="text-xs text-brand-300 font-sans font-semibold tracking-wider uppercase mt-1">{siteSettings.fullName}</span>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-sm font-sans">
          Grand marabout voyant traditionnel en France, héritier des secrets sacrés du Fâ et du Vodun d'Abomey et Cotonou. Consultations privées en Île-de-France et rituels sérieux à distance partout en France et à l'international.
        </p>
      </div>

      <!-- Col 2: Major Rituals (Services) -->
      <div class="space-y-4">
        <h4 class="font-serif font-bold text-base sm:text-lg text-white tracking-wide border-b border-brand-800 pb-2">
          Nos 8 Domaines
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm">
          {servicesHubs.slice(0, 6).map((svc) => (
            <li>
              <a href={`/services/${svc.silo}`} class="text-slate-300 hover:text-white transition-colors">
                {svc.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/services" class="text-brand-300 hover:underline text-xs font-semibold">
              Voir tous les 8 domaines →
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Regional Intervention Zones -->
      <div class="space-y-4">
        <h4 class="font-serif font-bold text-base sm:text-lg text-white tracking-wide border-b border-brand-800 pb-2">
          Zones en France
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm">
          {allZones.slice(0, 6).map((zone) => (
            <li>
              <a href={`/zones-d-intervention/${zone.slug}`} class="text-slate-300 hover:text-white transition-colors">
                {zone.regionName}
              </a>
            </li>
          ))}
          <li>
            <a href="/zones-d-intervention" class="text-brand-300 hover:underline text-xs font-semibold">
              Toutes les régions de France →
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Quick Navigation & Legal -->
      <div class="space-y-4">
        <h4 class="font-serif font-bold text-base sm:text-lg text-white tracking-wide border-b border-brand-800 pb-2">
          Informations & Légal
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li><a href="/a-propos" class="text-slate-300 hover:text-white transition-colors">À Propos du Maître</a></li>
          <li><a href="/cabinet-france" class="text-slate-300 hover:text-white transition-colors">Cabinet en France & RDV</a></li>
          <li><a href="/temoignages-avis" class="text-slate-300 hover:text-white transition-colors">Avis & Témoignages</a></li>
          <li><a href="/boutique" class="text-slate-300 hover:text-white transition-colors">Boutique Ésotérique</a></li>
          <li><a href="/blog" class="text-slate-300 hover:text-white transition-colors">Blog & Guides</a></li>
          <li><a href="/contact" class="text-slate-300 hover:text-white transition-colors">Contact & Urgences</a></li>
          <li><a href="/mentions-legales" class="text-slate-400 hover:text-white transition-colors">Mentions Légales</a></li>
          <li><a href="/politique-confidentialite" class="text-slate-400 hover:text-white transition-colors">Politique de Confidentialité</a></li>
          <li><a href="/cgu" class="text-slate-400 hover:text-white transition-colors">Conditions Générales (CGU)</a></li>
          <li><a href="/cookies" class="text-slate-400 hover:text-white transition-colors">Gestion des Cookies</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Disclaimer & Copyright -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-400 gap-4 font-sans">
      <p>
        © {new Date().getFullYear()} {siteSettings.legalEntity} / {siteSettings.commercialName}. SIRET : {siteSettings.siret}.
      </p>
      <p class="text-center md:text-right max-w-lg text-[11px] text-slate-400">
        Les rituels et consultations traditionnelles relèvent des pratiques spirituelles ancestrales. Ils ne dispensent en aucun cas d'un diagnostic médical ou d'un conseil juridique d'un professionnel agréé.
      </p>
    </div>
  </div>
</footer>
