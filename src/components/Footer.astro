---
import { siteSettings } from '../mock/data';
---

<footer class="bg-[#120046] text-white pt-14 pb-10 border-t border-brand-900/60" id="site-footer">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 mb-12">
      
      <!-- Col 1: Brand & Presentation -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-brand-900 rounded-xl flex items-center justify-center text-gold-300 shadow-md border border-gold-400/30">
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 20 20">
              <path clip-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" fill-rule="evenodd"></path>
            </svg>
          </div>
          <div>
            <span class="font-serif font-bold text-xl text-white tracking-tight block">Cabinet Aziman</span>
            <span class="text-[11px] text-gold-300/90 uppercase tracking-wider block font-sans">Grand Marabout en France</span>
          </div>
        </div>
        
        <p class="text-xs text-gray-300 leading-relaxed">
          Initié aux secrets ancestraux du Fâ et des grands sanctuaires traditionnels, Maître Aziman intervient pour résoudre vos problèmes sentimentaux, financiers et spirituels avec une discrétion totale.
        </p>

        <div class="pt-2 flex items-center gap-2 text-xs text-emerald-300 font-medium">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <span>Secret Professionnel & Confidentialité 100%</span>
        </div>
      </div>

      <!-- Col 2: Rituels & Domaines -->
      <div>
        <h3 class="font-serif text-lg font-semibold text-gold-200 mb-4 border-b border-gold-400/20 pb-2">Nos Rituels Majeurs</h3>
        <ul class="space-y-2 text-xs text-gray-300">
          <li><a href="/#domaines" class="hover:text-gold-300 transition-colors">Retour Affectif Immédiat (24h-72h)</a></li>
          <li><a href="/#domaines" class="hover:text-gold-300 transition-colors">Cadenas d'Amour & Scellement</a></li>
          <li><a href="/#domaines" class="hover:text-gold-300 transition-colors">Protection & Désenvoûtement</a></li>
          <li><a href="/#domaines" class="hover:text-gold-300 transition-colors">Ouverture de Chance & Prospérité</a></li>
          <li><a href="/#domaines" class="hover:text-gold-300 transition-colors">Attraction Clientèle & Commerce</a></li>
          <li><a href="/#domaines" class="hover:text-gold-300 transition-colors">Justice, Litiges & Papiers</a></li>
        </ul>
      </div>

      <!-- Col 3: Liens & Navigation -->
      <div>
        <h3 class="font-serif text-lg font-semibold text-gold-200 mb-4 border-b border-gold-400/20 pb-2">Navigation Rapide</h3>
        <ul class="space-y-2 text-xs text-gray-300">
          <li><a href="/" class="hover:text-gold-300 transition-colors">Page d'Accueil</a></li>
          <li><a href="/a-propos" class="hover:text-gold-300 transition-colors">À Propos de Maître Aziman</a></li>
          <li><a href="/#boutique" class="hover:text-gold-300 transition-colors">Boutique Ésotérique Ancestrale</a></li>
          <li><a href="/blog" class="hover:text-gold-300 transition-colors">Blog & Enseignements Spirituels</a></li>
          <li><a href="/contact" class="hover:text-gold-300 transition-colors">Prendre Rendez-vous / Contact</a></li>
          <li><a href="/mentions-legales" class="hover:text-gold-300 transition-colors">Informations Légales & Déontologie</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact & Urgences -->
      <div class="space-y-3">
        <h3 class="font-serif text-lg font-semibold text-gold-200 mb-4 border-b border-gold-400/20 pb-2">Cabinet & Contact</h3>
        <div class="space-y-2.5 text-xs text-gray-300">
          <p class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-gold-300 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
            <span>{siteSettings.address}</span>
          </p>
          <p class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-gold-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>{siteSettings.workingHours}</span>
          </p>
          <p class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-gold-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href={`mailto:${siteSettings.email}`} class="hover:text-gold-300">{siteSettings.email}</a>
          </p>
        </div>

        <div class="pt-3">
          <a
            href={siteSettings.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-whatsapp text-xs py-2 px-3 w-full justify-center"
          >
            <span>WhatsApp Direct ({siteSettings.phoneDisplay})</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Divider -->
    <div class="gold-divider mb-6 opacity-40"></div>

    <!-- Bottom Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-gray-400">
      <p>© {new Date().getFullYear()} Cabinet Aziman — Tous droits réservés.</p>
      
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/mentions-legales" class="hover:text-gold-300 transition-colors">Mentions Légales</a>
        <span>•</span>
        <a href="/politique-confidentialite" class="hover:text-gold-300 transition-colors">Politique de Confidentialité</a>
        <span>•</span>
        <a href="/cgu" class="hover:text-gold-300 transition-colors">Conditions Générales (CGU)</a>
      </div>
    </div>

  </div>
</footer>
