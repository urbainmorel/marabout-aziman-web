---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaSection from '../components/CtaSection.astro';
import type { Post } from '../mock/data';
import { siteSettings, mockPosts } from '../mock/data';

interface Props {
  post: Post;
  relatedPosts?: Post[];
}

const { post, relatedPosts = mockPosts.filter((p) => p.slug !== post.slug).slice(0, 3) } = Astro.props;
---

<BaseLayout
  title={`${post.title} | Cabinet Aziman`}
  description={post.excerpt}
  image={post.mainImage.asset.url}
  article={{
    publishedTime: post.publishedAt,
    author: post.author.name,
    section: post.category.title,
  }}
>
  <!-- Breadcrumbs -->
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumbs
      items={[
        { label: 'Blog', href: '/blog' },
        { label: post.category.title, href: `/blog/categorie/${post.category.slug}` },
        { label: post.title, href: `/blog/${post.slug}` },
      ]}
    />
  </div>

  <!-- Article Header Section -->
  <header class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 text-center">
    <div class="flex items-center justify-center gap-3 text-xs text-slate-500 mb-4">
      <span class="badge-sacred text-xs">{post.category.title}</span>
      <span>•</span>
      <span>Publié le {new Date(post.publishedAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
      <span>•</span>
      <span>Lecture : {post.readingTime}</span>
    </div>

    <h1 class="font-serif font-bold text-3xl sm:text-4xl md:text-5xl text-brand-dark tracking-tight leading-tight mb-6">
      {post.title}
    </h1>

    <p class="font-sans text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
      {post.excerpt}
    </p>

    <!-- Author Avatar & Name -->
    <div class="flex items-center justify-center gap-3 mt-6 pt-4 border-t border-brand-100 max-w-xs mx-auto">
      <div class="w-10 h-10 rounded-full bg-brand-900 text-white flex items-center justify-center font-serif font-bold text-sm shadow-sm">
        MA
      </div>
      <div class="text-left">
        <span class="font-sans font-bold text-xs md:text-sm text-brand-dark block">{post.author.name}</span>
        <span class="text-[11px] text-slate-500 block">{post.author.role}</span>
      </div>
    </div>
  </header>

  <!-- Article Main Image -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
    <div class="relative h-64 sm:h-96 md:h-[480px] rounded-2xl overflow-hidden shadow-ambient bg-brand-950">
      <img
        src={post.mainImage.asset.url}
        alt={post.mainImage.alt}
        class="w-full h-full object-cover object-center"
      />
    </div>
  </div>

  <!-- Article Content & Sticky Sidebar Grid -->
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Main Content Column -->
      <div class="lg:col-span-8">
        <article class="prose-aziman bg-white p-6 sm:p-10 rounded-2xl border border-brand-200/80 shadow-sm">
          {post.bodyHtml ? (
            <div set:html={post.bodyHtml} />
          ) : (
            <slot />
          )}

          <!-- Internal Recommendation Box -->
          <div class="my-10 p-6 bg-brand-50 border border-brand-200 rounded-xl space-y-3">
            <div class="flex items-center gap-2 text-brand-900 font-serif font-bold text-lg">
              <svg class="w-5 h-5 text-brand-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
              </svg>
              <span>Avertissement & Déontologie</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-700 font-sans leading-relaxed">
              Chaque situation sentimentale et spirituelle est unique. Maître Aziman réalise une voyance préalable sans complaisance afin de vérifier la faisabilité du rituel et de vous garantir des résultats concrets sous 24h à 72h.
            </p>
          </div>

          <!-- Author Bio Box -->
          <div class="mt-12 pt-8 border-t border-brand-200 flex flex-col sm:flex-row items-center sm:items-start gap-5">
            <div class="w-16 h-16 rounded-2xl bg-brand-900 text-white flex items-center justify-center font-serif font-bold text-2xl flex-shrink-0 shadow-md border border-brand-700">
              MA
            </div>
            <div class="text-center sm:text-left space-y-2">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <h3 class="font-serif font-bold text-lg text-brand-dark">{post.author.name}</h3>
                <span class="text-xs text-brand-900 font-bold bg-brand-100 px-2.5 py-0.5 rounded-full inline-block">25+ ans d'expérience</span>
              </div>
              <p class="text-xs text-slate-600 font-sans leading-relaxed">
                {post.author.bio}
              </p>
              <div class="pt-2">
                <a
                  href={siteSettings.whatsappLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-whatsapp text-xs py-2 px-4 inline-flex"
                >
                  <span>WhatsApp 24/7</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      </div>

      <!-- Sidebar Column -->
      <aside class="lg:col-span-4 space-y-6">
        
        <!-- Sticky Quick Consultation Card -->
        <div class="sticky top-28 bg-white p-6 rounded-2xl border border-brand-200/80 shadow-ambient space-y-5">
          <div class="text-center pb-4 border-b border-brand-100">
            <span class="badge-royal text-[10px] mb-2">Urgence & RDV Privé</span>
            <h3 class="font-serif font-bold text-xl text-brand-dark">Besoin d'une voyance immédiate ?</h3>
            <p class="text-xs text-slate-500 font-sans mt-1">Consultation directe en cabinet ou par téléphone</p>
          </div>

          <div class="space-y-3">
            <a
              href={siteSettings.whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-whatsapp w-full justify-center text-xs py-3"
            >
              <span>WhatsApp 24/7</span>
            </a>
            
            <a
              href={`tel:${siteSettings.phone}`}
              class="btn-primary w-full justify-center text-xs py-3"
            >
              <span>Appeler le Cabinet</span>
            </a>
          </div>

          <div class="pt-3 text-[11px] text-slate-500 font-sans space-y-2 border-t border-brand-100">
            <div class="flex items-center gap-2 text-emerald-700 font-bold">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              <span>Discrétion & Secret Initiatique 100%</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-brand-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path></svg>
              <span>Réponse garantie sous 15 minutes</span>
            </div>
          </div>
        </div>

      </aside>

    </div>
  </div>

  <!-- Related Posts Section -->
  {relatedPosts.length > 0 && (
    <section class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-brand-200">
      <div class="text-center mb-8">
        <span class="badge-sacred text-xs mb-2">Poursuivre votre lecture</span>
        <h2 class="font-serif font-bold text-2xl md:text-3xl text-brand-dark">Guides & Rituels Recommandés</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedPosts.map((rel) => (
          <article class="card-luxury overflow-hidden flex flex-col group">
            <div class="relative h-44 bg-brand-950 overflow-hidden">
              <img
                src={rel.mainImage.asset.url}
                alt={rel.mainImage.alt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-2.5 left-2.5 text-[10px] font-sans font-semibold text-white bg-brand-dark/80 px-2 py-0.5 rounded">
                {rel.category.title}
              </span>
            </div>
            <div class="p-4 flex flex-col justify-between flex-grow">
              <h3 class="font-serif font-bold text-base text-brand-dark group-hover:text-brand-900 transition-colors leading-snug mb-2 line-clamp-2">
                <a href={`/blog/${rel.slug}`}>{rel.title}</a>
              </h3>
              <a href={`/blog/${rel.slug}`} class="text-xs font-bold text-brand-900 hover:text-brand-700 transition-colors flex items-center gap-1 mt-3">
                <span>Consulter</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Global CTA Banner -->
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <CtaSection />
  </div>
</BaseLayout>
