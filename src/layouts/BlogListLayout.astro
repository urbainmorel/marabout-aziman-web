---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaSection from '../components/CtaSection.astro';
import type { Post, Category } from '../mock/data';
import { mockPosts, mockCategories } from '../mock/data';

interface Props {
  title?: string;
  description?: string;
  currentCategory?: Category;
  posts?: Post[];
}

const {
  title = 'Blog Ésotérique & Rituels Traditionnels | Cabinet Aziman',
  description = 'Découvrez les guides, conseils et explications du Maître Aziman sur les rituels de retour affectif, désenvoûtement, voyance et secrets initiatiques.',
  currentCategory,
  posts = mockPosts,
} = Astro.props;

const categories = mockCategories;
const filteredPosts = currentCategory
  ? posts.filter((p) => p.category.slug === currentCategory.slug)
  : posts;

const featuredPost = !currentCategory && filteredPosts.length > 0 ? filteredPosts[0] : null;
const regularPosts = !currentCategory && filteredPosts.length > 0 ? filteredPosts.slice(1) : filteredPosts;
---

<BaseLayout title={title} description={description}>
  <!-- Breadcrumbs -->
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumbs
      items={
        currentCategory
          ? [{ label: 'Blog', href: '/blog' }, { label: currentCategory.title }]
          : [{ label: 'Blog' }]
      }
    />
  </div>

  <!-- Page Header -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14 text-center">
    <span class="badge-sacred text-xs mb-3">
      {currentCategory ? `Catégorie : ${currentCategory.title}` : 'Enseignements & Rituels'}
    </span>
    
    <h1 class="font-serif font-bold text-3xl sm:text-4xl md:text-5xl text-brand-dark tracking-tight leading-tight mb-4">
      {currentCategory ? currentCategory.title : 'Le Blog Ésotérique & Mystique'}
    </h1>

    <p class="font-sans text-sm sm:text-base text-slate-600 leading-relaxed max-w-2xl mx-auto">
      {currentCategory?.description || description}
    </p>

    <!-- Category Filter Pills -->
    <div class="flex flex-wrap items-center justify-center gap-2 mt-8">
      <a
        href="/blog"
        class={`px-4 py-1.5 rounded-full text-xs font-sans font-medium transition-all ${
          !currentCategory
            ? 'bg-brand-900 text-white shadow-sm border border-brand-700'
            : 'bg-white text-slate-700 hover:text-brand-900 hover:bg-brand-50 border border-brand-200'
        }`}
      >
        Tous les articles
      </a>

      {categories.map((cat) => (
        <a
          href={`/blog/categorie/${cat.slug}`}
          class={`px-4 py-1.5 rounded-full text-xs font-sans font-medium transition-all ${
            currentCategory?.slug === cat.slug
              ? 'bg-brand-900 text-white shadow-sm border border-brand-700'
              : 'bg-white text-slate-700 hover:text-brand-900 hover:bg-brand-50 border border-brand-200'
          }`}
        >
          {cat.title}
        </a>
      ))}
    </div>
  </section>

  <!-- Content Section -->
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    
    <!-- Featured Post Spotlight -->
    {!currentCategory && featuredPost && (
      <div class="card-luxury overflow-hidden mb-12 border border-brand-200/80 hover:border-brand-500 transition-all duration-200">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
          <div class="lg:col-span-7 relative h-64 sm:h-80 lg:h-full min-h-[280px] bg-brand-950 overflow-hidden">
            <img
              src={featuredPost.mainImage.asset.url}
              alt={featuredPost.mainImage.alt}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-4 left-4 bg-brand-950/90 text-white text-xs font-bold px-3 py-1 rounded-full border border-brand-700 shadow-md">
              À la Une
            </span>
          </div>

          <div class="lg:col-span-5 p-6 sm:p-8 lg:p-10 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-3 text-xs text-slate-500 mb-3">
                <span class="font-bold text-brand-900 uppercase tracking-wider">{featuredPost.category.title}</span>
                <span>•</span>
                <span>{new Date(featuredPost.publishedAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                <span>•</span>
                <span>{featuredPost.readingTime}</span>
              </div>

              <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark mb-4 hover:text-brand-900 transition-colors">
                <a href={`/blog/${featuredPost.slug}`}>
                  {featuredPost.title}
                </a>
              </h2>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6 font-sans">
                {featuredPost.excerpt}
              </p>
            </div>

            <div class="pt-4 border-t border-brand-100 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-brand-900 text-white flex items-center justify-center font-bold text-xs">
                  MA
                </div>
                <span class="text-xs font-semibold text-slate-800">{featuredPost.author.name}</span>
              </div>

              <a
                href={`/blog/${featuredPost.slug}`}
                class="text-xs font-sans font-bold text-brand-900 hover:text-brand-700 transition-colors flex items-center gap-1"
              >
                <span>Lire le guide complet</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {regularPosts.map((post) => (
        <article class="card-luxury overflow-hidden flex flex-col h-full group hover:border-brand-500 transition-all duration-200">
          <div class="relative h-48 sm:h-52 overflow-hidden bg-brand-950">
            <img
              src={post.mainImage.asset.url}
              alt={post.mainImage.alt}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-3 left-3 text-[10px] font-sans font-bold text-white bg-brand-dark/90 backdrop-blur-sm px-2.5 py-1 rounded">
              {post.category.title}
            </span>
          </div>

          <div class="p-5 flex flex-col justify-between flex-grow">
            <div>
              <div class="flex items-center gap-2 text-[11px] text-slate-400 mb-2 font-sans">
                <span>{new Date(post.publishedAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                <span>•</span>
                <span>{post.readingTime}</span>
              </div>

              <h3 class="font-serif font-bold text-lg text-brand-dark group-hover:text-brand-900 transition-colors leading-snug mb-2">
                <a href={`/blog/${post.slug}`}>
                  {post.title}
                </a>
              </h3>

              <p class="text-xs text-slate-600 leading-relaxed line-clamp-3 mb-4 font-sans">
                {post.excerpt}
              </p>
            </div>

            <div class="pt-3 border-t border-brand-100 flex items-center justify-between mt-auto">
              <span class="text-[11px] text-slate-500 font-medium font-sans">Par {post.author.name}</span>
              <a
                href={`/blog/${post.slug}`}
                class="text-xs font-sans font-bold text-brand-900 hover:text-brand-700 transition-colors flex items-center gap-1"
              >
                <span>Lire</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Global CTA Banner -->
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <CtaSection />
  </div>
</BaseLayout>
