---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteSettings } from '../mock/data';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  currentPath?: string;
  canonicalUrl?: string;
  article?: {
    publishedTime: string;
    author: string;
    section: string;
  };
}

const {
  title = "Grand Marabout en France : Voyance & Rituels | Cabinet Aziman",
  description = "Consultez Maître Aziman, grand marabout en France. Retour affectif rapide, chance, protection et rituels ancestraux. RDV au cabinet ou à distance.",
  image = "/images/og-default.jpg",
  currentPath = Astro.url.pathname,
  canonicalUrl = Astro.url.href,
  article,
} = Astro.props;

const siteName = siteSettings.siteName;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Favicon & Theme -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1c0070" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="fr_FR" />

    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        <meta property="article:author" content={article.author} />
        <meta property="article:section" content={article.section} />
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Structured Data JSON-LD for Local Business & Spiritual Cabinet -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Cabinet Maître Aziman",
      "image": "https://marabout-aziman.fr/images/og-default.jpg",
      "url": "https://marabout-aziman.fr",
      "telephone": siteSettings.phone,
      "priceRange": "€€",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Paris",
        "addressRegion": "Île-de-France",
        "addressCountry": "FR"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "00:00",
          "closes": "23:59"
        }
      ],
      "areaServed": siteSettings.interventionCities.map(city => ({ "@type": "City", "name": city }))
    })} />
  </head>
  <body class="min-h-screen flex flex-col bg-surface text-on-surface antialiased selection:bg-brand-100 selection:text-brand-900">
    <!-- Header -->
    <Header currentPath={currentPath} />

    <!-- Main Content Area -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Floating Direct WhatsApp Button (Bottom Right) -->
    <aside aria-label="Assistance WhatsApp directe" class="fixed bottom-5 right-5 z-40">
      <a
        href={siteSettings.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 bg-[#128C7E] hover:bg-[#075E54] text-white px-3.5 py-2.5 rounded-full shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:scale-105 group border-2 border-white"
        aria-label="Discuter immédiatement avec Maître Aziman sur WhatsApp"
      >
        <span class="relative flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-300 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-400"></span>
        </span>
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.414 0 .018 5.394 0 12.03a11.972 11.972 0 001.605 6.057L0 24l6.132-1.61a11.874 11.874 0 005.915 1.569h.005c6.635 0 12.032-5.396 12.035-12.032a11.85 11.85 0 00-3.48-8.504z"/>
        </svg>
        <span class="text-xs font-sans font-bold hidden sm:inline">WhatsApp 24/7</span>
      </a>
    </aside>
  </body>
</html>
