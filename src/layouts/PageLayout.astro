---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs, { type BreadcrumbItem } from '../components/Breadcrumbs.astro';
import CtaSection from '../components/CtaSection.astro';
import { siteSettings } from '../mock/data';

interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  description?: string;
  heroImage?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  subtitle,
  badge = "Cabinet Maître Aziman",
  description,
  heroImage = "/images/og-default.webp",
  breadcrumbs = [],
} = Astro.props;
---

<BaseLayout title={`${title} | Cabinet Aziman`} description={description}>
  
  <!-- Breadcrumbs -->
  {breadcrumbs.length > 0 && (
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  )}

  <!-- Hero Header Section -->
  <section class="relative bg-brand-950 text-white py-12 md:py-20 px-4 sm:px-6 lg:px-8 overflow-hidden mb-10 border-b border-brand-800">
    <img
      src={heroImage}
      alt={title}
      class="absolute inset-0 w-full h-full object-cover opacity-20 mix-blend-luminosity scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-950 via-brand-950/80 to-transparent"></div>

    <div class="relative z-10 max-w-3xl mx-auto text-center space-y-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-white/10 text-white border border-white/20">
        {badge}
      </span>

      <h1 class="font-serif font-bold text-3xl sm:text-4xl md:text-5xl text-white tracking-tight leading-tight">
        {title}
      </h1>

      {subtitle && (
        <p class="font-sans text-sm sm:text-base md:text-lg text-slate-200 leading-relaxed max-w-2xl mx-auto">
          {subtitle}
        </p>
      )}

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href={siteSettings.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp text-xs py-2.5 px-5"
        >
          <span>WhatsApp 24/7</span>
        </a>
        <a
          href={`tel:${siteSettings.phone}`}
          class="btn-secondary text-xs py-2.5 px-5 bg-white/10 hover:bg-white/20 text-white border-white/25"
        >
          <span>Appeler le Cabinet</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Main Content Slot -->
  <main class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <slot />
  </main>

  <!-- Global CTA Banner -->
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <CtaSection />
  </div>
</BaseLayout>
