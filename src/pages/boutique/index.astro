---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import ShopCard from '../../components/ShopCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import { boutiqueCategories } from '../../data/shopData';
import { siteSettings } from '../../data/siteData';

const seoTitle = "Boutique Ésotérique Ancestrale : Produits Consacrés | Cabinet Aziman";
const seoDesc = "Découvrez la boutique ésotérique du Cabinet Maître Aziman. Savons rituels, eaux sacrées, parfums de chance, talismans et pharmacopée. Livraison 24/48h France.";
---

<BaseLayout title={seoTitle} description={seoDesc}>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Artisanat Sacré, Magnétisation & Pharmacopée"
    title="La Boutique Ésotérique Ancestrale du Maître Aziman"
    description="Chaque article de notre boutique est préparé, magnétisé et consacré selon les règles strictes de la tradition africaine. Commandez en toute sécurité avec livraison discrète en France par Colissimo ou Chronopost en 24h/48h."
    breadcrumbs={[{ label: 'Boutique Ésotérique', href: '/boutique' }]}
    highlightWord="Maître Aziman"
    image="/images/boutique/categories/savons-hero.webp"
    primaryCta={{ label: 'WhatsApp 24/7', href: 'https://wa.me/33753368297', icon: 'whatsapp' }}
    
  />

  <TrustBadges />

  <!-- CATEGORIES GRID -->
  <section class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {boutiqueCategories.map((cat) => (
        <ShopCard category={cat} />
      ))}
    </div>

    <!-- Assurance banner -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 p-8 sm:p-10 rounded-3xl bg-surface border border-brand-200/80 text-center shadow-xs">
      <div class="space-y-1.5">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-wider block">Garantie 01</span>
        <h3 class="font-serif font-bold text-base text-brand-dark">Livraison Discrète 24/48h</h3>
        <p class="text-xs text-slate-600 font-sans">Emballage neutre sans mention ésotérique. Colissimo Suivi & Chronopost.</p>
      </div>
      <div class="space-y-1.5">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-wider block">Garantie 02</span>
        <h3 class="font-serif font-bold text-base text-brand-dark">Consécration Personnalisée</h3>
        <p class="text-xs text-slate-600 font-sans">Chaque support est préparé au nom et prénom du consultant avant envoi.</p>
      </div>
      <div class="space-y-1.5">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-wider block">Garantie 03</span>
        <h3 class="font-serif font-bold text-base text-brand-dark">Commande Directe WhatsApp</h3>
        <p class="text-xs text-slate-600 font-sans">Conseils d'utilisation et validation immédiate au {siteSettings.whatsappDisplay}.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
