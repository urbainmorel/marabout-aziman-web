---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { boutiqueCategories, type ShopCategory } from '../../../data/shopData';
import { siteSettings } from '../../../data/siteData';

export async function getStaticPaths() {
  return boutiqueCategories.map((cat) => ({
    params: { category: cat.category },
    props: { cat },
  }));
}

interface Props {
  cat: ShopCategory;
}

const { cat } = Astro.props;
---

<BaseLayout title={cat.metaTitle} description={cat.metaDescription}>
  
  <!-- HERO -->
  <section class="bg-gradient-to-b from-brand-900 to-brand-800 text-white py-12 md:py-16 border-b border-gold-400/20">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs
        items={[
          { label: 'Boutique', href: '/boutique' },
          { label: cat.name, href: `/boutique/${cat.category}` },
        ]}
      />
      
      <div class="mt-6 max-w-3xl space-y-4">
        <div class="inline-block px-3 py-1 rounded-md bg-gold-400/20 text-gold-300 text-xs font-semibold uppercase tracking-wider">
          Rayon Boutique Ésotérique
        </div>
        <h1 class="font-serif font-bold text-3xl sm:text-4xl md:text-5xl text-white leading-tight">
          {cat.title}
        </h1>
        <p class="text-sm sm:text-base text-gray-200 leading-relaxed font-sans">
          {cat.metaDescription}
        </p>
      </div>
    </div>
  </section>

  <!-- CONTENT & PRODUCTS -->
  <article class="py-12 md:py-16 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <div class="lg:col-span-8 space-y-8 prose-aziman">
        
        <div class="text-sm sm:text-base text-gray-700 leading-relaxed space-y-4 whitespace-pre-line">
          {cat.content}
        </div>

        {cat.products && cat.products.length > 0 && (
          <div class="border-t border-gold-200/80 pt-8 space-y-6">
            <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
              Articles Disponibles dans ce Rayon
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {cat.products.map((prod) => (
                <div class="card-luxury p-5 bg-white border border-gray-200 hover:border-gold-300 transition-all flex flex-col justify-between group">
                  <div>
                    <div class="flex items-center justify-between mb-2">
                      <span class="text-xs font-bold text-brand-900 bg-brand-50 px-2 py-0.5 rounded">
                        {prod.price}
                      </span>
                      <span class="text-[10px] text-emerald-600 font-medium">En stock (48h)</span>
                    </div>
                    <h3 class="font-serif font-bold text-base text-brand-dark group-hover:text-brand-800 transition-colors">
                      <a href={`/boutique/${cat.category}/${prod.slug}`}>
                        {prod.title}
                      </a>
                    </h3>
                    <p class="text-xs text-gray-600 line-clamp-3 mt-2 leading-relaxed">
                      {prod.metaDescription}
                    </p>
                  </div>

                  <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between">
                    <a
                      href={`/boutique/${cat.category}/${prod.slug}`}
                      class="text-xs font-semibold text-brand-900 hover:text-gold-600"
                    >
                      Détails du produit
                    </a>
                    <a
                      href={`https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(`Bonjour Maître Aziman, je souhaite commander : ${prod.title}`)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-whatsapp text-xs py-1.5 px-3"
                    >
                      Commander
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="card-luxury p-6 bg-brand-900 text-white shadow-xl space-y-5 sticky top-24">
          <h3 class="font-serif font-bold text-lg text-white">Commander sur WhatsApp</h3>
          <p class="text-xs text-gray-300 leading-relaxed">
            Pour commander ou demander conseil sur l'utilisation des produits de ce rayon, échangez directement avec Maître Aziman :
          </p>

          <div class="space-y-2 text-xs text-gray-200">
            <p><strong>WhatsApp :</strong> {siteSettings.whatsappDisplay}</p>
            <p><strong>Expédition :</strong> Colissimo Suivi 48h France</p>
            <p><strong>Emballage :</strong> 100% neutre et discret</p>
          </div>

          <div class="pt-2">
            <a
              href={`https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(`Bonjour Maître Aziman, je souhaite des renseignements sur le rayon : ${cat.name}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-whatsapp w-full justify-center text-xs py-3 font-semibold"
            >
              <span>Contacter sur WhatsApp</span>
            </a>
          </div>
        </div>
      </aside>

    </div>
  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
