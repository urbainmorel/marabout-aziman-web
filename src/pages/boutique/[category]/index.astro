---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroHeader from '../../../components/HeroHeader.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import TrustBadges from '../../../components/TrustBadges.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { boutiqueCategories, type ShopCategory } from '../../../data/shopData';
import { siteSettings } from '../../../data/siteData';

export async function getStaticPaths() {
  return boutiqueCategories.map((cat) => ({
    params: { category: cat.category },
    props: { cat },
  }));
}

interface Props {
  cat: ShopCategory;
}

const { cat } = Astro.props;

// Category Schema
const categorySchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": cat.title,
  "description": cat.metaDescription,
  "url": `https://www.marabout-aziman.fr/boutique/${cat.category}/`
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://www.marabout-aziman.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Boutique",
      "item": "https://www.marabout-aziman.fr/boutique/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": cat.name,
      "item": `https://www.marabout-aziman.fr/boutique/${cat.category}/`
    }
  ]
};
// Split contentHtml around the product listing section so we replace it with rich cards
const splitRegex = /<h2[^>]*>(?:Les\s+[0-9]+\s+[^<]+|La Gamme Complète[^<]+)<\/h2>[\s\S]*?(?=<hr class="my-8 border-brand-200" \/>)/;
const hasMatch = cat.contentHtml && splitRegex.test(cat.contentHtml);
const [beforeProducts, afterProducts] = hasMatch
  ? cat.contentHtml.split(splitRegex)
  : [cat.contentHtml, ''];
---

<BaseLayout
  title={cat.metaTitle}
  description={cat.metaDescription}
  keywords={cat.keywords}
  image={cat.image}
  schema={[categorySchema, breadcrumbSchema]}
>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Rayon Ésotérique & Produits Consacrés"
    title={cat.title}
    description={cat.metaDescription}
    breadcrumbs={[
      { label: 'Boutique', href: '/boutique' },
      { label: cat.name, href: `/boutique/${cat.category}` },
    ]}
  
    image={"https://images.unsplash.com/photo-1606760227091-3dd870d97f1d?q=80&w=1000&auto=format&fit=crop"}
    primaryCta={{ label: 'WhatsApp 24/7', href: 'https://wa.me/33753368297', icon: 'whatsapp' }}
    
  />

  <TrustBadges />

  <!-- CONTENT & PRODUCTS -->
  <article class="py-12 sm:py-16 md:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    
    <!-- Table of Contents -->
    <TableOfContents />

    <!-- Rich Semantic HTML Content (Partie 1) -->
    <div class="prose-aziman" set:html={beforeProducts} />

    <!-- Section Articles Consacrés sous forme de Cartes avec Image et Deux Boutons -->
    {cat.products && cat.products.length > 0 && (
      <section class="pt-2 space-y-6" id="articles-consacres">
        <div class="space-y-2">
          <span class="text-xs font-bold text-brand-700 uppercase tracking-wider">Catalogue Consacré</span>
          <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
            Les Articles Consacrés de notre Rayon
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 font-sans leading-relaxed">
            Découvrez nos articles préparés, magnétisés et consacrés selon les règles strictes de la tradition. Commandez directement sur WhatsApp ou consultez la fiche détaillée :
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {cat.products.map((prod) => {
            const whatsappOrderUrl = `https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(`Bonjour Maître Aziman, je souhaite commander l'article consacré : ${prod.title} (${prod.price})\nLien : https://www.marabout-aziman.fr/boutique/${cat.category}/${prod.slug}/`)}`;
            return (
              <div class="card-luxury p-4 sm:p-5 bg-white border border-brand-200/80 hover:border-brand-500 transition-all flex flex-col justify-between group shadow-xs rounded-2xl">
                <div>
                  <div class="relative aspect-[16/10] mb-3.5 rounded-xl overflow-hidden bg-brand-950">
                    <img
                      src={prod.image || cat.image}
                      alt={prod.title}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-brand-950/70 via-transparent to-transparent"></div>
                    <div class="absolute top-2.5 right-2.5 flex items-center gap-1.5">
                      <span class="text-xs font-serif font-bold text-brand-950 bg-white/95 backdrop-blur-xs px-2.5 py-0.5 rounded-full shadow-xs">
                        {prod.price}
                      </span>
                    </div>
                  </div>

                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[11px] text-emerald-800 bg-emerald-50 font-bold px-2 py-0.5 rounded-full border border-emerald-200/60">
                      ● En stock (Livraison 24/48h)
                    </span>
                  </div>

                  <h3 class="font-serif font-bold text-base sm:text-lg text-brand-dark group-hover:text-brand-900 transition-colors leading-snug">
                    <a href={`/boutique/${cat.category}/${prod.slug}`} class="hover:underline">
                      {prod.title}
                    </a>
                  </h3>
                  <p class="text-xs text-slate-600 line-clamp-3 mt-2 leading-relaxed font-sans">
                    {prod.metaDescription}
                  </p>
                </div>

                <!-- Deux boutons : Détails & Commander -->
                <div class="mt-5 pt-3.5 border-t border-brand-100 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5">
                  <a
                    href={`/boutique/${cat.category}/${prod.slug}`}
                    class="text-xs py-2 px-3 text-center font-bold text-brand-900 hover:text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 rounded-full transition-colors order-2 sm:order-1"
                  >
                    Détails →
                  </a>
                  <a
                    href={whatsappOrderUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-whatsapp text-xs py-2 px-3.5 shadow-xs font-bold inline-flex items-center justify-center gap-1.5 order-1 sm:order-2"
                  >
                    <span>Commander</span>
                    <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                    </svg>
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- Rich Semantic HTML Content (Partie 2) -->
    {afterProducts && <div class="prose-aziman" set:html={afterProducts} />}

  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
