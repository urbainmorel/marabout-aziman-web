---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroHeader from '../../../components/HeroHeader.astro';
import ConsultationSidebar from '../../../components/ConsultationSidebar.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import TrustBadges from '../../../components/TrustBadges.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { boutiqueCategories, type ShopCategory } from '../../../data/shopData';
import { siteSettings } from '../../../data/siteData';

export async function getStaticPaths() {
  return boutiqueCategories.map((cat) => ({
    params: { category: cat.category },
    props: { cat },
  }));
}

interface Props {
  cat: ShopCategory;
}

const { cat } = Astro.props;

// Category Schema
const categorySchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": cat.title,
  "description": cat.metaDescription,
  "url": `https://marabout-aziman.fr/boutique/${cat.category}/`
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://marabout-aziman.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Boutique",
      "item": "https://marabout-aziman.fr/boutique/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": cat.name,
      "item": `https://marabout-aziman.fr/boutique/${cat.category}/`
    }
  ]
};
---

<BaseLayout
  title={cat.metaTitle}
  description={cat.metaDescription}
  keywords={cat.keywords}
  image={cat.image}
  schema={[categorySchema, breadcrumbSchema]}
>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Rayon Boutique Ésotérique"
    title={cat.title}
    description={cat.metaDescription}
    breadcrumbs={[
      { label: 'Boutique', href: '/boutique' },
      { label: cat.name, href: `/boutique/${cat.category}` },
    ]}
  />

  <TrustBadges />

  <!-- CONTENT & PRODUCTS -->
  <article class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      
      <div class="lg:col-span-8 space-y-8">
        
        <!-- Table of Contents -->
        <TableOfContents />

        <!-- Rich Semantic HTML Content -->
        <div class="prose-aziman" set:html={cat.contentHtml} />

        {cat.products && cat.products.length > 0 && (
          <div class="border-t border-gold-200/80 pt-10 space-y-6">
            <div class="space-y-1">
              <span class="text-xs font-bold text-gold-700 uppercase tracking-wider">Catalogue Consacré</span>
              <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
                Articles Disponibles dans ce Rayon
              </h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              {cat.products.map((prod) => (
                <div class="card-luxury p-6 bg-white border border-gray-100 hover:border-gold-400/80 transition-all flex flex-col justify-between group shadow-xs">
                  <div>
                    <div class="flex items-center justify-between mb-3">
                      <span class="text-xs font-serif font-bold text-gold-900 bg-gold-50 border border-gold-300/70 px-3 py-0.5 rounded-full">
                        {prod.price}
                      </span>
                      <span class="text-[11px] text-emerald-700 bg-emerald-50 font-semibold px-2 py-0.5 rounded-full">En stock (48h)</span>
                    </div>
                    <h3 class="font-serif font-bold text-base sm:text-lg text-brand-dark group-hover:text-brand-900 transition-colors">
                      <a href={`/boutique/${cat.category}/${prod.slug}`}>
                        {prod.title}
                      </a>
                    </h3>
                    <p class="text-xs text-gray-600 line-clamp-3 mt-2 leading-relaxed font-sans">
                      {prod.metaDescription}
                    </p>
                  </div>

                  <div class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between gap-2">
                    <a
                      href={`/boutique/${cat.category}/${prod.slug}`}
                      class="text-xs font-bold text-brand-900 hover:text-gold-700 uppercase tracking-wider"
                    >
                      Détails →
                    </a>
                    <a
                      href={`https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(`Bonjour Maître Aziman, je souhaite commander : ${prod.title}`)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-whatsapp text-xs py-2 px-3.5 shadow-xs font-bold"
                    >
                      Commander
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- Reusable Consultation / Order Sidebar -->
      <div class="lg:col-span-4">
        <ConsultationSidebar
          title={`Rayon : ${cat.name}`}
          subtitle="Commande & Conseil d'Utilisation"
          contextText={`Pour commander ou demander conseil sur l'activation et l'utilisation des produits du rayon ${cat.name}, contactez directement Maître Aziman.`}
          actionText="Commander sur WhatsApp"
          customWhatsappMsg={`Bonjour Maître Aziman, je souhaite des renseignements sur le rayon : ${cat.name}`}
        />
      </div>

    </div>
  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
