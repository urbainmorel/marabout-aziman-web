---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroHeader from '../../../components/HeroHeader.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import TrustBadges from '../../../components/TrustBadges.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { boutiqueCategories, type ShopCategory, type ShopProduct } from '../../../data/shopData';
import { siteSettings } from '../../../data/siteData';

export async function getStaticPaths() {
  const paths: any[] = [];

  boutiqueCategories.forEach((cat) => {
    if (cat.products) {
      cat.products.forEach((prod) => {
        paths.push({
          params: { category: cat.category, slug: prod.slug },
          props: { cat, prod },
        });
      });
    }
  });

  return paths;
}

interface Props {
  cat: ShopCategory;
  prod: ShopProduct;
}

const { cat, prod } = Astro.props;

const productUrl = `https://www.marabout-aziman.fr/boutique/${cat.category}/${prod.slug}/`;
const whatsappOrderUrl = `https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(`Bonjour Maître Aziman, je souhaite commander l'article consacré : ${prod.title} (${prod.price})\nLien : ${productUrl}`)}`;

// Product Schema
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": prod.title,
  "description": prod.metaDescription,
  "image": prod.image || cat.image,
  "offers": {
    "@type": "Offer",
    "price": prod.price.replace(/[^0-9]/g, '') || "50",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": "Cabinet Maître Aziman"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://www.marabout-aziman.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Boutique",
      "item": "https://www.marabout-aziman.fr/boutique/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": cat.name,
      "item": `https://www.marabout-aziman.fr/boutique/${cat.category}/`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": prod.title,
      "item": `https://www.marabout-aziman.fr/boutique/${cat.category}/${prod.slug}/`
    }
  ]
};
---

<BaseLayout
  title={prod.metaTitle}
  description={prod.metaDescription}
  keywords={prod.keywords}
  image={prod.image || cat.image}
  schema={[productSchema, breadcrumbSchema]}
>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge={`Rayon : ${cat.name}`}
    title={prod.title}
    description={prod.metaDescription}
    breadcrumbs={[
      { label: 'Boutique', href: '/boutique' },
      { label: cat.name, href: `/boutique/${cat.category}` },
      { label: prod.title, href: `/boutique/${cat.category}/${prod.slug}` },
    ]}
  
    image={prod ? prod.image : "https://images.unsplash.com/photo-1606760227091-3dd870d97f1d?q=80&w=1000&auto=format&fit=crop"}
    primaryCta={{
      label: 'Commander',
      href: whatsappOrderUrl,
      icon: 'whatsapp',
      iconPosition: 'right'
    }}
  />

  <TrustBadges />

  <!-- CONTENT -->
  <article class="py-12 sm:py-16 md:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <!-- Product Image Showcase -->
    <div class="relative rounded-3xl overflow-hidden shadow-xl max-h-96 bg-brand-950 border border-brand-800 mb-8">
      <img
        src={prod.image}
        alt={`Article ésotérique consacré : ${prod.title}`}
        class="w-full h-full object-cover"
      />
      <div class="absolute top-4 right-4 bg-brand-950/90 backdrop-blur-md text-white font-serif font-bold text-sm sm:text-base px-4 py-1.5 rounded-full border border-brand-700 shadow-lg">
        {prod.price}
      </div>
    </div>

    <!-- Quick Action Commander Bar Under Image -->
    <div class="p-6 sm:p-7 bg-surface rounded-2xl border border-brand-200/80 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-wider block">Commande directe & consécration personnalisée</span>
        <p class="text-xs sm:text-sm text-slate-600 font-sans mt-0.5">Article magnétisé selon vos coordonnées astrales • Expédition 24/48h France</p>
      </div>
      <a
        href={whatsappOrderUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 px-8 py-3.5 bg-emerald-600 hover:bg-emerald-500 text-white font-sans font-bold text-sm sm:text-base rounded-full shadow-lg shadow-emerald-900/20 transition-all duration-300 transform hover:-translate-y-0.5 whitespace-nowrap flex-shrink-0"
      >
        <span>Commander</span>
        <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </a>
    </div>

    <!-- Table of Contents -->
    <TableOfContents />

    <!-- Rich Semantic HTML Content -->
    <div class="prose-aziman" set:html={prod.contentHtml} />

    <!-- Bottom Action Commander Bar -->
    <div class="mt-10 p-6 sm:p-8 bg-surface rounded-2xl border border-brand-200/80 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-wider block">Valider votre commande</span>
        <h3 class="font-serif font-bold text-lg sm:text-xl text-brand-dark mt-0.5">{prod.title} ({prod.price})</h3>
        <p class="text-xs text-slate-500 font-sans mt-1">Colis anonyme & discret • Notice d'utilisation et rituels d'activation inclus</p>
      </div>
      <a
        href={whatsappOrderUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-emerald-600 hover:bg-emerald-500 text-white font-sans font-bold text-sm sm:text-base rounded-full shadow-lg shadow-emerald-900/20 transition-all duration-300 transform hover:-translate-y-0.5 whitespace-nowrap flex-shrink-0"
      >
        <span>Commander</span>
        <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </a>
    </div>

  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
