---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroHeader from '../../../components/HeroHeader.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import TrustBadges from '../../../components/TrustBadges.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { boutiqueCategories, type ShopCategory, type ShopProduct } from '../../../data/shopData';
import { siteSettings } from '../../../data/siteData';

export async function getStaticPaths() {
  const paths: any[] = [];

  boutiqueCategories.forEach((cat) => {
    if (cat.products) {
      cat.products.forEach((prod) => {
        paths.push({
          params: { category: cat.category, slug: prod.slug },
          props: { cat, prod },
        });
      });
    }
  });

  return paths;
}

interface Props {
  cat: ShopCategory;
  prod: ShopProduct;
}

const { cat, prod } = Astro.props;

const whatsappOrderUrl = `https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(`Bonjour Maître Aziman, je souhaite commander l'article consacré : ${prod.title} (${prod.price})`)}`;

// Product Schema
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": prod.title,
  "description": prod.metaDescription,
  "image": prod.image || cat.image,
  "offers": {
    "@type": "Offer",
    "price": prod.price.replace(/[^0-9]/g, '') || "50",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": "Cabinet Maître Aziman"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://marabout-aziman.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Boutique",
      "item": "https://marabout-aziman.fr/boutique/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": cat.name,
      "item": `https://marabout-aziman.fr/boutique/${cat.category}/`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": prod.title,
      "item": `https://marabout-aziman.fr/boutique/${cat.category}/${prod.slug}/`
    }
  ]
};
---

<BaseLayout
  title={prod.metaTitle}
  description={prod.metaDescription}
  keywords={prod.keywords}
  image={prod.image || cat.image}
  schema={[productSchema, breadcrumbSchema]}
>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge={`Rayon : ${cat.name}`}
    title={prod.title}
    description={prod.metaDescription}
    breadcrumbs={[
      { label: 'Boutique', href: '/boutique' },
      { label: cat.name, href: `/boutique/${cat.category}` },
      { label: prod.title, href: `/boutique/${cat.category}/${prod.slug}` },
    ]}
  />

  <TrustBadges />

  <!-- CONTENT -->
  <article class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      
      <div class="lg:col-span-8 space-y-8">
        
        <!-- Product Image Showcase -->
        <div class="relative rounded-3xl overflow-hidden shadow-xl max-h-96 bg-brand-950 border border-brand-800 mb-8">
          <img
            src={prod.image}
            alt={`Article ésotérique consacré : ${prod.title}`}
            class="w-full h-full object-cover"
          />
          <div class="absolute top-4 right-4 bg-brand-950/90 backdrop-blur-md text-white font-serif font-bold text-sm sm:text-base px-4 py-1.5 rounded-full border border-brand-700 shadow-lg">
            {prod.price}
          </div>
        </div>

        <!-- Table of Contents -->
        <TableOfContents />

        <!-- Rich Semantic HTML Content -->
        <div class="prose-aziman" set:html={prod.contentHtml} />

      </div>

      <!-- Sticky Order Card with Refined Violet Styling -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="card-luxury p-6 sm:p-8 bg-brand-950 text-white shadow-2xl border border-brand-800 space-y-6 sticky top-24 relative overflow-hidden">
          <div class="absolute -top-16 -right-16 w-40 h-40 bg-brand-700/15 rounded-full blur-2xl pointer-events-none"></div>

          <div class="border-b border-brand-800 pb-5">
            <span class="text-xs text-brand-300 uppercase tracking-widest font-bold block">Support Consacré</span>
            <h3 class="font-serif font-bold text-xl sm:text-2xl text-white mt-1 leading-snug">{prod.title}</h3>
            <p class="text-2.5xl font-serif font-bold text-white mt-2">{prod.price}</p>
          </div>

          <div class="space-y-2.5 text-xs text-slate-200 font-sans">
            <p class="flex items-center gap-2.5">
              <span class="text-emerald-400 font-bold">✓</span> En stock - Expédition express
            </p>
            <p class="flex items-center gap-2.5">
              <span class="text-emerald-400 font-bold">✓</span> Colissimo 48h France Métropolitaine
            </p>
            <p class="flex items-center gap-2.5">
              <span class="text-emerald-400 font-bold">✓</span> Emballage 100% anonyme & discret
            </p>
            <p class="flex items-center gap-2.5">
              <span class="text-emerald-400 font-bold">✓</span> Rituel de consécration à votre nom inclus
            </p>
          </div>

          <div class="pt-2 space-y-2.5">
            <a
              href={whatsappOrderUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-whatsapp w-full justify-center text-xs sm:text-sm py-4 font-bold shadow-lg"
            >
              <span>WhatsApp 24/7</span>
            </a>

            <a
              href={`tel:${siteSettings.phone}`}
              class="btn-secondary w-full justify-center text-xs py-3 font-semibold text-center bg-white/10 hover:bg-white/20 text-white border-white/25"
            >
              <span>Commander par téléphone</span>
            </a>
          </div>

          <p class="text-[11px] text-slate-400 text-center pt-2 border-t border-brand-800/80 font-sans">
            Notice d'utilisation fournie. Suivi par WhatsApp disponible.
          </p>
        </div>
      </aside>

    </div>
  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
