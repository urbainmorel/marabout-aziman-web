---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/HeroHeader.astro';
import TrustBadges from '../components/TrustBadges.astro';
import CtaSection from '../components/CtaSection.astro';
import { siteSettings } from '../data/siteData';

const seoTitle = "Contact & Prise de RDV : Cabinet Marabout Aziman | Paris & France";
const seoDesc = "Contactez Maître Aziman, grand marabout en France. Téléphone, WhatsApp direct 24h/7j, adresse du cabinet à Paris et horaires de consultation.";
const seoKeywords = "contact marabout france, urgence marabout 24h, téléphone maître aziman, whatsapp marabout direct, rdv marabout paris";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": seoTitle,
  "description": seoDesc,
  "mainEntity": {
    "@type": "ProfessionalService",
    "name": "Cabinet Maître Aziman",
    "telephone": siteSettings.phone,
    "email": siteSettings.email,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Paris",
      "addressRegion": "Île-de-France",
      "addressCountry": "FR"
    }
  }
};
---

<BaseLayout title={seoTitle} description={seoDesc} keywords={seoKeywords} schema={contactSchema}>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Secrétariat & Permanence 24h/7j"
    title="Contact Direct du Cabinet Aziman en France"
    description="Vous souhaitez bénéficier d'un rituel sérieux, poser une question urgente ou réserver une consultation privée avec le Maître Aziman ? Retrouvez toutes nos coordonnées ci-dessous."
    breadcrumbs={[{ label: 'Contact', href: '/contact' }]}
    highlightWord="Maître Aziman"
    image="https://images.unsplash.com/photo-1600180758890-6b94519a8ba6?q=80&w=1000&auto=format&fit=crop"
    primaryCta={{ label: 'WhatsApp 24/7', href: siteSettings.whatsappLink, icon: 'whatsapp' }}
    secondaryCta={{ label: 'Appeler le Cabinet', href: `tel:${siteSettings.phone}` }}
  />

  <TrustBadges />

  <!-- 3 CARTES DE CONTACT ÉPURÉES ET CLAIRES -->
  <section class="py-14 sm:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mx-auto text-center space-y-3 mb-12">
      <h2 class="font-serif font-bold text-2xl sm:text-3xl md:text-4xl text-brand-dark">
        Nos Coordonnées & Accès
      </h2>
      <div class="w-12 h-1 bg-brand-900 mx-auto rounded-full"></div>
      <p class="text-xs sm:text-sm text-slate-600 font-sans">
        Échangez en toute discrétion avec Maître Aziman par téléphone, WhatsApp ou rendez-vous en cabinet.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      
      <!-- Carte 1: Téléphone, WhatsApp & Email -->
      <div class="card-luxury p-8 bg-white border border-brand-200/80 shadow-md hover:shadow-xl transition-all duration-300 rounded-2xl flex flex-col items-center text-center space-y-6">
        <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl shadow-sm border border-emerald-200/60">
          📞
        </div>
        
        <div class="space-y-1.5">
          <h3 class="font-serif font-bold text-xl text-brand-dark">Téléphone & WhatsApp</h3>
          <p class="text-xs text-slate-500 font-sans">Ligne directe & secrétariat 24/7</p>
        </div>

        <div class="w-full space-y-4 pt-4 text-xs sm:text-sm font-sans border-t border-slate-100">
          <div>
            <span class="block text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Téléphone Direct :</span>
            <a href={`tel:${siteSettings.phone}`} class="font-bold text-brand-dark hover:text-emerald-600 transition-colors text-base mt-0.5 inline-block">
              {siteSettings.phoneDisplay}
            </a>
          </div>

          <div>
            <span class="block text-[11px] text-slate-400 uppercase tracking-wider font-semibold">WhatsApp Direct 24/7 :</span>
            <a href={siteSettings.whatsappLink} target="_blank" rel="noopener noreferrer" class="font-bold text-emerald-600 hover:text-emerald-700 transition-colors text-base mt-0.5 inline-block">
              {siteSettings.whatsappDisplay}
            </a>
          </div>

          <div>
            <span class="block text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Email :</span>
            <a href={`mailto:${siteSettings.email}`} class="font-medium text-slate-700 hover:text-brand-dark transition-colors mt-0.5 inline-block">
              {siteSettings.email}
            </a>
          </div>
        </div>
      </div>

      <!-- Carte 2: Adresse du Cabinet -->
      <div class="card-luxury p-8 bg-white border border-brand-200/80 shadow-md hover:shadow-xl transition-all duration-300 rounded-2xl flex flex-col items-center text-center space-y-6">
        <div class="w-14 h-14 rounded-2xl bg-brand-50 text-brand-900 flex items-center justify-center text-2xl shadow-sm border border-brand-200/60">
          📍
        </div>

        <div class="space-y-1.5">
          <h3 class="font-serif font-bold text-xl text-brand-dark">Adresse du Cabinet</h3>
          <p class="text-xs text-slate-500 font-sans">Paris & Région Île-de-France</p>
        </div>

        <div class="w-full space-y-4 pt-4 text-xs sm:text-sm font-sans border-t border-slate-100">
          <div>
            <span class="block text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Localisation :</span>
            <p class="font-bold text-slate-800 text-sm mt-0.5">
              {siteSettings.address}
            </p>
          </div>

          <div>
            <span class="block text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Accès & Discours :</span>
            <p class="text-slate-600 text-xs leading-relaxed mt-0.5">
              {siteSettings.addressDetails}
            </p>
          </div>
        </div>
      </div>

      <!-- Carte 3: Horaires & Disponibilité -->
      <div class="card-luxury p-8 bg-white border border-brand-200/80 shadow-md hover:shadow-xl transition-all duration-300 rounded-2xl flex flex-col items-center text-center space-y-6">
        <div class="w-14 h-14 rounded-2xl bg-indigo-50 text-indigo-700 flex items-center justify-center text-2xl shadow-sm border border-indigo-200/60">
          🕒
        </div>

        <div class="space-y-1.5">
          <h3 class="font-serif font-bold text-xl text-brand-dark">Horaires & Disponibilité</h3>
          <p class="text-xs text-slate-500 font-sans">Ouvert 7j/7 sans interruption</p>
        </div>

        <div class="w-full space-y-4 pt-4 text-xs sm:text-sm font-sans border-t border-slate-100">
          <div>
            <span class="block text-[11px] text-slate-400 uppercase tracking-wider font-semibold">WhatsApp & Urgences :</span>
            <span class="font-bold text-emerald-600 block text-base mt-0.5">24h/24 & 7j/7</span>
          </div>

          <div>
            <span class="block text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Consultations en Cabinet (Paris) :</span>
            <span class="font-medium text-slate-800 block text-xs mt-0.5">Lundi au Dimanche : 8h00 - 21h00 (sur RDV)</span>
          </div>
        </div>
      </div>

    </div>

  </section>

  <CtaSection />

</BaseLayout>
