---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteSettings } from '../data/siteData';

const seoTitle = "Contacter un Marabout en France : WhatsApp & RDV | Aziman";
const seoDesc = "Besoin de contacter un marabout en France sans attendre ? Joignez Maître Aziman par téléphone direct ou WhatsApp 24h/7j. Cabinet à Paris.";
const seoKeywords = "contacter marabout france, telephone marabout paris, whatsapp marabout gratuit france, rdv marabout urgence, marabout direct france";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": seoTitle,
  "description": seoDesc,
  "mainEntity": {
    "@type": "ProfessionalService",
    "name": "Cabinet Maître Aziman",
    "telephone": siteSettings.phone,
    "email": siteSettings.email,
    "url": "https://marabout-aziman.fr/contact/",
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": siteSettings.phone,
      "contactType": "customer support",
      "availableLanguage": ["French", "Fon", "Yoruba"]
    }
  }
};
---

<BaseLayout title={seoTitle} description={seoDesc} keywords={seoKeywords} schema={contactSchema}>
  
  <!-- HERO HEADER -->
  <section class="bg-gradient-to-b from-brand-900 to-brand-800 text-white py-12 md:py-16 border-b border-gold-400/20">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{ label: 'Contact', href: '/contact' }]} />
      
      <div class="mt-6 max-w-3xl space-y-4">
        <div class="inline-block px-3 py-1 rounded-md bg-gold-400/20 text-gold-300 text-xs font-semibold uppercase tracking-wider">
          Accès, Téléphone & Urgences 24h/7j
        </div>
        <h1 class="font-serif font-bold text-3xl sm:text-4xl md:text-5xl text-white leading-tight">
          Contacter un Marabout en France : Téléphone, WhatsApp et Accès au Cabinet Aziman 24h/7j
        </h1>
        <p class="text-sm sm:text-base text-gray-200 leading-relaxed font-sans">
          Vous traversez une crise sentimentale urgente, vous risquez une expulsion ou vous avez besoin d'un diagnostic divinatoire immédiat ? Décider de <strong>contacter un marabout en France</strong> réputé comme Maître Aziman constitue la démarche la plus rapide pour trouver une issue à vos tourments.
        </p>
      </div>
    </div>
  </section>

  <!-- CONTENT & FORM -->
  <section class="py-12 md:py-16 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Direct Contact Details -->
      <div class="lg:col-span-5 space-y-6">
        
        <div class="card-luxury p-6 bg-brand-900 text-white space-y-6 shadow-xl">
          <h2 class="font-serif font-bold text-2xl text-white border-b border-white/10 pb-3">
            📞 Coordonnées Directes 24h/7j
          </h2>

          <div class="space-y-4 text-sm">
            <div class="flex items-start gap-3">
              <span class="text-xl">📱</span>
              <div>
                <strong class="text-gold-300 block">Téléphone direct (France) :</strong>
                <a href={`tel:${siteSettings.phone}`} class="text-white hover:text-gold-300 font-bold text-base">
                  {siteSettings.phoneDisplay}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="text-xl">💬</span>
              <div>
                <strong class="text-gold-300 block">WhatsApp direct (24h/7j) :</strong>
                <a href={siteSettings.whatsappLink} target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:underline font-bold">
                  {siteSettings.whatsappDisplay}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="text-xl">📧</span>
              <div>
                <strong class="text-gold-300 block">Courrier électronique :</strong>
                <a href={`mailto:${siteSettings.email}`} class="text-gray-300 hover:text-white">
                  {siteSettings.email}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="text-xl">📍</span>
              <div>
                <strong class="text-gold-300 block">Cabinet Principal :</strong>
                <p class="text-gray-300 text-xs mt-0.5">
                  Paris & Région Île-de-France (Adresse exacte transmise par SMS/WhatsApp lors de la confirmation).
                </p>
                <p class="text-gray-400 text-[11px] mt-1">
                  Métro/RER à 3 min. Parking sécurisé.
                </p>
              </div>
            </div>
          </div>

          <div class="pt-2 border-t border-white/10">
            <a
              href={siteSettings.whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-whatsapp w-full justify-center text-xs py-3.5 font-bold shadow-lg"
            >
              <span>Échanger en direct sur WhatsApp</span>
            </a>
          </div>
        </div>

        <!-- Working Hours info -->
        <div class="card-luxury p-6 bg-surface border border-gray-200 text-xs space-y-2">
          <h3 class="font-bold text-brand-dark text-sm">⏰ Disponibilité & Déplacements</h3>
          <p class="text-gray-600">
            Le secrétariat et les lignes d'urgence restent ouverts 24h/24 et 7j/7 pour les crises sentimentales et blocages graves.
          </p>
          <p class="text-gray-600">
            Consultations physiques au cabinet de Paris de 8h00 à 21h00 du lundi au dimanche sur rendez-vous.
          </p>
        </div>

      </div>

      <!-- Contact Form -->
      <div class="lg:col-span-7">
        <div class="card-luxury p-6 sm:p-8 bg-white border border-gray-200/80 shadow-md">
          <h2 class="font-serif font-bold text-2xl text-brand-dark mb-2">
            📝 Formulaire de Contact Confidentiel Express
          </h2>
          <p class="text-xs text-gray-600 mb-6">
            Remplissez ce formulaire discret pour recevoir une réponse personnalisée du Maître Aziman sous 30 minutes :
          </p>

          <form class="space-y-4" id="consultation-form">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">
                  Nom & Prénom / Pseudonyme <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  required
                  placeholder="Ex : Sylvie M."
                  class="w-full px-3.5 py-2.5 rounded-lg border border-gray-300 text-sm focus:border-brand-900 focus:ring-1 focus:ring-brand-900 outline-none transition"
                />
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">
                  Numéro de Téléphone / WhatsApp <span class="text-red-500">*</span>
                </label>
                <input
                  type="tel"
                  required
                  placeholder="Ex : 06 12 34 56 78"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-gray-300 text-sm focus:border-brand-900 focus:ring-1 focus:ring-brand-900 outline-none transition"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">
                  Ville ou Département en France <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  required
                  placeholder="Ex : Paris 15e ou 75"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-gray-300 text-sm focus:border-brand-900 focus:ring-1 focus:ring-brand-900 outline-none transition"
                />
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">
                  Domaine de Préoccupation <span class="text-red-500">*</span>
                </label>
                <select
                  required
                  class="w-full px-3.5 py-2.5 rounded-lg border border-gray-300 text-sm focus:border-brand-900 focus:ring-1 focus:ring-brand-900 outline-none transition bg-white"
                >
                  <option value="">Sélectionnez un domaine...</option>
                  <option value="amour">Amour & Retour Affectif</option>
                  <option value="richesse">Richesse, Finance & Abondance</option>
                  <option value="commerce">Commerce & Carrière</option>
                  <option value="divination">Divination & Voyance Fâ</option>
                  <option value="protection">Protection & Désenvoûtement</option>
                  <option value="sante">Santé Traditionnelle & Fertilité</option>
                  <option value="justice">Justice, Procès & Litiges</option>
                  <option value="papiers">Titre de Séjour, Préfecture & Visas</option>
                  <option value="boutique">Achat de Produits de la Boutique</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">
                Votre Message Confidentiel <span class="text-red-500">*</span>
              </label>
              <textarea
                rows="5"
                required
                placeholder="Décrivez avec précision votre situation actuelle (dates clés, difficultés rencontrées, souhaits)..."
                class="w-full px-3.5 py-2.5 rounded-lg border border-gray-300 text-sm focus:border-brand-900 focus:ring-1 focus:ring-brand-900 outline-none transition"
              ></textarea>
            </div>

            <div class="text-[11px] text-gray-500 flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
              <span>Secret initiatique et déontologique garanti. Aucune donnée n'est transmise à des tiers.</span>
            </div>

            <button
              type="submit"
              class="btn-primary w-full justify-center text-sm py-3.5 font-bold shadow-md hover:shadow-lg"
            >
              <span>Envoyer ma demande confidentielle à Maître Aziman</span>
            </button>
          </form>

        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<script>
  const form = document.getElementById('consultation-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Votre demande a bien été envoyée au Cabinet Aziman. Maître Aziman prendra contact avec vous dans les plus brefs délais.');
    (form as HTMLFormElement).reset();
  });
</script>
