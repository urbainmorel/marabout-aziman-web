---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import { allBlogArticles, type BlogArticle } from '../../data/blogData';
import { siteSettings } from '../../data/siteData';

export async function getStaticPaths() {
  return allBlogArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: BlogArticle;
}

const { article } = Astro.props;

// Related articles from same category or fallback
const relatedArticles = allBlogArticles
  .filter((a) => a.slug !== article.slug && a.category === article.category)
  .slice(0, 3);

// Article JSON-LD Structured Data Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.title,
  "description": article.metaDescription,
  "image": article.image,
  "datePublished": article.date,
  "dateModified": article.date,
  "author": {
    "@type": "Person",
    "name": article.author.name,
    "jobTitle": article.author.role,
    "image": article.author.avatar
  },
  "publisher": {
    "@type": "Organization",
    "name": "Cabinet Maître Aziman",
    "logo": {
      "@type": "ImageObject",
      "url": "https://marabout-aziman.fr/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://marabout-aziman.fr/blog/${article.slug}/`
  }
};

// BreadcrumbList JSON-LD Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://marabout-aziman.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://marabout-aziman.fr/blog/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": article.categoryName,
      "item": `https://marabout-aziman.fr/blog/categorie/${article.category}/`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": article.title,
      "item": `https://marabout-aziman.fr/blog/${article.slug}/`
    }
  ]
};
---

<BaseLayout
  title={article.metaTitle}
  description={article.metaDescription}
  keywords={article.keywords}
  image={article.image}
  schema={[articleSchema, breadcrumbSchema]}
  article={{
    publishedTime: article.date,
    author: article.author.name,
    section: article.categoryName
  }}
>
  
  <!-- HERO HEADER -->
  <section class="bg-gradient-to-b from-brand-900 to-brand-800 text-white py-12 md:py-16 border-b border-gold-400/20">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs
        items={[
          { label: 'Blog', href: '/blog' },
          { label: article.categoryName, href: `/blog/categorie/${article.category}` },
          { label: article.title, href: `/blog/${article.slug}` },
        ]}
      />
      
      <div class="mt-6 max-w-3xl space-y-4">
        <div class="flex items-center gap-3 text-xs text-gold-300">
          <span class="px-2.5 py-0.5 rounded bg-gold-400/20 uppercase font-semibold">
            {article.categoryName}
          </span>
          <span>•</span>
          <span>{article.readTime}</span>
        </div>

        <h1 class="font-serif font-bold text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-white leading-tight">
          {article.title}
        </h1>

        <p class="text-sm sm:text-base text-gray-200 leading-relaxed font-sans">
          {article.metaDescription}
        </p>

        <div class="pt-2 flex items-center gap-3">
          <img
            src={article.author.avatar}
            alt={`Portrait de ${article.author.name} - ${article.author.role}`}
            class="w-10 h-10 rounded-full object-cover border border-gold-400"
          />
          <div>
            <p class="text-xs font-semibold text-white">{article.author.name}</p>
            <p class="text-[11px] text-gold-300">{article.author.role}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ARTICLE BODY & SIDEBAR -->
  <article class="py-12 md:py-16 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Main Content -->
      <div class="lg:col-span-8 space-y-8 prose-aziman">
        
        <!-- Featured Image -->
        <div class="rounded-2xl overflow-hidden shadow-lg max-h-96 bg-gray-100 mb-8">
          <img
            src={article.image}
            alt={`Illustration consacrée : ${article.title}`}
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Article Body Text -->
        <div class="text-sm sm:text-base text-gray-700 leading-relaxed space-y-4 whitespace-pre-line">
          {article.content}
        </div>

        <!-- Author bio box -->
        <div class="mt-12 p-6 rounded-2xl bg-surface border border-gold-300/40 flex items-start gap-4">
          <img
            src={article.author.avatar}
            alt={article.author.name}
            class="w-16 h-16 rounded-full object-cover border-2 border-gold-400 flex-shrink-0"
          />
          <div class="space-y-1">
            <h3 class="font-serif font-bold text-base text-brand-dark">{article.author.name}</h3>
            <p class="text-xs text-gold-700 font-medium">{article.author.role}</p>
            <p class="text-xs text-gray-600 leading-relaxed pt-1">
              Initié aux secrets ancestraux du Fâ et du Vodun depuis plus de 25 ans. Reçoit sur rendez-vous à Paris et réalise des rituels à distance partout en France.
            </p>
          </div>
        </div>

        <!-- Related Articles -->
        {relatedArticles.length > 0 && (
          <div class="mt-12 pt-8 border-t border-gray-200 space-y-6">
            <h3 class="font-serif font-bold text-xl text-brand-dark">
              Articles Similaires dans cette Thématique
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {relatedArticles.map((rel) => (
                <div class="card-luxury p-4 bg-white border border-gray-100 hover:border-gold-300 transition-all flex flex-col justify-between">
                  <div>
                    <span class="text-[10px] uppercase tracking-wider text-gold-600 font-semibold">{rel.categoryName}</span>
                    <h4 class="font-serif font-bold text-sm text-brand-dark mt-1 line-clamp-2">
                      <a href={`/blog/${rel.slug}`} class="hover:text-brand-800">{rel.title}</a>
                    </h4>
                  </div>
                  <a href={`/blog/${rel.slug}`} class="text-xs font-semibold text-brand-900 mt-3 hover:text-gold-600">
                    Lire la suite →
                  </a>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- Sticky Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        
        <div class="card-luxury p-6 bg-brand-900 text-white shadow-xl space-y-5 sticky top-24">
          <div class="flex items-center gap-3 border-b border-white/10 pb-4">
            <span class="text-3xl">🔮</span>
            <div>
              <h3 class="font-serif font-bold text-lg text-white">Besoin d'aide ?</h3>
              <p class="text-xs text-gold-300">Consultation confidentielle 7j/7</p>
            </div>
          </div>

          <p class="text-xs text-gray-300 leading-relaxed">
            Vous traversez une épreuve sentimentale, financière ou un blocage mystique ? Échangez directement avec Maître Aziman.
          </p>

          <div class="space-y-2 text-xs text-gray-200">
            <p><strong>Téléphone :</strong> {siteSettings.phoneDisplay}</p>
            <p><strong>WhatsApp :</strong> {siteSettings.whatsappDisplay}</p>
            <p><strong>Disponibilité :</strong> 24h/24 et 7j/7</p>
          </div>

          <div class="pt-2 space-y-2">
            <a
              href={`https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(`Bonjour Maître Aziman, j'ai lu votre article "${article.title}" et je souhaite une consultation.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-whatsapp w-full justify-center text-xs py-3 font-semibold"
            >
              <span>Échanger sur WhatsApp</span>
            </a>

            <a
              href="/contact"
              class="btn-secondary w-full justify-center text-xs py-3 font-semibold text-center"
            >
              <span>Prendre RDV en Cabinet</span>
            </a>
          </div>
        </div>

      </aside>

    </div>
  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
