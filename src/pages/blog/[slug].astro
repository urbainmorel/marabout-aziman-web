---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import ConsultationSidebar from '../../components/ConsultationSidebar.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import CtaSection from '../../components/CtaSection.astro';
import { allBlogArticles, type BlogArticle } from '../../data/blogData';
import { siteSettings } from '../../data/siteData';

export async function getStaticPaths() {
  return allBlogArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: BlogArticle;
}

const { article } = Astro.props;

// Related articles from same category or fallback
const relatedArticles = allBlogArticles
  .filter((a) => a.slug !== article.slug && a.category === article.category)
  .slice(0, 3);

// Article JSON-LD Structured Data Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.title,
  "description": article.metaDescription,
  "image": article.image,
  "datePublished": article.date,
  "dateModified": article.date,
  "author": {
    "@type": "Person",
    "name": article.author.name,
    "jobTitle": article.author.role,
    "image": article.author.avatar
  },
  "publisher": {
    "@type": "Organization",
    "name": "Cabinet Maître Aziman",
    "logo": {
      "@type": "ImageObject",
      "url": "https://marabout-aziman.fr/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://marabout-aziman.fr/blog/${article.slug}/`
  }
};

// BreadcrumbList JSON-LD Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://marabout-aziman.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://marabout-aziman.fr/blog/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": article.categoryName,
      "item": `https://marabout-aziman.fr/blog/categorie/${article.category}/`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": article.title,
      "item": `https://marabout-aziman.fr/blog/${article.slug}/`
    }
  ]
};
---

<BaseLayout
  title={article.metaTitle}
  description={article.metaDescription}
  keywords={article.keywords}
  image={article.image}
  schema={[articleSchema, breadcrumbSchema]}
  article={{
    publishedTime: article.date,
    author: article.author.name,
    section: article.categoryName
  }}
>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge={article.categoryName}
    title={article.title}
    description={article.metaDescription}
    breadcrumbs={[
      { label: 'Blog & Guides', href: '/blog' },
      { label: article.categoryName, href: `/blog/categorie/${article.category}` },
      { label: article.title, href: `/blog/${article.slug}` },
    ]}
    metaInfo={{
      category: article.categoryName,
      readTime: article.readTime,
      date: article.date,
    }}
    author={article.author}
  />

  <TrustBadges />

  <!-- ARTICLE BODY & SIDEBAR -->
  <article class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      
      <!-- Main Content -->
      <div class="lg:col-span-8 space-y-8">
        
        <!-- Featured Image with luxury frame -->
        <div class="rounded-3xl overflow-hidden shadow-xl max-h-96 bg-brand-950 border border-gold-400/20 mb-8">
          <img
            src={article.image}
            alt={`Illustration consacrée : ${article.title}`}
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Interactive Table of Contents -->
        <TableOfContents />

        <!-- Rich Semantic HTML Content -->
        <div class="prose-aziman" set:html={article.contentHtml} />

        <!-- Author bio box -->
        <div class="mt-14 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-gold-50/80 to-amber-50/30 border border-gold-300/60 shadow-xs flex flex-col sm:flex-row items-center sm:items-start gap-5 text-center sm:text-left">
          <img
            src={article.author.avatar}
            alt={article.author.name}
            class="w-20 h-20 rounded-2xl object-cover border-2 border-gold-400 flex-shrink-0 shadow-md"
          />
          <div class="space-y-1.5">
            <span class="text-[11px] uppercase tracking-wider font-bold text-gold-700">Auteur & Praticien Spirituel</span>
            <h3 class="font-serif font-bold text-xl text-brand-dark">{article.author.name}</h3>
            <p class="text-xs text-gold-800 font-semibold">{article.author.role}</p>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed pt-1 font-sans">
              Initié aux secrets ancestraux du Fâ et du Vodun depuis plus de 25 ans. Reçoit sur rendez-vous à son cabinet en Île-de-France et réalise des rituels à distance avec suivi personnalisé partout en France.
            </p>
          </div>
        </div>

        <!-- Related Articles -->
        {relatedArticles.length > 0 && (
          <div class="mt-14 pt-10 border-t border-gray-200 space-y-6">
            <div class="space-y-1">
              <span class="text-xs font-bold text-gold-700 uppercase tracking-wider">Lectures Recommandées</span>
              <h3 class="font-serif font-bold text-2xl text-brand-dark">
                Articles Similaires dans cette Thématique
              </h3>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              {relatedArticles.map((rel) => (
                <div class="card-luxury p-5 bg-white border border-gray-100 hover:border-gold-400/80 transition-all flex flex-col justify-between shadow-xs">
                  <div>
                    <span class="text-[10px] uppercase tracking-wider text-gold-700 font-bold bg-gold-50 px-2 py-0.5 rounded-full border border-gold-200/60 inline-block mb-2">
                      {rel.categoryName}
                    </span>
                    <h4 class="font-serif font-bold text-base text-brand-dark mt-1 line-clamp-2">
                      <a href={`/blog/${rel.slug}`} class="hover:text-brand-900">{rel.title}</a>
                    </h4>
                  </div>
                  <a href={`/blog/${rel.slug}`} class="text-xs font-bold text-brand-900 mt-4 pt-3 border-t border-gray-100 hover:text-gold-700 flex items-center justify-between uppercase tracking-wider">
                    <span>Lire l'article</span>
                    <span>→</span>
                  </a>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- Reusable Luxury Consultation Sidebar -->
      <div class="lg:col-span-4">
        <ConsultationSidebar
          title="Besoin d'une Consultation ?"
          subtitle="Cabinet Paris & Urgences 24h/7j"
          contextText={`Vous traversez une situation complexe abordée dans cet article ? Contactez Maître Aziman pour une voyance et un rituel sur mesure.`}
          actionText="Échanger sur WhatsApp"
          customWhatsappMsg={`Bonjour Maître Aziman, j'ai lu votre article "${article.title}" et je souhaite une consultation.`}
        />
      </div>

    </div>
  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
