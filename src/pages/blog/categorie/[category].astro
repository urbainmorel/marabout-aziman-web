---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroHeader from '../../../components/HeroHeader.astro';
import TrustBadges from '../../../components/TrustBadges.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { allBlogArticles, blogCategories, type BlogCategory } from '../../../data/blogData';

export async function getStaticPaths() {
  return blogCategories.map((category) => {
    const filteredArticles = allBlogArticles.filter((a) => a.category === category.slug);
    return {
      params: { category: category.slug },
      props: { category, articles: filteredArticles },
    };
  });
}

interface Props {
  category: BlogCategory;
  articles: typeof allBlogArticles;
}

const { category, articles } = Astro.props;

const shortCategoryNames: Record<string, string> = {
  'amour-relations': 'Amour',
  'richesse-prosperite': 'Richesse',
  'protection-desenvoutement': 'Protection',
  'sante-plantes': 'Santé',
  'demarches-justice-france': 'Justice',
  'guides-produits': 'Guides',
};

const seoTitle = `${category.name} : Rituels & Guides | Cabinet Aziman`;
const seoDesc = `Découvrez tous les articles et secrets ésotériques de Maître Aziman dans la catégorie ${category.name}. Rituels, conseils et enseignements.`;
---

<BaseLayout title={seoTitle} description={seoDesc}>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Catégorie Thématique"
    title={category.name}
    description={`${articles.length} article${articles.length > 1 ? 's' : ''} disponible${articles.length > 1 ? 's' : ''} dans cette thématique ésotérique.`}
    breadcrumbs={[
      { label: 'Blog & Guides', href: '/blog' },
      { label: category.name, href: `/blog/categorie/${category.slug}` },
    ]}
  />

  <TrustBadges />

  <!-- CATEGORY PILLS -->
  <section class="border-b border-brand-200 bg-surface/95 backdrop-blur-md py-3.5 sticky top-16 md:top-20 z-30 shadow-xs">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 overflow-x-auto no-scrollbar py-0.5">
        <a
          href="/blog"
          class="px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap bg-white text-slate-700 hover:text-brand-900 border border-brand-200 transition-colors"
        >
          Tous ({allBlogArticles.length})
        </a>
        {blogCategories.map((cat) => (
          <a
            href={`/blog/categorie/${cat.slug}`}
            class={`px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-colors ${
              cat.slug === category.slug
                ? 'bg-brand-900 text-white font-bold shadow-sm border border-brand-700'
                : 'bg-white text-slate-700 hover:text-brand-900 hover:bg-brand-50 border border-brand-200'
            }`}
          >
            {shortCategoryNames[cat.slug] || cat.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- POSTS GRID -->
  <section class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((post) => (
        <article class="card-luxury overflow-hidden flex flex-col justify-between group hover:border-brand-500 transition-all duration-200 bg-white shadow-xs">
          <div>
            <div class="relative h-52 overflow-hidden bg-brand-950">
              <img
                src={post.image}
                alt={post.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-3 left-3 bg-brand-950/90 backdrop-blur-md text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full border border-brand-700">
                {post.categoryName}
              </div>
            </div>

            <div class="p-6 space-y-2.5">
              <div class="text-[11px] text-slate-400 font-medium font-sans">
                {post.readTime}
              </div>
              <h3 class="font-serif font-bold text-lg text-brand-dark group-hover:text-brand-900 transition-colors leading-snug line-clamp-2">
                <a href={`/blog/${post.slug}`}>
                  {post.title}
                </a>
              </h3>
              <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed font-sans">
                {post.metaDescription}
              </p>
            </div>
          </div>

          <div class="p-6 pt-0 mt-auto">
            <a
              href={`/blog/${post.slug}`}
              class="pt-4 border-t border-brand-100 w-full inline-flex items-center justify-between text-xs font-bold text-brand-900 hover:text-brand-700 uppercase tracking-wider transition-colors"
            >
              <span>Lire l'article</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
