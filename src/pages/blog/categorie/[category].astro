---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { allBlogArticles, blogCategories, type BlogCategory } from '../../../data/blogData';

export async function getStaticPaths() {
  return blogCategories.map((category) => {
    const filteredArticles = allBlogArticles.filter((a) => a.category === category.slug);
    return {
      params: { category: category.slug },
      props: { category, articles: filteredArticles },
    };
  });
}

interface Props {
  category: BlogCategory;
  articles: typeof allBlogArticles;
}

const { category, articles } = Astro.props;

const seoTitle = `${category.name} : Rituels & Guides | Cabinet Aziman`;
const seoDesc = `Découvrez tous les articles et secrets ésotériques de Maître Aziman dans la catégorie ${category.name}. Rituels, conseils et enseignements.`;
---

<BaseLayout title={seoTitle} description={seoDesc}>
  
  <!-- HERO -->
  <section class="bg-gradient-to-b from-brand-900 to-brand-800 text-white py-12 md:py-16 border-b border-gold-400/20">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs
        items={[
          { label: 'Blog', href: '/blog' },
          { label: category.name, href: `/blog/categorie/${category.slug}` },
        ]}
      />
      
      <div class="mt-6 max-w-3xl space-y-4">
        <div class="inline-block px-3 py-1 rounded-md bg-gold-400/20 text-gold-300 text-xs font-semibold uppercase tracking-wider">
          Catégorie Thématique
        </div>
        <h1 class="font-serif font-bold text-3xl sm:text-4xl md:text-5xl text-white leading-tight">
          {category.name}
        </h1>
        <p class="text-sm sm:text-base text-gray-200 leading-relaxed font-sans">
          {articles.length} article{articles.length > 1 ? 's' : ''} disponible{articles.length > 1 ? 's' : ''} dans cette thématique.
        </p>
      </div>
    </div>
  </section>

  <!-- CATEGORY PILLS -->
  <section class="border-b border-gray-200 bg-surface py-4 sticky top-16 md:top-20 z-30 shadow-xs">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
        <a
          href="/blog"
          class="px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap bg-white text-gray-700 hover:text-brand-900 border border-gray-200 transition-colors"
        >
          Tous les articles ({allBlogArticles.length})
        </a>
        {blogCategories.map((cat) => (
          <a
            href={`/blog/categorie/${cat.slug}`}
            class={`px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap transition-colors ${
              cat.slug === category.slug
                ? 'bg-brand-900 text-gold-300 font-bold shadow-sm'
                : 'bg-white text-gray-700 hover:text-brand-900 hover:bg-gray-100 border border-gray-200'
            }`}
          >
            {cat.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- POSTS GRID -->
  <section class="py-12 md:py-16 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((post) => (
        <article class="card-luxury overflow-hidden flex flex-col justify-between group hover:border-gold-300 transition-all duration-300 bg-white">
          <div>
            <div class="relative h-48 overflow-hidden bg-gray-100">
              <img
                src={post.image}
                alt={post.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>

            <div class="p-5 space-y-2">
              <div class="text-[11px] text-gray-400">
                {post.readTime}
              </div>
              <h3 class="font-serif font-bold text-base text-brand-dark group-hover:text-brand-800 transition-colors leading-snug line-clamp-2">
                <a href={`/blog/${post.slug}`}>
                  {post.title}
                </a>
              </h3>
              <p class="text-xs text-gray-600 line-clamp-3 leading-relaxed">
                {post.metaDescription}
              </p>
            </div>
          </div>

          <div class="p-5 pt-0 mt-auto">
            <a
              href={`/blog/${post.slug}`}
              class="pt-3 border-t border-gray-100 w-full inline-flex items-center justify-between text-xs font-semibold text-brand-900 hover:text-gold-600 transition-colors"
            >
              <span>Lire la suite</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
