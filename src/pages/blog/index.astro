---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import CtaSection from '../../components/CtaSection.astro';
import { allBlogArticles, blogCategories } from '../../data/blogData';

const seoTitle = "Blog & Guides Ésotériques : Rituels, Fâ & Secrets | Cabinet Aziman";
const seoDesc = "Consultez tous les guides et articles de Maître Aziman sur le retour affectif, les rituels de protection, la chance financière et la pharmacopée traditionnelle.";

const featuredPost = allBlogArticles[0];
const regularPosts = allBlogArticles.slice(1);
---

<BaseLayout title={seoTitle} description={seoDesc}>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Enseignements, Rituels & Guides"
    title="Le Blog & Les Secrets Traditionnels du Maître Aziman"
    description="Retrouvez nos analyses détaillées, explications de rituels et conseils authentiques pour comprendre la puissance du Fâ, des plantes et des mystères ancestraux."
    breadcrumbs={[{ label: 'Blog & Guides', href: '/blog' }]}
  />

  <TrustBadges />

  <!-- CATEGORY PILLS -->
  <section class="border-b border-gray-200 bg-surface/95 backdrop-blur-md py-4 sticky top-16 md:top-20 z-30 shadow-xs">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2.5 overflow-x-auto no-scrollbar py-1">
        <a
          href="/blog"
          class="px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap bg-brand-900 text-gold-300 shadow-sm border border-gold-400/30"
        >
          Tous les articles ({allBlogArticles.length})
        </a>
        {blogCategories.map((cat) => (
          <a
            href={`/blog/categorie/${cat.slug}`}
            class="px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap bg-white text-gray-700 hover:text-brand-900 hover:bg-gold-50 border border-gray-200/80 transition-colors"
          >
            {cat.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- POSTS LIST -->
  <section class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Featured Spotlight Article -->
    {featuredPost && (
      <div class="mb-14">
        <div class="card-luxury overflow-hidden grid grid-cols-1 lg:grid-cols-12 bg-white border border-gray-100 hover:border-gold-400/80 transition-all duration-300 group shadow-md">
          <div class="lg:col-span-7 h-72 sm:h-88 lg:h-full relative overflow-hidden bg-brand-950">
            <img
              src={featuredPost.image}
              alt={featuredPost.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute top-4 left-4 bg-brand-950/90 backdrop-blur-md text-gold-300 text-xs font-serif font-bold px-3.5 py-1 rounded-full border border-gold-400/30 shadow-md">
              À la Une
            </div>
          </div>

          <div class="lg:col-span-5 p-6 sm:p-8 md:p-10 flex flex-col justify-between space-y-5">
            <div class="space-y-3.5">
              <div class="flex items-center gap-3 text-xs text-gold-700 font-semibold">
                <span class="bg-gold-50 px-2.5 py-0.5 rounded-full border border-gold-200/60 uppercase tracking-wider">{featuredPost.categoryName}</span>
                <span>•</span>
                <span>{featuredPost.readTime}</span>
              </div>

              <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark group-hover:text-brand-900 transition-colors leading-snug">
                <a href={`/blog/${featuredPost.slug}`}>
                  {featuredPost.title}
                </a>
              </h2>

              <p class="text-xs sm:text-sm text-gray-600 line-clamp-3 leading-relaxed font-sans">
                {featuredPost.metaDescription}
              </p>
            </div>

            <div class="pt-5 border-t border-gray-100 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <img
                  src={featuredPost.author.avatar}
                  alt={featuredPost.author.name}
                  class="w-8 h-8 rounded-full object-cover border border-gold-400/60"
                />
                <span class="text-xs font-semibold text-gray-700">{featuredPost.author.name}</span>
              </div>

              <a
                href={`/blog/${featuredPost.slug}`}
                class="btn-primary text-xs py-2 px-4 shadow-xs"
              >
                <span>Lire l'article →</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Regular Grid Articles -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {regularPosts.map((post) => (
        <article class="card-luxury overflow-hidden flex flex-col justify-between group hover:border-gold-400/80 transition-all duration-300 bg-white shadow-xs">
          <div>
            <div class="relative h-52 overflow-hidden bg-brand-950">
              <img
                src={post.image}
                alt={post.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-3 left-3 bg-brand-950/90 backdrop-blur-md text-gold-300 text-[10px] font-bold px-2.5 py-0.5 rounded-full border border-gold-400/30">
                {post.categoryName}
              </div>
            </div>

            <div class="p-6 space-y-2.5">
              <div class="text-[11px] text-gray-400 font-medium">
                {post.readTime}
              </div>
              <h3 class="font-serif font-bold text-lg text-brand-dark group-hover:text-brand-900 transition-colors leading-snug line-clamp-2">
                <a href={`/blog/${post.slug}`}>
                  {post.title}
                </a>
              </h3>
              <p class="text-xs text-gray-600 line-clamp-3 leading-relaxed font-sans">
                {post.metaDescription}
              </p>
            </div>
          </div>

          <div class="p-6 pt-0 mt-auto">
            <a
              href={`/blog/${post.slug}`}
              class="pt-4 border-t border-gray-100 w-full inline-flex items-center justify-between text-xs font-bold text-brand-900 hover:text-gold-700 uppercase tracking-wider transition-colors"
            >
              <span>Lire l'article</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

  </section>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
