---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import CtaSection from '../../components/CtaSection.astro';
import { allBlogArticles, blogCategories } from '../../data/blogData';
import { siteSettings } from '../../data/siteData';

const seoTitle = "Blog & Guides Ésotériques : Rituels, Fâ & Secrets | Cabinet Aziman";
const seoDesc = "Consultez tous les guides et articles de Maître Aziman sur le retour affectif, les rituels de protection, la chance financière et la pharmacopée traditionnelle.";

const featuredPost = allBlogArticles[0];
const regularPosts = allBlogArticles.slice(1);
const shortCategoryNames: Record<string, string> = {
  'amour-relations': 'Amour',
  'richesse-prosperite': 'Richesse',
  'protection-desenvoutement': 'Protection',
  'sante-plantes': 'Santé',
  'demarches-justice-france': 'Justice',
  'guides-produits': 'Guides',
};
---

<BaseLayout title={seoTitle} description={seoDesc}>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Enseignements, Rituels & Guides"
    title="Le Blog & Les Secrets Traditionnels du Maître Aziman"
    highlightWord="Maître Aziman"
    description="Retrouvez nos analyses détaillées, explications de rituels et conseils authentiques pour comprendre la puissance du Fâ, des plantes et des mystères ancestraux."
    breadcrumbs={[{ label: 'Blog & Guides', href: '/blog/' }]}
    image="/images/blog/hero-blog.webp"
    primaryCta={{ label: 'WhatsApp 24/7', href: siteSettings.whatsappLink, icon: 'whatsapp' }}
    secondaryCta={{ label: 'Lire nos publications', href: '#articles', icon: 'book' }}
  />

  <TrustBadges />

  <!-- CATEGORY PILLS -->
  <section class="border-b border-brand-200 bg-white/95 backdrop-blur-md py-3.5 sticky top-[104px] lg:top-[112px] z-30 shadow-md transition-all">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 overflow-x-auto no-scrollbar py-0.5">
        <div class="inline-flex items-center gap-1.5 pr-1 sm:pr-2 flex-shrink-0">
          <svg class="w-3.5 h-3.5 text-brand-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
          <span class="font-serif font-bold text-brand-dark text-xs sm:text-sm tracking-wide">Catégories :</span>
        </div>

        <a
          href="/blog/"
          class="px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap bg-brand-900 text-white shadow-sm border border-brand-700"
        >
          Tous ({allBlogArticles.length})
        </a>
        {blogCategories.map((cat) => (
          <a
            href={`/blog/categorie/${cat.slug}/`}
            class="px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap bg-white text-slate-700 hover:text-brand-900 hover:bg-brand-50 border border-brand-200 transition-colors"
          >
            {shortCategoryNames[cat.slug] || cat.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- POSTS LIST -->
  <section id="articles" class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-36">
    
    <!-- Featured Spotlight Article -->
    {featuredPost && (
      <div class="mb-14">
        <div class="card-luxury overflow-hidden grid grid-cols-1 lg:grid-cols-12 bg-white border border-brand-200/80 hover:border-brand-500 transition-all duration-200 group shadow-md">
          <div class="lg:col-span-7 h-72 sm:h-88 lg:h-full relative overflow-hidden bg-brand-950">
            <img
              src={featuredPost.image}
              alt={featuredPost.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute top-4 left-4 bg-brand-950/90 backdrop-blur-md text-white text-xs font-serif font-bold px-3.5 py-1 rounded-full border border-brand-700 shadow-md">
              À la Une
            </div>
          </div>

          <div class="lg:col-span-5 p-6 sm:p-8 md:p-10 flex flex-col justify-between space-y-5">
            <div class="space-y-3.5">
              <div class="flex items-center gap-3 text-xs text-brand-700 font-bold">
                <span class="bg-brand-50 px-2.5 py-0.5 rounded-full border border-brand-200 uppercase tracking-wider">{featuredPost.categoryName}</span>
                <span>•</span>
                <span>{featuredPost.readTime}</span>
              </div>

              <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark group-hover:text-brand-900 transition-colors leading-snug">
                <a href={`/blog/${featuredPost.slug}/`}>
                  {featuredPost.title}
                </a>
              </h2>

              <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed font-sans">
                {featuredPost.metaDescription}
              </p>
            </div>

            <div class="pt-5 border-t border-brand-100 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <img
                  src={featuredPost.author.avatar}
                  alt={featuredPost.author.name}
                  class="w-8 h-8 rounded-full object-cover border border-brand-300"
                />
                <span class="text-xs font-semibold text-slate-700">{featuredPost.author.name}</span>
              </div>

              <a
                href={`/blog/${featuredPost.slug}/`}
                class="btn-primary text-xs py-2 px-4 shadow-xs"
              >
                <span>Lire l'article →</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Regular Grid Articles -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {regularPosts.map((post) => (
        <article class="card-luxury overflow-hidden flex flex-col justify-between group hover:border-brand-500 transition-all duration-200 bg-white shadow-xs">
          <div>
            <div class="relative h-52 overflow-hidden bg-brand-950">
              <img
                src={post.image}
                alt={post.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-3 left-3 bg-brand-950/90 backdrop-blur-md text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full border border-brand-700">
                {post.categoryName}
              </div>
            </div>

            <div class="p-6 space-y-2.5">
              <div class="text-[11px] text-slate-400 font-medium font-sans">
                {post.readTime}
              </div>
              <h3 class="font-serif font-bold text-lg text-brand-dark group-hover:text-brand-900 transition-colors leading-snug line-clamp-2">
                <a href={`/blog/${post.slug}/`}>
                  {post.title}
                </a>
              </h3>
              <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed font-sans">
                {post.metaDescription}
              </p>
            </div>
          </div>

          <div class="p-6 pt-0 mt-auto">
            <a
              href={`/blog/${post.slug}/`}
              class="pt-4 border-t border-brand-100 w-full inline-flex items-center justify-between text-xs font-bold text-brand-900 hover:text-brand-700 uppercase tracking-wider transition-colors"
            >
              <span>Lire l'article</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

  </section>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
