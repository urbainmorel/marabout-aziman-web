---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import DomainCard from '../../components/DomainCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import { servicesHubs } from '../../data/servicesData';

const seoTitle = "Nos Domaines de Rituels & Consultations | Cabinet Aziman France";
const seoDesc = "Découvrez l'ensemble des domaines d'intervention spirituelle du Cabinet Maître Aziman en France : Amour, Richesse, Commerce, Protection, Justice, Santé, Voyance.";
---

<BaseLayout title={seoTitle} description={seoDesc}>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Pôle Rituels & Consultations Traditionnelles"
    title="Nos Domaines d'Intervention Spirituelle en France"
    description="Héritier des secrets du Fâ et des grands mystères traditionnels d'Afrique de l'Ouest, Maître Aziman réalise des interventions ciblées et personnalisées en cabinet à Paris et à distance sur toute la France."
    breadcrumbs={[{ label: 'Services & Rituels', href: '/services' }]}
    highlightWord="Maître Aziman"
    image="/images/services/categories/divination-voyance-hero.webp"
    primaryCta={{ label: 'WhatsApp 24/7', href: 'https://wa.me/33753368297', icon: 'whatsapp' }}
    
  />

  <TrustBadges />

  <!-- 8 HUBS GRID -->
  <section class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center space-y-2 mb-10">
      <h2 class="font-serif font-bold text-2xl sm:text-3xl md:text-4xl text-brand-dark">
        Les 8 Pôles Majeurs du Cabinet Aziman
      </h2>
      <div class="w-12 h-1 bg-brand-900 mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {servicesHubs.map((hub) => (
        <DomainCard hub={hub} />
      ))}
    </div>
  </section>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
