---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import DomainCard from '../../components/DomainCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import { servicesHubs } from '../../data/servicesData';

const seoTitle = "Nos 8 Domaines de Rituels & Consultations | Cabinet Aziman France";
const seoDesc = "Découvrez l'ensemble des 8 domaines d'intervention spirituelle du Cabinet Maître Aziman en France : Amour, Richesse, Commerce, Protection, Justice, Santé, Voyance.";
---

<BaseLayout title={seoTitle} description={seoDesc}>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Pôle Rituels & Consultations Traditionnelles"
    title="Nos 8 Domaines d'Intervention Spirituelle en France"
    description="Héritier des secrets du Fâ et des grands mystères traditionnels d'Afrique de l'Ouest, Maître Aziman réalise des interventions ciblées et personnalisées en cabinet à Paris et à distance sur toute la France."
    breadcrumbs={[{ label: 'Services & Rituels', href: '/services' }]}
  />

  <TrustBadges />

  <!-- 8 HUBS GRID -->
  <section class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {servicesHubs.map((hub) => (
        <DomainCard hub={hub} />
      ))}
    </div>
  </section>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
