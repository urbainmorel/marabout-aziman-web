---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { allSubservices, type SubService } from '../../../data/servicesData';
import { siteSettings } from '../../../data/siteData';

export async function getStaticPaths() {
  return allSubservices.map((sub) => ({
    params: { silo: sub.silo, slug: sub.slug },
    props: { sub },
  }));
}

interface Props {
  sub: SubService;
}

const { sub } = Astro.props;

// Service JSON-LD Structured Data Schema
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": sub.title,
  "serviceType": sub.siloName,
  "description": sub.metaDescription,
  "provider": {
    "@type": "ProfessionalService",
    "name": "Cabinet Maître Aziman",
    "telephone": siteSettings.phone,
    "url": "https://marabout-aziman.fr"
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Île-de-France" },
    { "@type": "Country", "name": "France" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Rituels Traditionnels et Consultations Spirituelles"
  }
};

// BreadcrumbList JSON-LD Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://marabout-aziman.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://marabout-aziman.fr/services/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": sub.siloName,
      "item": `https://marabout-aziman.fr/services/${sub.silo}/`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": sub.title,
      "item": `https://marabout-aziman.fr/services/${sub.silo}/${sub.slug}/`
    }
  ]
};
---

<BaseLayout
  title={sub.metaTitle}
  description={sub.metaDescription}
  keywords={sub.keywords}
  image={sub.image}
  schema={[serviceSchema, breadcrumbSchema]}
>
  
  <!-- HERO HEADER -->
  <section class="relative bg-gradient-to-b from-brand-900 to-brand-800 text-white py-12 md:py-16 border-b border-gold-400/20 overflow-hidden">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <Breadcrumbs
        items={[
          { label: 'Services', href: '/services' },
          { label: sub.siloName, href: `/services/${sub.silo}` },
          { label: sub.title, href: `/services/${sub.silo}/${sub.slug}` },
        ]}
      />
      
      <div class="mt-6 max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-gold-400/20 text-gold-300 text-xs font-semibold uppercase tracking-wider">
          <span>{sub.icon}</span>
          <span>{sub.siloName}</span>
        </div>
        <h1 class="font-serif font-bold text-3xl sm:text-4xl md:text-5xl text-white leading-tight">
          {sub.title}
        </h1>
        <p class="text-sm sm:text-base text-gray-200 leading-relaxed font-sans">
          {sub.metaDescription}
        </p>
      </div>
    </div>
  </section>

  <!-- CONTENT -->
  <article class="py-12 md:py-16 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Main Content Body -->
      <div class="lg:col-span-8 space-y-8">
        
        <div class="rounded-2xl overflow-hidden mb-8 shadow-lg max-h-96 bg-gray-100">
          <img
            src={sub.image}
            alt={`Rituel traditionnel : ${sub.title}`}
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Rich Semantic HTML Content -->
        <div class="prose-aziman" set:html={sub.contentHtml} />

      </div>

      <!-- Sticky Consultation & Action Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="card-luxury p-6 bg-brand-900 text-white shadow-xl space-y-5 sticky top-24">
          <div class="flex items-center gap-3 border-b border-white/10 pb-4">
            <span class="text-3xl">{sub.icon}</span>
            <div>
              <h3 class="font-serif font-bold text-lg text-white">Lancer ce Rituel</h3>
              <p class="text-xs text-gold-300">Accompagnement personnalisé 7j/7</p>
            </div>
          </div>

          <p class="text-xs text-gray-300 leading-relaxed">
            Contactez directement Maître Aziman pour une analyse préalable de compatibilité et le démarrage immédiat de votre travail.
          </p>

          <div class="space-y-2 text-xs text-gray-200">
            <p><strong>Téléphone :</strong> {siteSettings.phoneDisplay}</p>
            <p><strong>WhatsApp :</strong> {siteSettings.whatsappDisplay}</p>
            <p><strong>Délai moyen :</strong> Résultats sous 24h à 7 jours</p>
          </div>

          <div class="pt-2 space-y-2">
            <a
              href={`https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(`Bonjour Maître Aziman, je souhaite des informations et une consultation pour le rituel : ${sub.title}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-whatsapp w-full justify-center text-xs py-3 font-semibold"
            >
              <span>Échanger sur WhatsApp</span>
            </a>

            <a
              href="/contact"
              class="btn-secondary w-full justify-center text-xs py-3 font-semibold text-center"
            >
              <span>Prendre RDV au Cabinet</span>
            </a>
          </div>
        </div>
      </aside>

    </div>
  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
