---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroHeader from '../../../components/HeroHeader.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import TrustBadges from '../../../components/TrustBadges.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { servicesHubs, type ServiceSubservice, type ServiceHub } from '../../../data/servicesData';
import { siteSettings } from '../../../data/siteData';

export async function getStaticPaths() {
  const paths: { params: { silo: string; slug: string }; props: { hub: ServiceHub; sub: ServiceSubservice } }[] = [];

  servicesHubs.forEach((hub) => {
    if (hub.subservices) {
      hub.subservices.forEach((sub) => {
        paths.push({
          params: { silo: hub.silo, slug: sub.slug },
          props: { hub, sub },
        });
      });
    }
  });

  return paths;
}

interface Props {
  hub: ServiceHub;
  sub: ServiceSubservice;
}

const { hub, sub } = Astro.props;

const isVoyance = hub.silo === 'divination-voyance';
const ctaLabel = isVoyance ? 'Consultation' : 'Commander';
const serviceUrl = `https://www.marabout-aziman.fr/services/${hub.silo}/${sub.slug}/`;
const whatsappMessage = isVoyance
  ? `Bonjour Maître Aziman, je souhaite réserver une consultation de voyance : ${sub.title}\nLien : ${serviceUrl}`
  : `Bonjour Maître Aziman, je souhaite commander le rituel : ${sub.title}\nLien : ${serviceUrl}`;
const whatsappServiceUrl = `https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

// Service / Ritual Schema
const ritualSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": sub.title,
  "serviceType": sub.title,
  "description": sub.metaDescription,
  "provider": {
    "@type": "ProfessionalService",
    "name": "Cabinet Maître Aziman",
    "telephone": siteSettings.phone,
    "url": "https://www.marabout-aziman.fr"
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Île-de-France" },
    { "@type": "Country", "name": "France" }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://www.marabout-aziman.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://www.marabout-aziman.fr/services/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": hub.name,
      "item": `https://www.marabout-aziman.fr/services/${hub.silo}/`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": sub.title,
      "item": `https://www.marabout-aziman.fr/services/${hub.silo}/${sub.slug}/`
    }
  ]
};
---

<BaseLayout
  title={sub.metaTitle}
  description={sub.metaDescription}
  keywords={sub.keywords}
  image={sub.image || hub.image}
  schema={[ritualSchema, breadcrumbSchema]}
>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge={`Rituel Ancestral • ${hub.name}`}
    title={sub.title}
    description={sub.metaDescription}
    breadcrumbs={[
      { label: 'Services', href: '/services/' },
      { label: hub.name, href: `/services/${hub.silo}/` },
      { label: sub.title, href: `/services/${hub.silo}/${sub.slug}/` },
    ]}
  
    image={sub ? `/images/services/${hub.silo}/${sub.slug}-hero.webp` : `/images/services/categories/${hub.silo}-hero.webp`}
    primaryCta={{
      label: ctaLabel,
      href: whatsappServiceUrl,
      icon: 'whatsapp',
      iconPosition: 'right'
    }}
    
  />

  <TrustBadges />

  <!-- ARTICLE CONTENT -->
  <article class="py-12 sm:py-16 md:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    {sub.image && (
      <div class="rounded-3xl overflow-hidden shadow-xl max-h-96 bg-brand-950 border border-brand-800">
        <img
          src={sub.image}
          alt={sub.title}
          loading="lazy"
          decoding="async"
          width="800"
          height="500"
          class="w-full h-full object-cover max-h-96"
        />
      </div>
    )}

    <!-- Quick Action Bar Under Image -->
    <div class="p-6 sm:p-7 bg-surface rounded-2xl border border-brand-200/80 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-wider block">
          {isVoyance ? 'Consultation Privée & Confidentielle' : 'Intervention Directe & Rituel Personnalisé'}
        </span>
        <p class="text-xs sm:text-sm text-slate-600 font-sans mt-0.5">
          {isVoyance 
            ? 'Séance de voyance directe par téléphone ou WhatsApp • Diagnostic précis par le Fâ' 
            : 'Rituel exécuté sur autel consacré selon vos coordonnées astrales • Suivi continu'}
        </p>
      </div>
      <a
        href={whatsappServiceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 px-8 py-3.5 bg-emerald-600 hover:bg-emerald-500 text-white font-sans font-bold text-sm sm:text-base rounded-full shadow-lg shadow-emerald-900/20 transition-all duration-300 transform hover:-translate-y-0.5 whitespace-nowrap flex-shrink-0"
      >
        <span>{ctaLabel}</span>
        <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </a>
    </div>

    <!-- Table of Contents -->
    <TableOfContents />

    <!-- Pure Editorial HTML -->
    <div class="prose-aziman" set:html={sub.contentHtml} />

    <!-- Bottom Action Bar -->
    <div class="mt-10 p-6 sm:p-8 bg-surface rounded-2xl border border-brand-200/80 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left">
        <p class="font-serif font-bold text-lg sm:text-xl text-brand-dark">
          {isVoyance ? 'Prêt à réserver votre consultation de voyance ?' : 'Besoin de ce rituel pour débloquer votre situation ?'}
        </p>
        <p class="text-xs sm:text-sm text-slate-600 font-sans mt-1">
          Maître Aziman vous répond directement sur WhatsApp avec discrétion absolue et écoute bienveillante.
        </p>
      </div>
      <a
        href={whatsappServiceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 px-8 py-3.5 bg-emerald-600 hover:bg-emerald-500 text-white font-sans font-bold text-sm sm:text-base rounded-full shadow-lg shadow-emerald-900/20 transition-all duration-300 transform hover:-translate-y-0.5 whitespace-nowrap flex-shrink-0"
      >
        <span>{ctaLabel}</span>
        <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </a>
    </div>

    <!-- Related Rituals in the Same Domain -->
    {hub.subservices && hub.subservices.length > 1 && (
      <div class="border-t border-brand-200 pt-10 mt-12 space-y-6">
        <div class="space-y-1">
          <span class="text-xs font-bold text-brand-700 uppercase tracking-wider">Autres Rituels du Domaine</span>
          <h3 class="font-serif font-bold text-xl sm:text-2xl text-brand-dark">
            Complétez votre démarche spirituelle
          </h3>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {hub.subservices
            .filter(s => s.slug !== sub.slug)
            .slice(0, 4)
            .map(other => (
              <a
                href={`/services/${hub.silo}/${other.slug}/`}
                class="p-4 rounded-xl bg-brand-50/60 border border-brand-200 hover:border-brand-500 hover:bg-white transition-all flex items-center justify-between text-xs font-bold text-brand-dark group shadow-xs"
              >
                <span>{other.title}</span>
                <span class="text-brand-700 group-hover:translate-x-1 transition-transform">→</span>
              </a>
            ))}
        </div>
      </div>
    )}

  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
