---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroHeader from '../../../components/HeroHeader.astro';
import ConsultationSidebar from '../../../components/ConsultationSidebar.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import TrustBadges from '../../../components/TrustBadges.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { allSubservices, type SubService } from '../../../data/servicesData';
import { siteSettings } from '../../../data/siteData';

export async function getStaticPaths() {
  return allSubservices.map((sub) => ({
    params: { silo: sub.silo, slug: sub.slug },
    props: { sub },
  }));
}

interface Props {
  sub: SubService;
}

const { sub } = Astro.props;

// Service JSON-LD Structured Data Schema
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": sub.title,
  "serviceType": sub.siloName,
  "description": sub.metaDescription,
  "provider": {
    "@type": "ProfessionalService",
    "name": "Cabinet Maître Aziman",
    "telephone": siteSettings.phone,
    "url": "https://marabout-aziman.fr"
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Île-de-France" },
    { "@type": "Country", "name": "France" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Rituels Traditionnels et Consultations Spirituelles"
  }
};

// BreadcrumbList JSON-LD Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://marabout-aziman.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://marabout-aziman.fr/services/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": sub.siloName,
      "item": `https://marabout-aziman.fr/services/${sub.silo}/`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": sub.title,
      "item": `https://marabout-aziman.fr/services/${sub.silo}/${sub.slug}/`
    }
  ]
};
---

<BaseLayout
  title={sub.metaTitle}
  description={sub.metaDescription}
  keywords={sub.keywords}
  image={sub.image}
  schema={[serviceSchema, breadcrumbSchema]}
>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge={sub.siloName}
    title={sub.title}
    description={sub.metaDescription}
    breadcrumbs={[
      { label: 'Services & Rituels', href: '/services' },
      { label: sub.siloName, href: `/services/${sub.silo}` },
      { label: sub.title, href: `/services/${sub.silo}/${sub.slug}` },
    ]}
  />

  <TrustBadges />

  <!-- CONTENT -->
  <article class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      
      <!-- Main Content Body -->
      <div class="lg:col-span-8 space-y-8">
        
        <!-- Featured Image Card -->
        <div class="rounded-3xl overflow-hidden shadow-xl max-h-96 bg-brand-950 border border-gold-400/20">
          <img
            src={sub.image}
            alt={`Rituel traditionnel : ${sub.title}`}
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Table of Contents -->
        <TableOfContents />

        <!-- Rich Semantic HTML Content -->
        <div class="prose-aziman" set:html={sub.contentHtml} />

      </div>

      <!-- Sticky Reusable Consultation & Action Sidebar -->
      <div class="lg:col-span-4">
        <ConsultationSidebar
          title="Consulter pour ce Rituel"
          subtitle={sub.title}
          contextText={`Contactez directement Maître Aziman pour une analyse préalable de votre situation concernant le rituel "${sub.title}" et son exécution sur mesure.`}
          actionText="Échanger sur WhatsApp"
          customWhatsappMsg={`Bonjour Maître Aziman, je souhaite des informations et une consultation pour le rituel : ${sub.title}`}
        />
      </div>

    </div>
  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
