---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroHeader from '../../../components/HeroHeader.astro';
import ConsultationSidebar from '../../../components/ConsultationSidebar.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import TrustBadges from '../../../components/TrustBadges.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { servicesHubs, type ServiceSubservice, type ServiceHub } from '../../../data/servicesData';
import { siteSettings } from '../../../data/siteData';

export async function getStaticPaths() {
  const paths: any[] = [];

  servicesHubs.forEach((hub) => {
    if (hub.subservices) {
      hub.subservices.forEach((sub) => {
        paths.push({
          params: { silo: hub.silo, slug: sub.slug },
          props: { hub, sub },
        });
      });
    }
  });

  return paths;
}

interface Props {
  hub: ServiceHub;
  sub: ServiceSubservice;
}

const { hub, sub } = Astro.props;

// Specific Ritual Schema
const ritualSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": sub.title,
  "serviceType": hub.name,
  "description": sub.metaDescription,
  "provider": {
    "@type": "ProfessionalService",
    "name": "Cabinet Maître Aziman",
    "telephone": siteSettings.phone,
    "url": "https://marabout-aziman.fr"
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Île-de-France" },
    { "@type": "Country", "name": "France" }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://marabout-aziman.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://marabout-aziman.fr/services/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": hub.name,
      "item": `https://marabout-aziman.fr/services/${hub.silo}/`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": sub.title,
      "item": `https://marabout-aziman.fr/services/${hub.silo}/${sub.slug}/`
    }
  ]
};
---

<BaseLayout
  title={sub.metaTitle}
  description={sub.metaDescription}
  keywords={sub.keywords}
  image={sub.image || hub.image}
  schema={[ritualSchema, breadcrumbSchema]}
>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge={`Rituel Ancestral • ${hub.name}`}
    title={sub.title}
    description={sub.metaDescription}
    breadcrumbs={[
      { label: 'Services', href: '/services' },
      { label: hub.name, href: `/services/${hub.silo}` },
      { label: sub.title, href: `/services/${hub.silo}/${sub.slug}` },
    ]}
  />

  <TrustBadges />

  <!-- ARTICLE CONTENT -->
  <article class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      
      <!-- Ritual Body & TOC -->
      <div class="lg:col-span-8 space-y-8">
        
        {sub.image && (
          <div class="rounded-3xl overflow-hidden shadow-xl max-h-96 bg-brand-950 border border-brand-800">
            <img
              src={sub.image}
              alt={sub.title}
              class="w-full h-full object-cover max-h-96"
            />
          </div>
        )}

        <!-- Table of Contents -->
        <TableOfContents />

        <!-- Pure Editorial HTML -->
        <div class="prose-aziman" set:html={sub.contentHtml} />

        <!-- Related Rituals in the Same Domain -->
        {hub.subservices && hub.subservices.length > 1 && (
          <div class="border-t border-brand-200 pt-10 mt-12 space-y-6">
            <div class="space-y-1">
              <span class="text-xs font-bold text-brand-700 uppercase tracking-wider">Autres Rituels du Domaine</span>
              <h3 class="font-serif font-bold text-xl sm:text-2xl text-brand-dark">
                Complétez votre démarche spirituelle
              </h3>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {hub.subservices
                .filter(s => s.slug !== sub.slug)
                .slice(0, 4)
                .map(other => (
                  <a
                    href={`/services/${hub.silo}/${other.slug}`}
                    class="p-4 rounded-xl bg-brand-50/60 border border-brand-200 hover:border-brand-500 hover:bg-white transition-all flex items-center justify-between text-xs font-bold text-brand-dark group shadow-xs"
                  >
                    <span>{other.title}</span>
                    <span class="text-brand-700 group-hover:translate-x-1 transition-transform">→</span>
                  </a>
                ))}
            </div>
          </div>
        )}

      </div>

      <!-- Reusable Luxury Consultation Sidebar -->
      <div class="lg:col-span-4">
        <ConsultationSidebar
          title={`Rituel : ${sub.title.replace(' en France', '')}`}
          subtitle="Consultation & Activation Personnalisée"
          contextText={`Prenez contact avec Maître Aziman pour planifier ce rituel et bénéficier d'une prise en charge immédiate en cabinet ou à distance.`}
          customWhatsappMsg={`Bonjour Maître Aziman, je souhaite des informations et un devis pour le rituel : ${sub.title}`}
        />
      </div>

    </div>
  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
