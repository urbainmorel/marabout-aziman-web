---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroHeader from '../../../components/HeroHeader.astro';
import ConsultationSidebar from '../../../components/ConsultationSidebar.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import TrustBadges from '../../../components/TrustBadges.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { servicesHubs, type ServiceHub } from '../../../data/servicesData';
import { siteSettings } from '../../../data/siteData';

export async function getStaticPaths() {
  return servicesHubs.map((hub) => ({
    params: { silo: hub.silo },
    props: { hub },
  }));
}

interface Props {
  hub: ServiceHub;
}

const { hub } = Astro.props;

// Service Hub Schema
const hubSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": hub.title,
  "serviceType": hub.name,
  "description": hub.metaDescription,
  "provider": {
    "@type": "ProfessionalService",
    "name": "Cabinet Maître Aziman",
    "telephone": siteSettings.phone,
    "url": "https://marabout-aziman.fr"
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Île-de-France" },
    { "@type": "Country", "name": "France" }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://marabout-aziman.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://marabout-aziman.fr/services/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": hub.name,
      "item": `https://marabout-aziman.fr/services/${hub.silo}/`
    }
  ]
};
---

<BaseLayout
  title={hub.metaTitle}
  description={hub.metaDescription}
  keywords={hub.keywords}
  image={hub.image}
  schema={[hubSchema, breadcrumbSchema]}
>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Domaine d'Intervention Majeur"
    title={hub.title}
    description={hub.metaDescription}
    breadcrumbs={[
      { label: 'Services & Rituels', href: '/services' },
      { label: hub.name, href: `/services/${hub.silo}` },
    ]}
  />

  <TrustBadges />

  <!-- CONTENT & SUBSERVICES -->
  <article class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      
      <!-- Main Hub Body -->
      <div class="lg:col-span-8 space-y-10">
        
        <!-- Table of Contents -->
        <TableOfContents />

        <!-- Rich Semantic HTML Content -->
        <div class="prose-aziman" set:html={hub.contentHtml} />

        <!-- Subservices Grid -->
        {hub.subservices && hub.subservices.length > 0 && (
          <div class="border-t border-brand-200 pt-10 space-y-6">
            <div class="space-y-2">
              <span class="text-xs font-bold text-brand-700 uppercase tracking-wider">Rituels Dédiés</span>
              <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
                Rituels & Interventions Spécifiques dans ce Domaine
              </h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              {hub.subservices.map((sub) => (
                <div class="card-luxury p-6 bg-white border border-brand-200/80 hover:border-brand-500 transition-all flex flex-col justify-between group shadow-xs">
                  <div>
                    <h3 class="font-serif font-bold text-base sm:text-lg text-brand-dark group-hover:text-brand-900 transition-colors">
                      <a href={`/services/${hub.silo}/${sub.slug}`}>
                        {sub.title}
                      </a>
                    </h3>
                    <p class="text-xs text-slate-600 line-clamp-3 mt-2 leading-relaxed font-sans">
                      {sub.metaDescription}
                    </p>
                  </div>
                  <a
                    href={`/services/${hub.silo}/${sub.slug}`}
                    class="mt-5 pt-3 border-t border-brand-100 text-xs font-bold text-brand-900 group-hover:text-brand-700 flex items-center justify-between uppercase tracking-wider"
                  >
                    <span>Consulter le rituel</span>
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                  </a>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- Reusable Luxury Consultation Sidebar -->
      <div class="lg:col-span-4">
        <ConsultationSidebar
          title={`Consultation : ${hub.name}`}
          subtitle="Cabinet Paris & Rituels à Distance"
          contextText={`Consultez Maître Aziman pour une analyse préalable de votre situation dans le domaine ${hub.name} et l'activation du rituel le plus adapté.`}
          customWhatsappMsg={`Bonjour Maître Aziman, je vous contacte pour une consultation dans le domaine : ${hub.name}`}
        />
      </div>

    </div>
  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
