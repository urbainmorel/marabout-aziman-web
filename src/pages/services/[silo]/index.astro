---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroHeader from '../../../components/HeroHeader.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import TrustBadges from '../../../components/TrustBadges.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { servicesHubs, type ServiceHub } from '../../../data/servicesData';
import { siteSettings } from '../../../data/siteData';

export async function getStaticPaths() {
  return servicesHubs.map((hub) => ({
    params: { silo: hub.silo },
    props: { hub },
  }));
}

interface Props {
  hub: ServiceHub;
}

const { hub } = Astro.props;

// Service Hub Schema
const hubSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": hub.title,
  "serviceType": hub.name,
  "description": hub.metaDescription,
  "provider": {
    "@type": "ProfessionalService",
    "name": "Cabinet Maître Aziman",
    "telephone": siteSettings.phone,
    "url": "https://www.marabout-aziman.fr"
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Île-de-France" },
    { "@type": "Country", "name": "France" }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://www.marabout-aziman.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://www.marabout-aziman.fr/services/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": hub.name,
      "item": `https://www.marabout-aziman.fr/services/${hub.silo}/`
    }
  ]
};
// Split contentHtml around the "Nos Rituels Majeurs" section so we replace it with rich cards
const splitRegex = /<h2[^>]*>(?:Nos\s+[0-9]+\s+[^<]+)<\/h2>[\s\S]*?(?=<hr class="my-8 border-brand-200" \/>)/;
const hasMatch = hub.contentHtml && splitRegex.test(hub.contentHtml);
const [beforeRituels, afterRituels] = hasMatch
  ? hub.contentHtml.split(splitRegex)
  : [hub.contentHtml, ''];
---

<BaseLayout
  title={hub.metaTitle}
  description={hub.metaDescription}
  keywords={hub.keywords}
  image={hub.image}
  schema={[hubSchema, breadcrumbSchema]}
>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Domaine d'Intervention Majeur"
    title={hub.title}
    description={hub.metaDescription}
    breadcrumbs={[
      { label: 'Services & Rituels', href: '/services' },
      { label: hub.name, href: `/services/${hub.silo}` },
    ]}
  
    image={"https://images.unsplash.com/photo-1517594422361-5e1823eb9753?q=80&w=1000&auto=format&fit=crop"}
    primaryCta={{ label: 'WhatsApp 24/7', href: 'https://wa.me/33753368297', icon: 'whatsapp' }}
    
  />

  <TrustBadges />

  <!-- CONTENT & SUBSERVICES -->
  <article class="py-12 sm:py-16 md:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    
    <!-- Table of Contents -->
    <TableOfContents />

    <!-- Rich Semantic HTML Content (Partie 1) -->
    <div class="prose-aziman" set:html={beforeRituels} />

    <!-- Section Nos Rituels Majeurs sous forme de Cartes avec Image et Deux Boutons -->
    {hub.subservices && hub.subservices.length > 0 && (
      <section class="pt-2 space-y-6" id="rituels-majeurs">
        <div class="space-y-2">
          <span class="text-xs font-bold text-brand-700 uppercase tracking-wider">Interventions Spécifiques</span>
          <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
            Nos Rituels Majeurs
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 font-sans leading-relaxed">
            Découvrez nos rituels majeurs consacrés selon les règles strictes de la tradition. Choisissez le rituel adapté à votre situation pour commander ou consulter sa fiche complète :
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {hub.subservices.map((sub) => {
            const isVoyance = hub.silo === 'divination-voyance';
            const ctaRituelLabel = isVoyance ? 'Consultation' : 'Commander';
            const whatsappMsg = isVoyance
              ? `Bonjour Maître Aziman, je souhaite réserver une consultation de voyance : ${sub.title}\nLien : https://www.marabout-aziman.fr/services/${hub.silo}/${sub.slug}/`
              : `Bonjour Maître Aziman, je souhaite commander le rituel : ${sub.title}\nLien : https://www.marabout-aziman.fr/services/${hub.silo}/${sub.slug}/`;
            const whatsappRituelUrl = `https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(whatsappMsg)}`;
            return (
              <div class="card-luxury p-4 sm:p-5 bg-white border border-brand-200/80 hover:border-brand-500 transition-all flex flex-col justify-between group shadow-xs rounded-2xl">
                <div>
                  <div class="relative aspect-[16/10] mb-3.5 rounded-xl overflow-hidden bg-brand-950">
                    <img
                      src={sub.image || hub.image}
                      alt={sub.title}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-brand-950/70 via-transparent to-transparent"></div>
                  </div>

                  <h3 class="font-serif font-bold text-base sm:text-lg text-brand-dark group-hover:text-brand-900 transition-colors leading-snug">
                    <a href={`/services/${hub.silo}/${sub.slug}`} class="hover:underline">
                      {sub.title}
                    </a>
                  </h3>
                  <p class="text-xs text-slate-600 line-clamp-3 mt-2 leading-relaxed font-sans">
                    {sub.metaDescription}
                  </p>
                </div>

                <!-- Deux boutons : Détails & Commander / Consultation -->
                <div class="mt-5 pt-3.5 border-t border-brand-100 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5">
                  <a
                    href={`/services/${hub.silo}/${sub.slug}`}
                    class="text-xs py-2 px-3 text-center font-bold text-brand-900 hover:text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 rounded-full transition-colors order-2 sm:order-1"
                  >
                    Détails →
                  </a>
                  <a
                    href={whatsappRituelUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-whatsapp text-xs py-2 px-3.5 shadow-xs font-bold inline-flex items-center justify-center gap-1.5 order-1 sm:order-2"
                  >
                    <span>{ctaRituelLabel}</span>
                    <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                    </svg>
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- Rich Semantic HTML Content (Partie 2) -->
    {afterRituels && <div class="prose-aziman" set:html={afterRituels} />}

  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
