---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import CtaSection from '../../components/CtaSection.astro';
import { allZones } from '../../data/zonesData';
import { siteSettings } from '../../data/siteData';

const seoTitle = "Zones d'Intervention en France : Cabinet & Distance | Aziman";
const seoDesc = "Découvrez l'ensemble des zones d'intervention de Maître Aziman en France. Consultations en cabinet à Paris et déplacements réguliers à Lyon, Marseille, Bordeaux, etc.";
---

<BaseLayout title={seoTitle} description={seoDesc}>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Présence Nationale & Déplacements"
    title="Zones d'Intervention du Maître Aziman en France"
    description="Maître Aziman vous reçoit sur rendez-vous au sein de son cabinet principal en Île-de-France et intervient dans toutes les grandes métropoles françaises lors de ses déplacements et par rituels à distance."
    breadcrumbs={[{ label: 'Zones d\'Intervention', href: '/zones-d-intervention' }]}
    highlightWord="Maître Aziman"
    image="/images/zones/pillar-zone.webp"
    primaryCta={{ label: 'WhatsApp 24/7', href: 'https://wa.me/33753368297', icon: 'whatsapp' }}
    
  />

  <TrustBadges />

  <!-- ZONES GRID -->
  <section class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {allZones.map((zone) => (
        <div class="card-luxury overflow-hidden flex flex-col justify-between group hover:border-brand-500 transition-all duration-200 shadow-xs">
          <div class="relative h-48 bg-brand-950 overflow-hidden">
            <img
              src={zone.image}
              alt={zone.title}
              loading="lazy"
              decoding="async"
              width="800"
              height="500"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-950/90 via-transparent to-transparent"></div>
            <div class="absolute bottom-3 left-4 text-white">
              <span class="text-[10px] uppercase text-brand-300 font-bold tracking-wider">Région France</span>
              <h3 class="font-serif font-bold text-lg leading-tight drop-shadow">{zone.regionName}</h3>
            </div>
          </div>

          <div class="p-6 flex-1 flex flex-col justify-between">
            <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed font-sans">
              {zone.metaDescription}
            </p>

            <a
              href={`/zones-d-intervention/${zone.slug}`}
              class="mt-5 pt-3 border-t border-brand-100 text-xs font-bold text-brand-900 hover:text-brand-700 uppercase tracking-wider flex items-center justify-between transition-colors"
            >
              <span>Consulter cette région</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
