---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import ConsultationSidebar from '../../components/ConsultationSidebar.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import CtaSection from '../../components/CtaSection.astro';
import { allZones, type ZoneItem } from '../../data/zonesData';
import { siteSettings } from '../../data/siteData';

export async function getStaticPaths() {
  return allZones.map((zone) => ({
    params: { slug: zone.slug },
    props: { zone },
  }));
}

interface Props {
  zone: ZoneItem;
}

const { zone } = Astro.props;

// Local Business Schema
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": `Cabinet Maître Aziman - ${zone.regionName}`,
  "description": zone.metaDescription,
  "telephone": siteSettings.phone,
  "url": `https://marabout-aziman.fr/zones-d-intervention/${zone.slug}/`,
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": zone.regionName
  },
  "priceRange": "€€",
  "address": {
    "@type": "PostalAddress",
    "addressRegion": zone.regionName,
    "addressCountry": "FR"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://marabout-aziman.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Zones d'Intervention",
      "item": "https://marabout-aziman.fr/zones-d-intervention/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": zone.regionName,
      "item": `https://marabout-aziman.fr/zones-d-intervention/${zone.slug}/`
    }
  ]
};
---

<BaseLayout
  title={zone.metaTitle}
  description={zone.metaDescription}
  keywords={zone.keywords}
  image={zone.image}
  schema={[localBusinessSchema, breadcrumbSchema]}
>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge={`Secteur d'Intervention : ${zone.regionName}`}
    title={zone.title}
    description={zone.metaDescription}
    breadcrumbs={[
      { label: 'Zones d\'Intervention', href: '/zones-d-intervention' },
      { label: zone.regionName, href: `/zones-d-intervention/${zone.slug}` },
    ]}
  />

  <TrustBadges />

  <!-- CONTENT -->
  <article class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      
      <div class="lg:col-span-8 space-y-8">
        
        <!-- Featured Image -->
        <div class="rounded-3xl overflow-hidden shadow-xl max-h-96 bg-brand-950 border border-brand-800 mb-8">
          <img
            src={zone.image}
            alt={`Intervention Marabout à ${zone.regionName} : ${zone.title}`}
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Table of Contents -->
        <TableOfContents />

        <!-- Rich Semantic HTML Content -->
        <div class="prose-aziman" set:html={zone.contentHtml} />

      </div>

      <!-- Sticky Reusable Consultation Sidebar -->
      <div class="lg:col-span-4">
        <ConsultationSidebar
          title={`Consultation : ${zone.regionName}`}
          subtitle="Cabinet & Intervention à Distance"
          contextText={`Prenez rendez-vous avec Maître Aziman pour une séance au cabinet de Paris ou un rituel à distance immédiat dans la région ${zone.regionName}.`}
          actionText="Échanger sur WhatsApp"
          customWhatsappMsg={`Bonjour Maître Aziman, je réside dans la région ${zone.regionName} et je souhaite une consultation.`}
        />
      </div>

    </div>
  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
