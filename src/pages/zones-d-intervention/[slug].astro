---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import CtaSection from '../../components/CtaSection.astro';
import { allZones, type ZoneItem } from '../../data/zonesData';
import { siteSettings } from '../../data/siteData';

export async function getStaticPaths() {
  return allZones.map((zone) => ({
    params: { slug: zone.slug },
    props: { zone },
  }));
}

interface Props {
  zone: ZoneItem;
}

const { zone } = Astro.props;

// Local Business Schema
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": `Cabinet Maître Aziman - ${zone.regionName}`,
  "description": zone.metaDescription,
  "telephone": siteSettings.phone,
  "url": `https://www.marabout-aziman.fr/zones-d-intervention/${zone.slug}/`,
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": zone.regionName
  },
  "priceRange": "€€",
  "address": {
    "@type": "PostalAddress",
    "addressRegion": zone.regionName,
    "addressCountry": "FR"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://www.marabout-aziman.fr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Zones d'Intervention",
      "item": "https://www.marabout-aziman.fr/zones-d-intervention/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": zone.regionName,
      "item": `https://www.marabout-aziman.fr/zones-d-intervention/${zone.slug}/`
    }
  ]
};

// Dynamic FAQ schema for Local SEO rich snippets
const faqMatches = [...(zone.content || '').matchAll(/###\s+([^\n\?]+\?)\s*\n+([\s\S]*?)(?=\n+##|\n+###|$)/g)];
const faqSchema = faqMatches.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqMatches.map(m => ({
    "@type": "Question",
    "name": m[1].trim(),
    "acceptedAnswer": {
      "@type": "Answer",
      "text": m[2].trim().replace(/\n+/g, ' ')
    }
  }))
} : null;

const pageSchemas = [localBusinessSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  title={zone.metaTitle}
  description={zone.metaDescription}
  keywords={zone.keywords}
  image={zone.image}
  schema={pageSchemas}
>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge={`Secteur d'Intervention : ${zone.regionName}`}
    title={zone.title}
    description={zone.metaDescription}
    breadcrumbs={[
      { label: 'Zones d\'Intervention', href: '/zones-d-intervention/' },
      { label: zone.regionName, href: `/zones-d-intervention/${zone.slug}/` },
    ]}
  
    image="/images/zones/details-zone.webp"
    primaryCta={{ label: 'WhatsApp 24/7', href: siteSettings.whatsappLink, icon: 'whatsapp' }}
    
  />

  <TrustBadges />

  <!-- CONTENT -->
  <article class="py-12 sm:py-16 md:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <!-- Featured Image -->
    <div class="rounded-3xl overflow-hidden shadow-xl max-h-96 bg-brand-950 border border-brand-800 mb-8">
      <img
        src={zone.image}
        alt={`Intervention Marabout à ${zone.regionName} : ${zone.title}`}
        loading="lazy"
        decoding="async"
        width="800"
        height="500"
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Table of Contents -->
    <TableOfContents />

    <!-- Rich Semantic HTML Content -->
    <div class="prose-aziman" set:html={zone.contentHtml} />

  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
