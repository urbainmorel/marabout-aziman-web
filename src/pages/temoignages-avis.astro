---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/HeroHeader.astro';
import TrustBadges from '../components/TrustBadges.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import CtaSection from '../components/CtaSection.astro';
import { testimonials, siteSettings } from '../data/siteData';

const seoTitle = "Avis Marabout en France : Témoignages Vérifiés | Aziman";
const seoDesc = "Consultez les véritables avis marabout en France sur le Maître Aziman. Retours affectifs réussis, fortune et désenvoûtement. Témoignages récents.";
---

<BaseLayout title={seoTitle} description={seoDesc}>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Preuve Sociale & Retours d'Expérience"
    title="Avis Marabout en France : Témoignages Vérifiés et Retours d'Expérience du Cabinet Aziman"
    description="Vous hésitez à faire appel à un praticien spirituel ou vous souhaitez vous assurer de l'honnêteté et de l'efficacité de ses travaux ? Consulter les véritables avis marabout en France sur le Maître Aziman constitue la meilleure preuve de son sérieux et de la puissance de ses rituels traditionnels."
    breadcrumbs={[{ label: 'Avis & Témoignages', href: '/temoignages-avis' }]}
    highlightWord="Maître Aziman"
    image="https://images.unsplash.com/photo-1600180758890-6b94519a8ba6?q=80&w=1000&auto=format&fit=crop"
    primaryCta={{ label: 'WhatsApp 24/7', href: 'https://wa.me/33753368297', icon: 'whatsapp' }}
    
  />

  <TrustBadges />

  <!-- CONTENT -->
  <section class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto mb-12 text-center">
      <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-sans">
        Depuis plus de quinze ans d'exercice en France, Maître Aziman a réuni des centaines de couples, débloqué des situations financières désespérées et sauvé des personnes persécutées par la sorcellerie. Découvrez ci-dessous les témoignages authentiques de consultants de Paris, Lyon, Marseille, Bordeaux, Nantes et toute la France.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonials.map((t) => (
        <TestimonialCard testimonial={t} />
      ))}
    </div>

    <!-- How to submit review -->
    <div class="mt-16 card-luxury p-8 sm:p-10 bg-brand-50/80 border border-brand-200 text-center max-w-2xl mx-auto space-y-4 shadow-sm">
      <div class="space-y-2">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-wider">Votre Témoignage Compte</span>
        <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
          Déposez votre Avis sur le Cabinet du Maître Aziman
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-slate-600 font-sans">
        Vous avez bénéficié de l'aide spirituelle du Maître Aziman ? Partagez votre expérience pour éclairer les personnes qui traversent les mêmes épreuves :
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a
          href={siteSettings.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp text-xs sm:text-sm py-3.5 px-6 font-bold shadow-md"
        >
          <span>WhatsApp 24/7</span>
        </a>
        <a
          href={`mailto:${siteSettings.email}`}
          class="text-xs font-bold text-brand-900 hover:text-brand-700 underline"
        >
          Envoyer par e-mail ({siteSettings.email})
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
