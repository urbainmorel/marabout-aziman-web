---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/HeroHeader.astro';
import ConsultationSidebar from '../components/ConsultationSidebar.astro';
import TrustBadges from '../components/TrustBadges.astro';
import CtaSection from '../components/CtaSection.astro';
import { siteSettings } from '../data/siteData';

const seoTitle = "À Propos du Maître Aziman : Marabout Traditionnel en France";
const seoDesc = "Découvrez l'histoire, l'initiation et les valeurs du Maître Aziman, marabout traditionnel en France. 25 ans d'expérience au service de votre réussite. RDV.";
const seoKeywords = "maître aziman, marabout traditionnel france, biographie marabout paris, prêtre bokonon fâ, grand marabout africain bénin";

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": seoTitle,
  "description": seoDesc,
  "mainEntity": {
    "@type": "Person",
    "name": "Maître Aziman",
    "jobTitle": "Grand Marabout Traditionnel et Prêtre Bokonon",
    "description": "Initié aux secrets ancestraux du Fâ et du Vodun depuis plus de 25 ans.",
    "telephone": siteSettings.phone,
    "url": "https://marabout-aziman.fr/a-propos/"
  }
};
---

<BaseLayout title={seoTitle} description={seoDesc} keywords={seoKeywords} schema={aboutSchema}>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Biographie & Lignée Ancestrale"
    title="À Propos du Maître Aziman : Héritier des Secrets du Fâ et Marabout Traditionnel en France"
    description="Vous cherchez un praticien spirituel authentique, enraciné dans une véritable lignée ancestrale et guidé par une éthique rigoureuse ? Consulter un marabout traditionnel en France tel que Maître Aziman représente la garantie d'un accompagnement sérieux, bienveillant et hautement efficace."
    breadcrumbs={[{ label: 'À Propos', href: '/a-propos' }]}
    author={{
      name: "Maître Aziman",
      role: "Grand Marabout & Prêtre Bokonon",
      avatar: "https://images.unsplash.com/photo-1509198397868-475647b2a1e5?auto=format&fit=crop&w=200&q=80"
    }}
  />

  <TrustBadges />

  <!-- MAIN EDITORIAL CONTENT -->
  <article class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      
      <!-- Content Body -->
      <div class="lg:col-span-8 space-y-10 prose-aziman">
        
        <div>
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-serif">
            En effet, Maître Aziman ne pratique pas une voyance superficielle ou improvisée. Il met à votre disposition plus de vingt-cinq années d'initiation dans les couvents sacrés d'Afrique de l'Ouest. Ainsi, il allie la sagesse du Fâ à la puissance des rituels traditionnels pour résoudre vos épreuves.
          </p>
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-serif mt-4">
            Installé dans son cabinet en Île-de-France et disponible pour des interventions à distance, Maître Aziman écoute chaque consultant sans jugement. Par conséquent, vous bénéficiez de solutions occultes durables et respectueuses de votre équilibre.
          </p>
        </div>

        <div class="border-t border-gold-200/80 pt-8 space-y-4">
          <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
            L'Origine et l'Initiation aux Grands Mystères Traditionnels
          </h2>
          <p class="text-sm text-gray-700 leading-relaxed font-sans">
            Le parcours de Maître Aziman s'enracine dans la plus pure tradition familiale et initiatique :
          </p>
          <ul class="space-y-3 text-sm text-gray-700 pl-4 border-l-2 border-gold-400 font-sans">
            <li><strong>Un héritage spirituel de naissance :</strong> Issu d'une grande lignée de guérisseurs et de devins réputés au Bénin et au Togo.</li>
            <li><strong>La formation en forêt sacrée :</strong> Retraite initiatique complète pour maîtriser la pharmacopée secrète (<em>Amassé</em>) et les langues occultes.</li>
            <li><strong>L'intronisation au rang de grand prêtre Bokonon :</strong> Maîtrise absolue des 256 signes géomantiques sacrés du Fâ (<em>Ifá</em>).</li>
            <li><strong>L'alliance avec les divinités gardiennes :</strong> Célébration des pactes avec les forces de la terre (<em>Azziza</em>), du fer (<em>Gou</em>) et des eaux (<em>Mami Wata</em>).</li>
          </ul>
        </div>

        <div class="border-t border-gold-200/80 pt-8 space-y-4">
          <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
            Les 4 Valeurs Fondamentales du Cabinet Aziman
          </h2>
          <p class="text-sm text-gray-700 leading-relaxed font-sans">
            Maître Aziman applique une déontologie stricte fondée sur quatre engagements majeurs :
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="card-luxury p-6 bg-white border border-gray-100 shadow-xs">
              <span class="text-gold-700 font-bold text-base font-serif">01. Secret & Discrétion Absolue</span>
              <p class="text-xs text-gray-600 mt-2 leading-relaxed font-sans">
                Vos confidences, vos photographies et vos rituels restent protégés par le secret initiatique le plus strict.
              </p>
            </div>
            <div class="card-luxury p-6 bg-white border border-gray-100 shadow-xs">
              <span class="text-gold-700 font-bold text-base font-serif">02. Respect des Lois Naturelles</span>
              <p class="text-xs text-gray-600 mt-2 leading-relaxed font-sans">
                Aucun rituel ne fait appel à des sacrifices humains ou à des magies destructrices de karma.
              </p>
            </div>
            <div class="card-luxury p-6 bg-white border border-gray-100 shadow-xs">
              <span class="text-gold-700 font-bold text-base font-serif">03. Franchise & Honnêteté</span>
              <p class="text-xs text-gray-600 mt-2 leading-relaxed font-sans">
                Si une situation ne peut pas être résolue spirituellement, Maître Aziman vous en informe dès la première consultation.
              </p>
            </div>
            <div class="card-luxury p-6 bg-white border border-gray-100 shadow-xs">
              <span class="text-gold-700 font-bold text-base font-serif">04. Suivi Personnalisé</span>
              <p class="text-xs text-gray-600 mt-2 leading-relaxed font-sans">
                Vous conservez un contact direct par téléphone ou WhatsApp tout au long de votre travail.
              </p>
            </div>
          </div>
        </div>

        <div class="border-t border-gold-200/80 pt-8 space-y-4">
          <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
            Pourquoi Maître Aziman a-t-il installé son cabinet en France ?
          </h2>
          <p class="text-sm text-gray-700 leading-relaxed font-sans">
            Après des années d'exercice en Afrique de l'Ouest, Maître Aziman a choisi d'implanter son sanctuaire en région parisienne :
          </p>
          <ul class="space-y-3 text-sm text-gray-700 pl-4 border-l-2 border-gold-400 font-sans">
            <li><strong>Répondre à la détresse de la diaspora et des résidents en France :</strong> Rompre l'isolement des personnes confrontées à des ruptures, des blocages administratifs ou des attaques occultes.</li>
            <li><strong>Offrir un lieu physique de consultation sécurisé :</strong> Un espace neutre et apaisant pour vous recevoir en toute sérénité à Paris.</li>
            <li><strong>Assurer une logistique rapide des produits sacrés :</strong> Expédition express de vos savons, poudres et talismans en 48h partout en France.</li>
          </ul>
        </div>

        <div class="border-t border-gold-200/80 pt-8 space-y-4">
          <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
            Foire Aux Questions sur le Maître Aziman
          </h2>
          
          <div class="space-y-4">
            <div class="bg-surface p-6 rounded-2xl border border-gray-200/80">
              <h3 class="font-bold text-sm text-brand-dark">Depuis combien d'années Maître Aziman exerce-t-il en France ?</h3>
              <p class="text-xs sm:text-sm text-gray-600 mt-2 leading-relaxed font-sans">
                Maître Aziman reçoit des consultants en France depuis plus de quinze ans au sein de son cabinet et lors de ses déplacements réguliers.
              </p>
            </div>
            <div class="bg-surface p-6 rounded-2xl border border-gray-200/80">
              <h3 class="font-bold text-sm text-brand-dark">Quelle est la différence entre un voyant ordinaire et un Bokonon initié ?</h3>
              <p class="text-xs sm:text-sm text-gray-600 mt-2 leading-relaxed font-sans">
                Le Bokonon maîtrise un oracle géomantique vivant et sacré. Il ne se limite pas à prédire : il applique les rituels précis pour corriger votre destinée.
              </p>
            </div>
          </div>
        </div>

      </div>

      <!-- Reusable Luxury Consultation Sidebar -->
      <div class="lg:col-span-4">
        <ConsultationSidebar
          title="Consulter le Maître"
          subtitle="Cabinet Paris & Urgences 24/7"
          contextText="Rencontrez Maître Aziman en tête-à-tête à Paris ou optez pour une consultation téléphonique confidentielle."
          actionText="Prendre Contact sur WhatsApp"
          customWhatsappMsg="Bonjour Maître Aziman, je souhaite réserver une consultation spirituelle."
        />
      </div>

    </div>
  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
