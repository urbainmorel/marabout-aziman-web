---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/HeroHeader.astro';
import ConsultationSidebar from '../components/ConsultationSidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TrustBadges from '../components/TrustBadges.astro';
import CtaSection from '../components/CtaSection.astro';
import { siteSettings } from '../data/siteData';

const seoTitle = "Cabinet Marabout en France : Prise de RDV | Aziman";
const seoDesc = "Prenez rendez-vous au cabinet marabout en France du Maître Aziman à Paris. Consultations privées ou à distance par WhatsApp 7j/7. Discrétion.";
const seoKeywords = "cabinet marabout france, consultation marabout paris, rdv marabout ile de france, voyance en cabinet paris, marabout sérieux paris";

const cabinetSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Cabinet de Consultation Spirituelle Maître Aziman",
  "description": "Cabinet privé de voyance traditionnelle et rituels ancestraux à Paris / Île-de-France.",
  "telephone": siteSettings.phone,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Paris",
    "addressRegion": "Île-de-France",
    "addressCountry": "FR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "48.8566",
    "longitude": "2.3522"
  },
  "openingHours": "Mo-Su 08:00-21:00"
};
---

<BaseLayout title={seoTitle} description={seoDesc} keywords={seoKeywords} schema={cabinetSchema}>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Consultations Privées à Paris & Déplacements"
    title="Cabinet Marabout en France : Consultations Privées à Paris et Prise de Rendez-vous 7j/7"
    description="Vous souhaitez rencontrer le Maître Aziman en tête-à-tête dans un cadre discret ou réserver une séance de voyance directe par téléphone ? Réserver une séance au cabinet marabout en France du Maître Aziman représente la démarche la plus rassurante pour exposer vos problèmes en toute intimité."
    breadcrumbs={[{ label: 'Cabinet en France', href: '/cabinet-france' }]}
  />

  <TrustBadges />

  <!-- CONTENT BODY -->
  <article class="py-12 sm:py-16 md:py-20 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      
      <div class="lg:col-span-8 space-y-10 prose-aziman">
        
        <!-- Table of Contents -->
        <TableOfContents />

        <div>
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-serif">
            En effet, situé en région parisienne et parfaitement desservi par les transports, son cabinet vous accueille dans une atmosphère de paix et de recueillement. Ainsi, vous bénéficiez d'une écoute attentive et d'un diagnostic spirituel immédiat par le Fâ.
          </p>
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-serif mt-4">
            Que vous habitiez en Île-de-France ou que vous préfériez une consultation à distance depuis la province, Maître Aziman vous reçoit 7 jours sur 7. Par conséquent, vous obtenez des réponses claires sans attendre.
          </p>
        </div>

        <div class="border-t border-gold-200/80 pt-8 space-y-6">
          <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
            Les 2 Modes de Consultation Proposés par Maître Aziman
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="card-luxury p-6 bg-white border border-gray-100 shadow-xs">
              <h3 class="font-serif font-bold text-lg text-brand-dark mb-2">1. Consultation en Cabinet</h3>
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed font-sans">
                Vous êtes reçu individuellement dans le sanctuaire privé du Maître Aziman à Paris / Île-de-France. Vous assistez au lancer des cauris sacrés et repartez directement avec vos supports préparés.
              </p>
            </div>
            <div class="card-luxury p-6 bg-white border border-gray-100 shadow-xs">
              <h3 class="font-serif font-bold text-lg text-brand-dark mb-2">2. Consultation à Distance</h3>
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed font-sans">
                Idéale si vous résidez en province (Lyon, Marseille, Bordeaux, Lille, etc.) ou à l'étranger. La séance offre exactement la même précision qu'en cabinet via appel vocal ou vidéo WhatsApp.
              </p>
            </div>
          </div>
        </div>

        <div class="border-t border-gold-200/80 pt-8 space-y-4">
          <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
            Comment se déroule votre rendez-vous au cabinet ?
          </h2>
          <ol class="space-y-3 text-sm text-gray-700 list-decimal pl-5 font-sans">
            <li><strong>L'accueil et la mise en confiance :</strong> Vous exposez librement votre situation sans crainte du jugement.</li>
            <li><strong>Le tirage divinatoire du Fâ et des cauris :</strong> Maître Aziman interroge les oracles traditionnels pour identifier la racine de vos blocages.</li>
            <li><strong>La proposition de rituels sur mesure :</strong> Vous découvrez les rituels ou produits de la boutique adaptés pour résoudre votre problème.</li>
            <li><strong>La remise des consignes spirituelles :</strong> Vous recevez les règles simples à respecter pour déclencher votre déblocage.</li>
          </ol>
        </div>

        <div class="border-t border-gold-200/80 pt-8 space-y-4">
          <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
            Modalités Pratiques et Tarifs des Consultations
          </h2>
          <div class="space-y-3 text-sm text-gray-700 font-sans">
            <p>
              Le Cabinet Maître Aziman pratique une tarification claire et transparente communiquée lors de la prise de contact :
            </p>
            <ul class="space-y-2 pl-4 border-l-2 border-gold-400">
              <li><strong>Moyens de règlement acceptés :</strong> Espèces, Virement bancaire sécurisé, Carte Bancaire, PayPal.</li>
              <li><strong>Accessibilité :</strong> Cabinet situé en région parisienne (adresse exacte et plan d'accès communiqués après confirmation du rendez-vous).</li>
              <li><strong>Horaires d'ouverture :</strong> Du lundi au dimanche de 8h00 à 21h00 sans interruption.</li>
            </ul>
          </div>
        </div>

      </div>

      <!-- Reusable Consultation Sidebar -->
      <div class="lg:col-span-4">
        <ConsultationSidebar
          title="Réserver une Séance"
          subtitle="Cabinet Paris & Distance"
          contextText="Bloquez votre créneau horaire privilégié avec Maître Aziman pour une séance en toute confidentialité."
          actionText="Réserver sur WhatsApp 24h/7j"
          customWhatsappMsg="Bonjour Maître Aziman, je souhaite réserver un créneau pour une consultation en cabinet ou par téléphone."
        />
      </div>

    </div>
  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
