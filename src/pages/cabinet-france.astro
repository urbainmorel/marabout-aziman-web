---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/HeroHeader.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TrustBadges from '../components/TrustBadges.astro';
import CtaSection from '../components/CtaSection.astro';
import { siteSettings } from '../data/siteData';

const seoTitle = "Cabinet Marabout en France : Prise de RDV | Aziman";
const seoDesc = "Prenez rendez-vous au cabinet marabout en France du Maître Aziman à Paris. Consultations privées ou à distance par WhatsApp 7j/7. Discrétion.";
const seoKeywords = "cabinet marabout france, consultation marabout paris, rdv marabout ile de france, voyance en cabinet paris, marabout sérieux paris";

const cabinetSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Cabinet de Consultation Spirituelle Maître Aziman",
  "description": "Cabinet privé de voyance traditionnelle et rituels ancestraux à Paris / Île-de-France.",
  "telephone": siteSettings.phone,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Paris",
    "addressRegion": "Île-de-France",
    "addressCountry": "FR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "48.8566",
    "longitude": "2.3522"
  },
  "openingHours": "Mo-Su 08:00-21:00"
};
---

<BaseLayout title={seoTitle} description={seoDesc} keywords={seoKeywords} schema={cabinetSchema}>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Consultations Privées à Paris & Déplacements"
    title="Cabinet Marabout en France : Consultations Privées à Paris et Prise de Rendez-vous 7j/7"
    description="Vous souhaitez rencontrer le Maître Aziman en tête-à-tête dans un cadre discret ou réserver une séance de voyance directe par téléphone ? Réserver une séance au cabinet marabout en France du Maître Aziman représente la démarche la plus rassurante pour exposer vos problèmes en toute intimité."
    breadcrumbs={[{ label: 'Cabinet en France', href: '/cabinet-france' }]}
    highlightWord="Maître Aziman"
    image="https://images.unsplash.com/photo-1600180758890-6b94519a8ba6?q=80&w=1000&auto=format&fit=crop"
    primaryCta={{ label: 'WhatsApp 24/7', href: 'https://wa.me/33753368297', icon: 'whatsapp' }}
    
  />

  <TrustBadges />

  <!-- CONTENT BODY -->
  <article class="py-12 sm:py-16 md:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 prose-aziman">
    
    <!-- Table of Contents -->
    <TableOfContents />

    <div>
      <p class="text-base sm:text-lg text-slate-800 leading-relaxed font-serif">
        En effet, situé en région parisienne et parfaitement desservi par les transports, son cabinet vous accueille dans une atmosphère de paix et de recueillement. Ainsi, vous bénéficiez d'une écoute attentive et d'un diagnostic spirituel immédiat par le Fâ.
      </p>
      <p class="text-base sm:text-lg text-slate-800 leading-relaxed font-serif mt-4">
        Que vous habitiez en Île-de-France ou que vous préfériez une consultation à distance depuis la province, Maître Aziman vous reçoit 7 jours sur 7. Par conséquent, vous obtenez des réponses claires sans attendre.
      </p>
    </div>

    <div class="border-t border-brand-200 pt-8 space-y-6">
      <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
        Les 2 Modes de Consultation Proposés par Maître Aziman
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="card-luxury p-6 bg-white border border-brand-200/80 shadow-xs">
          <h3 class="font-serif font-bold text-lg text-brand-dark mb-2">1. Consultation en Cabinet</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
            Vous êtes reçu individuellement dans le sanctuaire privé du Maître Aziman à Paris / Île-de-France. Vous assistez au lancer des cauris sacrés et repartez directement avec vos supports préparés.
          </p>
        </div>
        <div class="card-luxury p-6 bg-white border border-brand-200/80 shadow-xs">
          <h3 class="font-serif font-bold text-lg text-brand-dark mb-2">2. Consultation à Distance</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
            Idéale si vous résidez en province (Lyon, Marseille, Bordeaux, Lille, etc.) ou à l'étranger. La séance offre exactement la même précision qu'en cabinet via appel vocal ou vidéo WhatsApp.
          </p>
        </div>
      </div>
    </div>

    <div class="border-t border-brand-200 pt-8 space-y-4">
      <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
        Comment se Déroule une Séance au Cabinet ?
      </h2>
      <ol class="space-y-3 text-sm sm:text-base text-slate-700 pl-6 list-decimal font-sans">
        <li><strong>L'accueil et l'écoute confidentielle :</strong> Vous exposez librement votre situation sans aucune interruption ni jugement.</li>
        <li><strong>L'interrogation oraculaire du Fâ :</strong> Tirage divinatoire pour identifier les origines invisibles de vos blocages.</li>
        <li><strong>La révélation des causes et des remèdes :</strong> Explication détaillée des rituels ancestraux requis.</li>
        <li><strong>La remise des recommandations :</strong> Remise ou envoi des produits consacrés et calendrier de suivi personnalisé.</li>
      </ol>
    </div>

    <div class="border-t border-brand-200 pt-8 space-y-4">
      <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
        Prendre Rendez-Vous au Cabinet en Île-de-France
      </h2>
      <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-sans">
        Pour garantir un anonymat parfait, les consultations au cabinet se font exclusivement sur rendez-vous préalable :
      </p>
      <ul class="space-y-2 pl-4 border-l-2 border-brand-300 text-sm sm:text-base text-slate-700 font-sans">
        <li><strong>Par téléphone direct :</strong> <a href={`tel:${siteSettings.phone}`} class="font-bold text-brand-900 underline">{siteSettings.phoneDisplay}</a></li>
        <li><strong>Par WhatsApp 24/7 :</strong> <a href={siteSettings.whatsappLink} target="_blank" rel="noopener noreferrer" class="font-bold text-emerald-700 underline">{siteSettings.whatsappDisplay}</a></li>
        <li><strong>Page de contact :</strong> <a href="/contact" class="font-bold text-brand-900 underline">Prise de RDV et coordonnées</a></li>
      </ul>
    </div>

  </article>

  <!-- CTA -->
  <CtaSection />

</BaseLayout>
