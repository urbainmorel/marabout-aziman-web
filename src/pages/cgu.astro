---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/HeroHeader.astro';
import LegalTabs from '../components/LegalTabs.astro';
import { cguContent } from '../data/legalData';

const { title, metaTitle, metaDescription, intro, sections } = cguContent;
---

<BaseLayout title={metaTitle} description={metaDescription}>
  
  <!-- HERO HEADER REUSABLE -->
  <HeroHeader
    badge="Cadre Contractuel & Déontologie"
    title={title}
    description={intro}
    breadcrumbs={[{ label: title, href: '/cgu' }]}
  />

  <!-- LEGAL CONTENT -->
  <section class="py-12 sm:py-16 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <LegalTabs currentSlug="cgu" />

    <div class="card-luxury p-6 sm:p-10 md:p-12 bg-white border border-brand-200/80 mt-8 space-y-10 prose-aziman shadow-sm">
      {sections.map((sec) => (
        <div class="space-y-3">
          <h2 class="font-serif font-bold text-xl sm:text-2xl text-brand-dark border-b border-brand-200 pb-2.5">
            {sec.title}
          </h2>
          <div class="text-xs sm:text-sm text-slate-700 leading-relaxed whitespace-pre-line font-sans">
            {sec.content}
          </div>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>
