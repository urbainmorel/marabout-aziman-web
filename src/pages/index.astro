---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/HeroHeader.astro';
import CtaSection from '../components/CtaSection.astro';
import DomainCard from '../components/DomainCard.astro';
import ShopCard from '../components/ShopCard.astro';
import { siteSettings } from '../data/siteData';
import { servicesHubs } from '../data/servicesData';
import { boutiqueCategories } from '../data/shopData';

const seoTitle = "Grand Marabout en France : Voyance & Rituels | Cabinet Aziman";
const seoDesc = "Consultez Maître Aziman, grand marabout en France. Retour affectif rapide, chance, protection et rituels ancestraux. RDV au cabinet ou à distance.";
const seoKeywords = "marabout en france, grand marabout paris, voyance fâ, marabout africain sérieux france, retour affectif france";

// Exact 3 testimonials from PAGE D'ACCUEIL.txt
const homeTestimonials = [
  {
    author: "Sylvie M.",
    city: "Paris 15e",
    text: "Après six mois de rupture difficile, Maître Aziman a réalisé un retour affectif avec cadenas d'amour. Mon ex-compagnon est revenu vers moi en seulement cinq jours. Je recommande vivement son cabinet."
  },
  {
    author: "Mamadou D.",
    city: "Lyon 3e",
    text: "Mon commerce de restauration était au bord de la faillite. Grâce au savon de fortune et aux poudres d'attraction de clientèle, ma salle ne désemplit plus depuis trois mois."
  },
  {
    author: "Jean-Claude B.",
    city: "Bordeaux",
    text: "J'étais bloqué par des démarches administratives complexes depuis deux ans. Le travail de Maître Aziman a permis de débloquer mon dossier en préfecture en quelques semaines."
  }
];

// Exact 3 FAQ items from PAGE D'ACCUEIL.txt
const homeFaqList = [
  {
    question: "Comment se déroule une première consultation avec Maître Aziman ?",
    answer: "La consultation commence systématiquement par une voyance divinatoire par le Fâ ou les cauris. Ainsi, Maître Aziman identifie avec précision la source invisible de vos difficultés avant de vous proposer le rituel adapté."
  },
  {
    question: "Les rituels à distance sont-ils aussi efficaces qu'en cabinet ?",
    answer: "Oui, les rituels à distance possèdent une efficacité identique. En effet, les vibrations spirituelles ne connaissent aucune frontière spatiale. Maître Aziman travaille sur vos photographies, noms et dates de naissance."
  },
  {
    question: "Quels sont les délais pour constater les premiers résultats ?",
    answer: "Les premiers effets se manifestent généralement entre 24 heures et 7 jours selon la complexité du problème. De plus, un suivi quotidien vous est assuré jusqu'à l'obtention du résultat souhaité."
  }
];

// Exact 8 regional zones from PAGE D'ACCUEIL.txt
const homeZones = [
  { name: "Paris & Île-de-France", depts: "75, 92, 93, 94, 77, 78, 91, 95", slug: "marabout-paris-ile-de-france" },
  { name: "Lyon & Auvergne-Rhône-Alpes", depts: "69, 42, 38", slug: "marabout-lyon-auvergne-rhone-alpes" },
  { name: "Marseille, Nice & PACA", depts: "13, 06, 83", slug: "marabout-marseille-nice-paca" },
  { name: "Bordeaux & Nouvelle-Aquitaine", depts: "33, 64", slug: "marabout-bordeaux-nouvelle-aquitaine" },
  { name: "Lille & Hauts-de-France", depts: "59, 62, 80", slug: "marabout-lille-hauts-de-france" },
  { name: "Toulouse, Montpellier & Occitanie", depts: "31, 34, 30", slug: "marabout-toulouse-montpellier-occitanie" },
  { name: "Nantes, Rennes & Grand Ouest", depts: "44, 35, 49", slug: "marabout-nantes-rennes-grand-ouest" },
  { name: "Strasbourg & Grand Est", depts: "67, 68, 57", slug: "marabout-strasbourg-grand-est" },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homeFaqList.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Cabinet Maître Aziman",
  "alternateName": "Grand Marabout en France - Cabinet Aziman",
  "url": "https://www.marabout-aziman.fr/",
  "inLanguage": "fr-FR",
  "description": seoDesc
};
---

<BaseLayout title={seoTitle} description={seoDesc} keywords={seoKeywords} schema={[faqSchema, websiteSchema]}>
  
  <!-- 1. HERO SECTION UNIFIÉE -->
  <HeroHeader
    badge="Cabinet de Voyance & Rituels Traditionnels"
    title="Grand Marabout Aziman en France : Voyance & Rituels Traditionnels"
    highlightWord="Maître Aziman"
    description="Retour affectif rapide, désenvoûtement, chance financière et rituels ancestraux du Fâ. Consultations privées en Île-de-France et rituels sérieux à distance partout en France."
    image="/images/home/hero-accueil.webp"
    primaryCta={{ label: 'WhatsApp 24/7', href: siteSettings.whatsappLink, icon: 'whatsapp' }}
    secondaryCta={{ label: 'Découvrir nos services', href: '/services/' }}
  />

  <!-- VALUE PROPS (Barre épurée 3 piliers comme sur la maquette) -->
  <section class="border-b border-brand-200 bg-white py-4 shadow-xs">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-3 divide-x divide-brand-100 text-center">
        <div class="px-2 sm:px-4">
          <span class="font-serif font-bold text-xs sm:text-sm text-brand-dark block">Cabinet & Distance</span>
          <span class="text-[11px] text-slate-500 hidden sm:inline font-sans">Paris & toute la France</span>
        </div>
        <div class="px-2 sm:px-4">
          <span class="font-serif font-bold text-xs sm:text-sm text-brand-dark block">100% Discret</span>
          <span class="text-[11px] text-slate-500 hidden sm:inline font-sans">Secret initiatique garanti</span>
        </div>
        <div class="px-2 sm:px-4">
          <span class="font-serif font-bold text-xs sm:text-sm text-brand-dark block">Intervention Rapide</span>
          <span class="text-[11px] text-slate-500 hidden sm:inline font-sans">Résultats sous 24h à 7j</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. SECTION À PROPOS DU CABINET (Placée juste avant "Pourquoi consulter le Maître Aziman en France ?") -->
  <section class="py-12 sm:py-16 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto space-y-6">
      <div class="text-center space-y-2 mb-6">
        <h2 class="font-serif font-bold text-2xl sm:text-3xl text-brand-dark">
          À Propos du Cabinet Aziman
        </h2>
        <div class="w-12 h-1 bg-brand-900 mx-auto rounded-full"></div>
      </div>

      <div class="space-y-4 text-sm sm:text-base md:text-lg text-slate-700 font-serif leading-relaxed text-justify sm:text-left">
        <p>
          Vous traversez une période de doutes sentimentaux, financiers ou spirituels ? Consulter un <strong class="text-brand-dark font-bold">marabout en France</strong> réputé constitue le premier pas vers la résolution définitive de vos blocages. En effet, Maître Aziman met à votre service plus de vingt-cinq années d'initiation aux secrets ancestraux du Fâ et du Vodun. Ainsi, vous bénéficiez d'une écoute attentive, d'une discrétion absolue et d'interventions occultes rapides.
        </p>
        <p>
          Que vous souhaitiez une consultation privée dans son cabinet en Île-de-France ou un travail sérieux à distance, Maître Aziman intervient avec précision. Par conséquent, chaque rituel est personnalisé selon votre profil spirituel et votre situation personnelle.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. POURQUOI CONSULTER LE MAÎTRE AZIMAN EN FRANCE ? (Fidèle à PAGE D'ACCUEIL.txt) -->
  <section class="py-12 sm:py-16 bg-surface border-y border-brand-200" id="pourquoi-aziman">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto space-y-6">
        <div class="text-center space-y-2">
          <h2 class="font-serif font-bold text-2xl sm:text-3xl md:text-4xl text-brand-dark">
            Pourquoi consulter le Maître Aziman en France ?
          </h2>
          <div class="w-12 h-1 bg-brand-900 mx-auto rounded-full"></div>
        </div>

        <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-sans text-center sm:text-left">
          Faire appel à un authentique <strong class="text-brand-dark font-bold">marabout en France</strong> vous garantit un accompagnement sur mesure. De plus, Maître Aziman applique une déontologie stricte fondée sur le secret initiatique et le respect des lois de la nature.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 font-sans">
          <div class="card-luxury p-5 bg-white border border-brand-200/80 rounded-2xl flex items-start gap-3.5 shadow-xs">
            <div class="w-7 h-7 rounded-lg bg-brand-900 text-white flex items-center justify-center flex-shrink-0 text-xs font-bold mt-0.5">✓</div>
            <div>
              <h3 class="font-bold text-sm text-brand-dark">Une lignée initiatique pure :</h3>
              <p class="text-xs sm:text-sm text-slate-600 mt-1">Initié dès l'enfance dans les grands sanctuaires traditionnels d'Afrique de l'Ouest.</p>
            </div>
          </div>

          <div class="card-luxury p-5 bg-white border border-brand-200/80 rounded-2xl flex items-start gap-3.5 shadow-xs">
            <div class="w-7 h-7 rounded-lg bg-brand-900 text-white flex items-center justify-center flex-shrink-0 text-xs font-bold mt-0.5">✓</div>
            <div>
              <h3 class="font-bold text-sm text-brand-dark">Un cabinet discret en France :</h3>
              <p class="text-xs sm:text-sm text-slate-600 mt-1">Un lieu neutre et apaisant pour vous recevoir en toute confidentialité.</p>
            </div>
          </div>

          <div class="card-luxury p-5 bg-white border border-brand-200/80 rounded-2xl flex items-start gap-3.5 shadow-xs">
            <div class="w-7 h-7 rounded-lg bg-brand-900 text-white flex items-center justify-center flex-shrink-0 text-xs font-bold mt-0.5">✓</div>
            <div>
              <h3 class="font-bold text-sm text-brand-dark">Des résultats rapides et vérifiables :</h3>
              <p class="text-xs sm:text-sm text-slate-600 mt-1">Des rituels ciblés conçus pour déclencher des déblocages visibles en quelques jours.</p>
            </div>
          </div>

          <div class="card-luxury p-5 bg-white border border-brand-200/80 rounded-2xl flex items-start gap-3.5 shadow-xs">
            <div class="w-7 h-7 rounded-lg bg-brand-900 text-white flex items-center justify-center flex-shrink-0 text-xs font-bold mt-0.5">✓</div>
            <div>
              <h3 class="font-bold text-sm text-brand-dark">Une disponibilité totale :</h3>
              <p class="text-xs sm:text-sm text-slate-600 mt-1">Consultations d'urgence 7j/7 au cabinet, par appel direct ou via WhatsApp.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. NOS DOMAINES D'INTERVENTION SPIRITUELLE (2 COLONNES SUR MOBILE) -->
  <section class="py-14 sm:py-18 bg-white" id="domaines">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mx-auto text-center space-y-2 mb-10">
        <h2 class="font-serif font-bold text-2xl sm:text-3xl md:text-4xl text-brand-dark">
          Nos Domaines d'Intervention Spirituelle
        </h2>
        <div class="w-12 h-1 bg-brand-900 mx-auto rounded-full"></div>
        <p class="text-xs sm:text-sm text-slate-600 font-sans pt-2">
          Découvrez nos rituels ancestraux adaptés aux réalités de votre quotidien. Cliquez sur chaque domaine pour accéder aux rituels détaillés :
        </p>
      </div>

      <!-- 2 colonnes sur mobile (grid-cols-2), 4 colonnes sur desktop (lg:grid-cols-4) -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
        {servicesHubs.map((hub, idx) => (
          <DomainCard hub={hub} index={idx + 1} expandable={true} />
        ))}
      </div>

    </div>
  </section>

  <!-- 5. LA BOUTIQUE ÉSOTÉRIQUE ANCESTRALE (2 COLONNES SUR MOBILE) -->
  <section class="py-14 sm:py-18 bg-surface border-y border-brand-200" id="boutique">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center space-y-2 mb-10">
        <h2 class="font-serif font-bold text-2xl sm:text-3xl md:text-4xl text-brand-dark">
          La Boutique Ésotérique Ancestrale (Livraison France en 24/48h)
        </h2>
        <div class="w-12 h-1 bg-brand-900 mx-auto rounded-full"></div>
        <p class="text-xs sm:text-sm text-slate-600 font-sans pt-2">
          Chaque article de notre boutique est préparé, magnétisé et consacré selon les règles strictes de la tradition. Commandez en ligne avec livraison discrète par Colissimo ou Chronopost :
        </p>
      </div>

      <!-- 2 colonnes sur mobile (grid-cols-2), 4 colonnes sur desktop (lg:grid-cols-4) -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
        {boutiqueCategories.map((category, idx) => (
          <ShopCard category={category} index={idx + 1} expandable={true} />
        ))}
      </div>
    </div>
  </section>

  <!-- 6. CABINET EN ÎLE-DE-FRANCE & DÉPLACEMENTS RÉGIONAUX (Fidèle à PAGE D'ACCUEIL.txt) -->
  <section class="py-14 sm:py-18 bg-brand-950 text-white border-y border-brand-800" id="zones">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <div class="max-w-3xl mx-auto space-y-2 mb-10">
        <h2 class="font-serif font-bold text-2xl sm:text-3xl md:text-4xl text-white">
          Cabinet en Île-de-France & Déplacements Régionaux
        </h2>
        <div class="w-12 h-1 bg-brand-400 mx-auto rounded-full"></div>
        <p class="text-xs sm:text-sm text-slate-300 font-sans pt-2">
          Maître Aziman vous reçoit sur rendez-vous au sein de son cabinet principal situé en région parisienne. Toutefois, il se déplace également régulièrement dans les grandes métropoles françaises pour des consultations privées :
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 max-w-5xl mx-auto text-left">
        {homeZones.map((zone) => (
          <a
            href={`/zones-d-intervention/${zone.slug}/`}
            class="p-3 sm:p-4 rounded-xl bg-white/5 border border-white/10 hover:border-brand-300 hover:bg-white/10 transition-all duration-200 group flex flex-col justify-between"
          >
            <div>
              <h3 class="font-serif font-bold text-xs sm:text-base text-white group-hover:text-brand-200 transition-colors leading-tight">
                {zone.name}
              </h3>
              <p class="text-[10px] sm:text-[11px] text-slate-300 mt-1 font-sans">
                ({zone.depts})
              </p>
            </div>
            <span class="text-[10px] sm:text-[11px] text-brand-300 font-bold mt-2.5 inline-flex items-center gap-1 group-hover:underline">
              <span>Voir la zone</span>
              <span>→</span>
            </span>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- 7. TÉMOIGNAGES & AVIS VÉRIFIÉS (Strictement les 3 avis du fichier PAGE D'ACCUEIL.txt) -->
  <section class="py-14 sm:py-18 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center space-y-2 mb-10">
      <h2 class="font-serif font-bold text-2xl sm:text-3xl md:text-4xl text-brand-dark">
        Témoignages & Avis Vérifiés de Consultants en France
      </h2>
      <div class="w-12 h-1 bg-brand-900 mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {homeTestimonials.map((t) => (
        <div class="card-luxury p-6 bg-white border border-brand-200/80 rounded-2xl flex flex-col justify-between shadow-xs">
          <div class="space-y-3">
            <div class="flex items-center justify-between border-b border-brand-100 pb-2">
              <span class="font-serif font-bold text-sm text-brand-dark">{t.author}</span>
              <span class="text-xs text-slate-500 font-sans">{t.city}</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-700 italic font-serif leading-relaxed">
              « {t.text} »
            </p>
          </div>
          <div class="pt-3 mt-3 flex items-center gap-1 text-emerald-700 text-xs font-semibold font-sans">
            <span>✓ Avis vérifié</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 8. FOIRE AUX QUESTIONS (Strictement les 3 questions du fichier PAGE D'ACCUEIL.txt) -->
  <section class="py-14 sm:py-18 bg-surface border-t border-brand-200">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-2 mb-10">
        <h2 class="font-serif font-bold text-2xl sm:text-3xl md:text-4xl text-brand-dark">
          Foire Aux Questions (FAQ)
        </h2>
        <div class="w-12 h-1 bg-brand-900 mx-auto rounded-full"></div>
      </div>

      <div class="space-y-4">
        {homeFaqList.map((faq, index) => (
          <details class="group bg-white rounded-xl border border-brand-200/80 shadow-xs overflow-hidden" open={index === 0}>
            <summary class="flex justify-between items-center p-4 sm:p-5 cursor-pointer list-none focus:outline-none select-none">
              <h3 class="font-serif font-bold text-sm sm:text-base text-brand-dark pr-4">
                {faq.question}
              </h3>
              <svg class="h-5 w-5 text-brand-700 transition-transform group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
              </svg>
            </summary>
            <div class="px-4 sm:px-5 pb-5 pt-1 text-xs sm:text-sm text-slate-700 leading-relaxed font-sans border-t border-brand-50">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. SECTION CTA AVANT FOOTER -->
  <CtaSection />

</BaseLayout>
