---
import BaseLayout from '../layouts/BaseLayout.astro';
import ValueProps from '../components/ValueProps.astro';
import TrustBadges from '../components/TrustBadges.astro';
import DomainCard from '../components/DomainCard.astro';
import ShopCard from '../components/ShopCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaSection from '../components/CtaSection.astro';
import { siteSettings, testimonials, homeFaq } from '../data/siteData';
import { servicesHubs } from '../data/servicesData';
import { boutiqueCategories } from '../data/shopData';
import { allZones } from '../data/zonesData';

const seoTitle = "Grand Marabout en France : Voyance & Rituels | Cabinet Aziman";
const seoDesc = "Consultez Maître Aziman, grand marabout en France. Retour affectif rapide, chance, protection et rituels ancestraux. RDV au cabinet ou à distance.";
const seoKeywords = "marabout en france, grand marabout paris, voyance fâ, marabout africain sérieux france, retour affectif rapide, rituel amour, desenvoutement france";

// Rich Schema for Home FAQ
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homeFaq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<BaseLayout title={seoTitle} description={seoDesc} keywords={seoKeywords} schema={faqSchema}>
  
  <!-- HERO SECTION LUXURY -->
  <section class="relative bg-gradient-to-b from-brand-950 via-brand-900 to-brand-900 text-white overflow-hidden py-16 sm:py-20 md:py-28 border-b border-gold-400/20">
    
    <!-- Ambient gold and indigo lighting -->
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-brand-700/25 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-gold-400/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center space-y-6">
        
        <!-- Live Status Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-gold-400/30 text-gold-300 text-xs font-semibold uppercase tracking-wider shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Cabinet en France & Consultations à Distance 7j/7</span>
        </div>

        <h1 class="font-serif font-bold text-3xl sm:text-4xl md:text-5.5xl lg:text-6xl text-white tracking-tight leading-[1.12]">
          Grand Marabout en France : <span class="text-gold-300 italic font-serif">Cabinet de Voyance & Rituels Traditionnels</span> Aziman
        </h1>

        <p class="text-base sm:text-lg text-gray-200 font-sans leading-relaxed max-w-3xl mx-auto pt-1">
          Vous traversez une période de doutes sentimentaux, financiers ou spirituels ? Consulter un <strong>marabout en France</strong> réputé constitue le premier pas vers la résolution définitive de vos blocages. Maître Aziman met à votre service plus de 25 ans d'initiation aux secrets ancestraux du Fâ et du Vodun.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={siteSettings.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-whatsapp w-full sm:w-auto text-sm py-4 px-8 shadow-xl hover:shadow-2xl font-bold"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Échanger en direct sur WhatsApp</span>
          </a>

          <a
            href="/contact"
            class="btn-secondary w-full sm:w-auto text-sm py-4 px-8 font-semibold shadow-lg text-center bg-white/10 hover:bg-white/20 text-white border-white/25"
          >
            <span>Réserver en Cabinet / Appel direct</span>
          </a>
        </div>

        <!-- Trust Badges Quick List -->
        <div class="pt-4 flex flex-wrap items-center justify-center gap-6 text-xs text-gray-300 font-medium">
          <span class="flex items-center gap-1.5">
            <span class="text-gold-400">✦</span> Secret 100% garanti
          </span>
          <span class="flex items-center gap-1.5">
            <span class="text-gold-400">✦</span> Diagnostic précis par le Fâ
          </span>
          <span class="flex items-center gap-1.5">
            <span class="text-gold-400">✦</span> Résultats sous 24h à 7j
          </span>
        </div>

      </div>
    </div>
  </section>

  <!-- VALUE PROPS SECTION -->
  <ValueProps />

  <!-- TRUST BADGES SECTION -->
  <TrustBadges />

  <!-- ABOUT SECTION / POURQUOI CONSULTER AZIMAN -->
  <section class="py-16 md:py-24 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <div class="lg:col-span-6 relative">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl border-2 border-gold-300/40">
          <img
            src="https://images.unsplash.com/photo-1509198397868-475647b2a1e5?auto=format&fit=crop&w=1000&q=80"
            alt="Maître Aziman - Grand Marabout Traditionnel en France et Prêtre Bokonon"
            class="w-full h-88 sm:h-104 object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-950/90 via-transparent to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 text-white">
            <span class="text-xs uppercase tracking-widest text-gold-300 font-bold">Initiation & Maîtrise</span>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold mt-1">{siteSettings.fullName}</h3>
            <p class="text-xs text-gray-300 mt-1">{siteSettings.experienceYears}</p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-50 border border-gold-300 text-gold-800 text-xs font-bold uppercase tracking-wider">
          <span>✦</span>
          <span>Déontologie & Tradition Pure</span>
        </div>

        <h2 class="font-serif font-bold text-3xl sm:text-4xl text-brand-dark leading-tight">
          Pourquoi consulter le Maître Aziman en France ?
        </h2>

        <p class="text-sm sm:text-base text-gray-700 leading-relaxed font-sans">
          Faire appel à un authentique <strong>marabout en France</strong> vous garantit un accompagnement sur mesure. De plus, Maître Aziman applique une déontologie stricte fondée sur le secret initiatique et le respect des lois de la nature.
        </p>

        <ul class="space-y-4 text-sm text-gray-700 font-sans">
          <li class="flex items-start gap-3.5">
            <div class="w-8 h-8 rounded-xl bg-brand-900 text-gold-300 flex items-center justify-center flex-shrink-0 text-xs font-serif font-bold mt-0.5 shadow-xs">01</div>
            <div>
              <strong class="text-brand-dark font-bold">Une lignée initiatique pure :</strong> Initié dès l'enfance dans les grands sanctuaires traditionnels d'Afrique de l'Ouest.
            </div>
          </li>
          <li class="flex items-start gap-3.5">
            <div class="w-8 h-8 rounded-xl bg-brand-900 text-gold-300 flex items-center justify-center flex-shrink-0 text-xs font-serif font-bold mt-0.5 shadow-xs">02</div>
            <div>
              <strong class="text-brand-dark font-bold">Un cabinet discret en France :</strong> Un lieu neutre et apaisant en Île-de-France pour vous recevoir en toute confidentialité.
            </div>
          </li>
          <li class="flex items-start gap-3.5">
            <div class="w-8 h-8 rounded-xl bg-brand-900 text-gold-300 flex items-center justify-center flex-shrink-0 text-xs font-serif font-bold mt-0.5 shadow-xs">03</div>
            <div>
              <strong class="text-brand-dark font-bold">Des résultats rapides et vérifiables :</strong> Des rituels ciblés conçus pour déclencher des déblocages visibles en quelques jours.
            </div>
          </li>
          <li class="flex items-start gap-3.5">
            <div class="w-8 h-8 rounded-xl bg-brand-900 text-gold-300 flex items-center justify-center flex-shrink-0 text-xs font-serif font-bold mt-0.5 shadow-xs">04</div>
            <div>
              <strong class="text-brand-dark font-bold">Une disponibilité totale :</strong> Consultations d'urgence 7j/7 au cabinet, par appel direct ou via WhatsApp.
            </div>
          </li>
        </ul>

        <div class="pt-2">
          <a href="/a-propos" class="inline-flex items-center gap-2 text-sm font-bold text-brand-900 hover:text-gold-700 transition-colors uppercase tracking-wider">
            <span>En savoir plus sur l'histoire et l'initiation du Maître Aziman</span>
            <span>→</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- 8 DOMAINES D'INTERVENTION SECTION -->
  <section class="py-16 sm:py-20 bg-surface border-y border-gray-200/60" id="domaines">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mx-auto text-center space-y-3 mb-14">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 border border-brand-200 text-brand-900 text-xs font-bold uppercase tracking-wider">
          <span>✦</span>
          <span>Pôle Rituels & Consultations</span>
        </div>
        <h2 class="font-serif font-bold text-3xl sm:text-4xl md:text-4.5xl text-brand-dark">
          Nos 8 Domaines d'Intervention Spirituelle
        </h2>
        <p class="text-xs sm:text-sm text-gray-600 font-sans max-w-2xl mx-auto">
          Découvrez nos rituels ancestraux adaptés aux réalités de votre quotidien. Cliquez sur chaque domaine pour accéder aux rituels détaillés :
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {servicesHubs.map((hub) => (
          <DomainCard hub={hub} />
        ))}
      </div>

    </div>
  </section>

  <!-- BOUTIQUE ÉSOTÉRIQUE SECTION -->
  <section class="py-16 md:py-24 max-w-content mx-auto px-4 sm:px-6 lg:px-8" id="boutique">
    <div class="max-w-3xl mx-auto text-center space-y-3 mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-50 border border-gold-300 text-gold-800 text-xs font-bold uppercase tracking-wider">
        <span>✦</span>
        <span>Artisanat Sacré & Pharmacopée</span>
      </div>
      <h2 class="font-serif font-bold text-3xl sm:text-4xl md:text-4.5xl text-brand-dark">
        La Boutique Ésotérique Ancestrale
      </h2>
      <p class="text-xs sm:text-sm text-gray-600 font-sans max-w-2xl mx-auto">
        Chaque article de notre boutique est préparé, magnétisé et consacré selon les règles strictes de la tradition. Livraison discrète en France en 24/48h par Colissimo ou Chronopost :
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {boutiqueCategories.map((category) => (
        <ShopCard category={category} />
      ))}
    </div>

    <div class="mt-12 text-center">
      <a href="/boutique" class="btn-primary py-3.5 px-8 text-sm font-bold shadow-md">
        Découvrir tous les rayons de la boutique ésotérique →
      </a>
    </div>
  </section>

  <!-- CABINET EN ÎLE-DE-FRANCE & DÉPLACEMENTS EN FRANCE -->
  <section class="py-16 sm:py-20 bg-brand-950 text-white relative overflow-hidden" id="zones">
    
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <div class="max-w-3xl mx-auto text-center space-y-3 mb-14">
        <span class="text-xs uppercase tracking-widest text-gold-300 font-bold">Présence Nationale</span>
        <h2 class="font-serif font-bold text-3xl sm:text-4xl md:text-4.5xl text-white">
          Cabinet en Île-de-France & Déplacements Régionaux
        </h2>
        <p class="text-xs sm:text-sm text-gray-300 font-sans max-w-2xl mx-auto">
          Maître Aziman vous reçoit sur rendez-vous au sein de son cabinet principal situé en région parisienne et se déplace régulièrement dans les grandes métropoles françaises :
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {allZones.map((zone) => (
          <a
            href={`/zones-d-intervention/${zone.slug}`}
            class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-gold-400/60 hover:bg-white/10 transition-all duration-300 group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-gold-300 uppercase tracking-wider">Région France</span>
                <span class="text-xs text-gray-400">RDV & Distance</span>
              </div>
              <h3 class="font-serif font-bold text-lg text-white group-hover:text-gold-200 transition-colors">
                {zone.regionName}
              </h3>
              <p class="text-xs text-gray-300 mt-2 line-clamp-2 font-sans">
                {zone.metaDescription}
              </p>
            </div>
            <span class="inline-flex items-center gap-1.5 text-xs text-gold-400 font-bold mt-4 pt-3 border-t border-white/10 group-hover:underline uppercase tracking-wider">
              <span>Consulter dans cette région</span>
              <span>→</span>
            </span>
          </a>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a href="/cabinet-france" class="btn-secondary py-3.5 px-8 text-sm font-semibold inline-block bg-white/10 hover:bg-white/20 text-white border-white/25">
          En savoir plus sur le cabinet de Paris et la prise de RDV →
        </a>
      </div>

    </div>
  </section>

  <!-- TÉMOIGNAGES CLIENTS SECTION -->
  <section class="py-16 md:py-24 max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center space-y-3 mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-50 border border-gold-300 text-gold-800 text-xs font-bold uppercase tracking-wider">
        <span>✦</span>
        <span>Preuve Sociale & Avis Clients</span>
      </div>
      <h2 class="font-serif font-bold text-3xl sm:text-4xl md:text-4.5xl text-brand-dark">
        Témoignages & Avis Vérifiés de Consultants en France
      </h2>
      <p class="text-xs sm:text-sm text-gray-600 font-sans max-w-2xl mx-auto">
        Découvrez les retours d'expérience authentiques de personnes ayant retrouvé la paix, l'amour et la prospérité grâce à l'accompagnement de Maître Aziman :
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.slice(0, 6).map((testimonial) => (
        <TestimonialCard testimonial={testimonial} />
      ))}
    </div>

    <div class="mt-12 text-center">
      <a href="/temoignages-avis" class="btn-secondary text-xs sm:text-sm py-3 px-6 font-bold text-brand-900 border-gold-300">
        Lire l'ensemble des témoignages vérifiés →
      </a>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="py-16 sm:py-20 bg-surface border-t border-gray-200/60">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-3 mb-12">
        <h2 class="font-serif font-bold text-2xl sm:text-3xl md:text-4xl text-brand-dark">
          Foire Aux Questions (FAQ)
        </h2>
        <p class="text-xs sm:text-sm text-gray-600 font-sans">
          Les réponses claires du Maître Aziman à vos interrogations les plus fréquentes.
        </p>
      </div>

      <FaqAccordion items={homeFaq} />
    </div>
  </section>

  <!-- CTA BANNER -->
  <CtaSection />

</BaseLayout>
